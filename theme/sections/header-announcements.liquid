{% if section.blocks.size > 0 or section.settings.utility_menu != blank or section.settings.show_currency_selector %}
  {% if section.blocks.size > 1 %}
    <script
      src="{{ 'announcement-bar.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
  {% endif %}

  {% liquid
    assign announcement_bg = section.settings.background_color
    if announcement_bg == blank or announcement_bg == 'rgba(0,0,0,0)'
      assign announcement_bg = '#151312'
    endif

    assign announcement_text = section.settings.text_color
    if announcement_text == blank or announcement_text == 'rgba(0,0,0,0)'
      assign announcement_text = '#f3efec'
    endif
  %}

  <div
    class="announcement-bar-wrapper ubar"
    style="
      --announcement-bg: {{ announcement_bg }};
      --announcement-text: {{ announcement_text }};
      --color: {{ announcement_text }};
      --color-foreground: {{ announcement_text }};
      {% if announcement_text.rgb != blank %}
        --color-foreground-rgb: {{ announcement_text.rgb }};
      {% else %}
        --color-foreground-rgb: 243 239 236;
      {% endif %}
    "
  >
    <div class="wrap announcement-bar__container">
      {%- comment -%} Left Zone: Dynamic Admin Utility Navigation {%- endcomment -%}
      <div class="announcement-bar__left">
        {% if section.settings.utility_menu != blank and section.settings.utility_menu.links.size > 0 %}
          <nav
            class="announcement-bar__links"
            aria-label="Utility navigation"
          >
            {% for link in section.settings.utility_menu.links %}
              <a href="{{ link.url }}" class="announcement-bar__link-item">{{ link.title }}</a>
            {% endfor %}
          </nav>
        {% endif %}
      </div>

      {%- comment -%} Center Zone: Announcement Ticker {%- endcomment -%}
      <div class="announcement-bar__center ticker">
        {% if section.blocks.size > 0 %}
          {% liquid
            assign autoplay = false
            assign show_arrows = false
            if section.blocks.size > 1 and section.settings.autoplay
              assign autoplay = true
            endif
            if section.blocks.size > 1 and section.settings.show_arrows
              assign show_arrows = true
            endif
          %}

          <announcement-bar-component
            class="announcement-bar__slider"
            {% if autoplay == true %}
              autoplay="{{ section.settings.speed }}" aria-live="polite"
            {% endif %}
          >
            {% if show_arrows %}
              {% render 'slideshow-arrows', icon_style: 'chevron' %}
            {% endif %}

            <div class="announcement-bar__slides">
              {% content_for 'blocks' %}
            </div>
          </announcement-bar-component>
        {% endif %}
      </div>

      {%- comment -%} Right Zone: Optional Shopify Markets Localization {%- endcomment -%}
      <div class="announcement-bar__right">
        {% if section.settings.show_currency_selector and localization.available_countries.size > 1 %}
          <div class="announcement-bar__localization">
            {%- form 'localization', id: 'AnnouncementLocalizationForm', class: 'announcement-bar__localization-form' -%}
              <label for="AnnouncementCountrySelector" class="visually-hidden">
                {{ 'accessibility.country_region' | t }}
              </label>
              <select
                id="AnnouncementCountrySelector"
                name="country_code"
                class="announcement-bar__country-select cur-sel"
                onchange="this.form.submit();"
                title="Country / currency"
              >
                {% for country in localization.available_countries %}
                  <option
                    value="{{ country.iso_code }}"
                    {% if country.iso_code == localization.country.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{ country.name }} ({{ country.currency.iso_code }}
                    {{ country.currency.symbol }})
                  </option>
                {% endfor %}
              </select>
            {%- endform -%}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .announcement-bar-wrapper {
    background-color: var(--announcement-bg, var(--fl-color-ink, #151312));
    color: var(--announcement-text, #f3efec);
    --color: var(--announcement-text, #f3efec);
    --color-foreground: var(--announcement-text, #f3efec);
    font-family: var(--fl-font-body, inherit);
    font-size: 13px;
    width: 100%;
    position: relative;
    z-index: 50;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Scoped contrast protection against Horizon global .text-block forcing dark foreground */
  .announcement-bar-wrapper .text-block,
  .announcement-bar-wrapper .custom-typography,
  .announcement-bar__slide,
  .announcement-bar__text {
    color: var(--color, var(--announcement-text, #f3efec));
  }

  .announcement-bar__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 42px;
    gap: 16px;
    max-width: var(--fl-max-width-page, 1440px);
    margin: 0 auto;
    padding-left: var(--fl-gutter, max(16px, env(safe-area-inset-left, 0px)));
    padding-right: var(--fl-gutter-r, max(16px, env(safe-area-inset-right, 0px)));
  }

  /* Left Zone: Utility Links */
  .announcement-bar__left {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
  }

  .announcement-bar__links {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .announcement-bar__link-item {
    color: inherit;
    opacity: 0.85;
    text-decoration: none;
    white-space: nowrap;
    font-size: 13px;
    line-height: 1.2;
    transition: opacity 0.2s ease;
  }

  .announcement-bar__link-item:hover,
  .announcement-bar__link-item:focus-visible {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Center Zone: Ticker Slider */
  .announcement-bar__center {
    flex: 2;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    gap: 14px;
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.4s ease-in-out, visibility 0.4s ease-in-out;
    content-visibility: visible;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .announcement-bar__slide[aria-hidden='true'] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .announcement-bar__text {
    margin: 0;
    font-size: 13px;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .announcement-bar__text a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Chevron controls */
  .announcement-bar__slider slideshow-arrows {
    position: static;
    display: flex;
    gap: 8px;
    align-items: center;
    mix-blend-mode: normal;
    pointer-events: auto;
  }

  .announcement-bar__slider .slideshow-control {
    background: none;
    border: 0;
    color: var(--announcement-text, #f3efec);
    padding: 4px;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.2s ease, transform 0.15s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }

  .announcement-bar__slider .slideshow-control:hover,
  .announcement-bar__slider .slideshow-control:focus-visible {
    opacity: 1;
    transform: scale(1.1);
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: 12px;
    height: 12px;
  }

  /* Right Zone: Localization */
  .announcement-bar__right {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .announcement-bar__country-select {
    background: transparent;
    color: inherit;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: var(--fl-radius-pill, 999px);
    padding: 4px 10px;
    font-size: 13px;
    font-family: inherit;
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .announcement-bar__country-select:hover,
  .announcement-bar__country-select:focus-visible {
    border-color: rgba(255, 255, 255, 0.7);
  }

  .announcement-bar__country-select option {
    color: var(--fl-color-ink, #151312);
    background-color: #ffffff;
  }

  /* Responsive Breakpoints matching prototype */
  @media screen and (max-width: 960px) {
    .announcement-bar__left,
    .announcement-bar__right {
      display: none;
    }
    .announcement-bar__center {
      flex: 1 1 100%;
      width: 100%;
    }
  }

  @media screen and (max-width: 640px) {
    .announcement-bar__slider slideshow-arrows {
      display: none;
    }
    .announcement-bar__center {
      justify-content: center;
    }
    .announcement-bar__slide {
      justify-content: center;
    }
    .announcement-bar__text {
      font-size: 12.5px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "utility_menu",
      "label": "Utility navigation menu",
      "info": "Displays secondary links on the left side of the utility bar (desktop only)."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate announcements",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show previous/next controls",
      "default": true
    },
    {
      "type": "header",
      "content": "Localization selector"
    },
    {
      "type": "checkbox",
      "id": "show_currency_selector",
      "label": "Show country/currency selector",
      "default": false,
      "info": "Displays native Shopify Markets country and currency selector when multiple countries are active."
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#151312"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#f3efec"
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement",
          "settings": {
            "text": "Book Christmas & New Year deliveries in advance — pick any date"
          }
        },
        "announcement_2": {
          "type": "_announcement",
          "settings": {
            "text": "Same-day delivery till 4 PM in 500+ cities"
          }
        },
        "announcement_3": {
          "type": "_announcement",
          "settings": {
            "text": "Midnight delivery 11:00 PM – 12:30 AM"
          }
        }
      },
      "block_order": ["announcement_1", "announcement_2", "announcement_3"]
    }
  ]
}
{% endschema %}
