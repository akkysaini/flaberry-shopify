{% comment %}
  Flaberry Trust & Delivery Badges Bar
  Source of Truth: reference/Flaberry_Design1_Classic.html
  Displays 5 core Flaberry customer guarantees with high-conversion visual design.
{% endcomment %}

<div class="flaberry-trust-section" data-section-id="{{ section.id }}">
  <div class="flaberry-container">
    <div class="flaberry-trust-grid">
      <div class="flaberry-trust-item">
        <div class="flaberry-trust-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="flaberry-trust-info">
          <h4>Same-Day Delivery</h4>
          <p>Order by 4 PM for express doorstep delivery today</p>
        </div>
      </div>

      <div class="flaberry-trust-item">
        <div class="flaberry-trust-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <div class="flaberry-trust-info">
          <h4>Freshly Hand-Crafted</h4>
          <p>Hand-picked flowers & freshly baked cakes on order</p>
        </div>
      </div>

      <div class="flaberry-trust-item">
        <div class="flaberry-trust-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <div class="flaberry-trust-info">
          <h4>500+ Cities in India</h4>
          <p>Network of own hubs and 2,500+ local master partners</p>
        </div>
      </div>

      <div class="flaberry-trust-item">
        <div class="flaberry-trust-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </div>
        <div class="flaberry-trust-info">
          <h4>Midnight Surprises</h4>
          <p>Exact slot delivery at 12:00 AM for special milestones</p>
        </div>
      </div>

      <div class="flaberry-trust-item">
        <div class="flaberry-trust-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <div class="flaberry-trust-info">
          <h4>Dedicated Support</h4>
          <p>8 AM – Midnight IST assistance via WhatsApp & phone</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .flaberry-trust-section {
    padding: 32px 0;
    background: var(--fl-color-mist, #f5f2f0);
    border-top: 1px solid var(--fl-color-line, #e7e1dd);
    border-bottom: 1px solid var(--fl-color-line, #e7e1dd);
  }
  .flaberry-trust-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
  }
  @media (max-width: 1024px) {
    .flaberry-trust-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
  @media (max-width: 600px) {
    .flaberry-trust-grid {
      grid-template-columns: 1fr;
    }
  }
  .flaberry-trust-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .flaberry-trust-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fl-color-flora, #e2522c);
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(21, 19, 18, 0.05);
  }
  .flaberry-trust-info h4 {
    margin: 0 0 3px;
    font-size: 14.5px;
    font-weight: 700;
    color: var(--fl-color-ink, #151312);
  }
  .flaberry-trust-info p {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--fl-color-muted, #6f6763);
  }
</style>

