<style>
  /* Header Main Layout */
  .hdr.fbhdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #ffffff;
    border-bottom: 1px solid var(--line, #e3e3ee);
  }
  .fbhdr .hdr-main {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-block: 14px;
  }
  .logo img {
    height: 40px;
    width: auto;
  }
  .burger {
    display: none;
    background: none;
    border: 0;
    padding: 6px;
    cursor: pointer;
    color: var(--ink, #22235c);
  }
  .search {
    flex: 1;
    position: relative;
    max-width: 540px;
  }
  .search input {
    width: 100%;
    border: 1px solid var(--line, #e3e3ee);
    background: var(--mist, #f3f3f8);
    border-radius: 999px;
    padding: 11px 16px 11px 42px;
    font-size: 14px;
    color: var(--ink, #22235c);
    outline: none;
    transition: background 0.2s, border-color 0.2s;
  }
  .search input:focus {
    background: #ffffff;
    border-color: var(--ink, #22235c);
  }
  .search svg {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0.6;
    color: var(--ink, #22235c);
  }
  .suggest {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: #ffffff;
    border: 1px solid var(--line, #e3e3ee);
    border-radius: 16px;
    box-shadow: 0 18px 40px rgba(34, 35, 92, 0.14);
    padding: 10px;
    z-index: 60;
    max-height: 70vh;
    overflow-y: auto;
  }
  .suggest h5 {
    margin: 6px 10px 8px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted, #5f6178);
  }
  .suggest a {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 8px 10px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink, #22235c);
    font-size: 13.5px;
    transition: background 0.15s;
  }
  .suggest a:hover {
    background: var(--mist, #f3f3f8);
  }
  .suggest img {
    width: 38px;
    height: 38px;
    border-radius: 6px;
    object-fit: cover;
  }
  .suggest .pp {
    margin-left: auto;
    font-weight: 600;
    font-size: 13px;
    color: var(--flora-deep, #ad1f2b);
  }
  .pinchip {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--line, #e3e3ee);
    border-radius: 999px;
    padding: 6px 14px;
    background: #ffffff;
    cursor: pointer;
    text-align: left;
    white-space: nowrap;
    line-height: 1.2;
    transition: border-color 0.15s;
  }
  .pinchip:hover {
    border-color: var(--ink, #22235c);
  }
  .mk .cur-sel {
    color: var(--ink, #22235c);
    background: #ffffff;
    border: 1px solid var(--line, #e3e3ee);
    border-radius: 999px;
    padding: 9px 12px;
    font-size: 13px;
    font-weight: 500;
    max-width: 190px;
    cursor: pointer;
    outline: none;
  }
  .mk .cur-sel:hover {
    border-color: var(--ink, #22235c);
  }
  .hicons {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }
  .hicon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 6px 10px;
    border-radius: 10px;
    font-size: 11.5px;
    position: relative;
    text-decoration: none;
    color: var(--ink, #22235c);
    cursor: pointer;
  }
