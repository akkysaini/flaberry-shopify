<!-- Custom Slide-Out Cart Drawer (#cartdrawer) - 100% Ajax-driven, Absolute/Fixed Position (Never Pushes Window) -->
<aside class="drawer cart-drawer-custom" id="cartdrawer" aria-label="Cart" aria-hidden="true">
  <header>
    <h3>Your cart</h3>
    <button class="x" type="button" aria-label="Close cart" onclick="window.flaberryCloseCartDrawer()">×</button>
  </header>
  <div class="body" id="cartdrawerContent">
    {% if cart.item_count > 0 %}
      <div style="display: grid; gap: 14px;">
        {% for item in cart.items %}
          <div class="citem">
            <img src="{{ item.image | image_url: width: 160, height: 160 }}" alt="{{ item.title | escape }}" width="76" height="76" loading="lazy">
            <div>
              <h4>{{ item.product.title }}</h4>
              <div class="meta">
                {% unless item.variant.title contains 'Default' %}
                  <span>{{ item.variant.title }}</span>
                {% endunless %}
                {% for property in item.properties %}
                  {% assign first_char = property.first | slice: 0 %}
                  {% unless first_char == '_' or property.last == blank %}
                    <div style="font-size: 11.5px; color: var(--muted, #5f6178); margin-top: 2px;">
                      <strong>{{ property.first }}:</strong> {{ property.last }}
                    </div>
                  {% endunless %}
                {% endfor %}
              </div>
              <div class="ctl">
                <div class="qty">
                  <button type="button" onclick="window.flaberryUpdateCartQty('{{ item.key }}', {{ item.quantity | minus: 1 }})" aria-label="Decrease">−</button>
                  <span>{{ item.quantity }}</span>
                  <button type="button" onclick="window.flaberryUpdateCartQty('{{ item.key }}', {{ item.quantity | plus: 1 }})" aria-label="Increase">+</button>
                </div>
                <b class="tab-nums price-val" data-raw-inr="{{ item.final_line_price | divided_by: 100.0 }}">{{ item.final_line_price | money }}</b>
              </div>
              <button type="button" class="linkbtn" onclick="window.flaberryUpdateCartQty('{{ item.key }}', 0)">Remove</button>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div style="text-align: center; padding: 40px 20px;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" style="margin: 0 auto 12px; opacity: 0.4;"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.5L21 8H6"/><circle cx="10" cy="20" r="1.3"/><circle cx="17" cy="20" r="1.3"/></svg>
        <h4 style="font-size: 17px; margin-bottom: 8px;">Your cart is empty</h4>
        <p style="color: var(--muted, #5f6178); font-size: 13.5px; margin-bottom: 20px;">Explore handcrafted bouquets and fresh cakes for your loved ones.</p>
        <a href="{{ routes.collections_url }}/flowers" class="btn flora" style="padding: 10px 20px; font-size: 14px;">Shop Flowers</a>
      </div>
    {% endif %}
  </div>
  <footer id="cartdrawerFooter" {% if cart.item_count == 0 %}hidden{% endif %}>
    <div style="display: flex; justify-content: space-between; font-size: 14px;">
      <span style="color: var(--muted, #5f6178);">Subtotal</span>
      <b id="cartSubtotalVal" class="price-val" data-raw-inr="{{ cart.total_price | divided_by: 100.0 }}">{{ cart.total_price | money }}</b>
    </div>
    <div style="display: flex; justify-content: space-between; font-size: 13px; color: var(--muted, #5f6178);">
      <span>Delivery charges</span>
      <span>Calculated at checkout</span>
    </div>
    <div style="display: grid; gap: 8px; margin-top: 6px;">
      <a href="{{ routes.cart_url }}" class="btn ghost block" style="width: 100%; text-align: center;">View cart</a>
      <a href="/checkout" id="cartCheckoutBtn" class="btn flora block" style="width: 100%; text-align: center;">Checkout · {{ cart.total_price | money }}</a>
    </div>
  </footer>
</aside>

