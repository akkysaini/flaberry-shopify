{% comment %}
  Flaberry Classic Header & Global Navigation Shell
  Source of Truth: reference/Flaberry_Design1_Classic.html and user prototype reference screenshots
  Includes:
  1. Header Row (Burger, Logo, Ajax Predictive Search, Pincode Chip, Country/Currency Selector, Icons: Track, Support, Account, Cart)
  2. Desktop Navigation with Full-Width Mega Menus for all 10 categories
  3. Mobile Navigation Drawer (#mobmenu) with 2-level progressive drill-down & quick links
  4. Mobile Search Slide Drawer (#searchdrawer) with live Ajax Predictive Search
  5. Custom Slide Cart Drawer (#cartdrawer) - 100% Ajax-based, absolute/fixed position (never pushes the window), dynamic + / - / remove, auto-opens on Add-to-Cart
  6. Real-time Sitewide Currency Conversion Engine (INR, USD, AED, GBP, EUR, CAD, AUD, SGD, SAR) with instant DOM updates and persistent selection
{% endcomment %}

<!-- Sticky Main Header -->
<header class="hdr fbhdr" id="flaberryMainHdr">
  <div class="wrap hdr-main">
    <!-- Mobile Burger Toggle Button -->
    <button class="burger" id="burger" type="button" aria-label="Open menu" onclick="window.flaberryOpenMobMenu()">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M3 12h12M3 18h18"/></svg>
    </button>

    <!-- Flaberry Logo -->
    <a class="logo" href="{{ routes.root_url }}" aria-label="Flaberry home">
      <img src="{{ 'logo.png' | asset_url }}" alt="Flaberry" width="160" height="40" style="height: 40px; width: auto; display: block;">
    </a>

    <!-- Predictive Search Bar with Ajax real-time letter-by-letter results (Shopify Search & Discovery enabled) -->
    <form class="search" id="flaberrySearchForm" action="{{ routes.search_url }}" method="get" role="search" onsubmit="flaberryOnSearchSubmit(event)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      <input
        type="search"
        name="q"
        id="flaberrySearchInput"
        placeholder="Search flowers, cakes, gifts…"
        autocomplete="off"
        aria-label="Search"
        onfocus="flaberryOnSearchFocus()"
        oninput="flaberryOnSearchInput(this.value)"
      >
      <div class="suggest" id="flaberrySuggestBox" hidden>
        <div id="flaberrySuggestContent">
          <h5>Trending Gifting Searches</h5>
          <a href="{{ routes.collections_url }}/roses" class="search-item">
            <img src="{{ 'hx_roses.webp' | asset_url }}" alt="Roses" width="46" height="46" loading="lazy">
            <div class="search-item-info">
              <span class="search-item-title">Red Roses Handcrafted Bouquets</span>
              <span class="search-item-price price-val" data-raw-inr="999">From ₹999</span>
            </div>
          </a>
          <a href="{{ routes.collections_url }}/chocolate-cakes" class="search-item">
            <img src="{{ 'hx_truffle.webp' | asset_url }}" alt="Truffle" width="46" height="46" loading="lazy">
            <div class="search-item-info">
              <span class="search-item-title">Belgian Chocolate Truffle Cake</span>
              <span class="search-item-price price-val" data-raw-inr="849">From ₹849</span>
            </div>
          </a>
          <a href="{{ routes.collections_url }}/photo-cakes" class="search-item">
            <img src="{{ 't_photocake.webp' | asset_url }}" alt="Photo cake" width="46" height="46" loading="lazy">
            <div class="search-item-info">
              <span class="search-item-title">Personalized Photo Celebration Cake</span>
              <span class="search-item-price price-val" data-raw-inr="929">From ₹929</span>
            </div>
          </a>
          <a href="{{ routes.collections_url }}/combos" class="search-item">
            <img src="{{ 't_cakeflower2.webp' | asset_url }}" alt="Combos" width="46" height="46" loading="lazy">
            <div class="search-item-info">
              <span class="search-item-title">Flower & Cake Surprise Hampers</span>
              <span class="search-item-price price-val" data-raw-inr="1499">From ₹1,499</span>
            </div>
          </a>
        </div>
      </div>
    </form>

    <!-- Delivery Pincode Chip -->
    <button type="button" class="pinchip" id="pinchip" onclick="flaberryOpenPinModal()" aria-label="Select delivery city">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <div>
        <span style="font-size: 11px; color: var(--muted, #5f6178); display: block; line-height: 1;">Deliver to</span>
        <b id="hdrPinCity" style="font-size: 13px; color: var(--ink, #22235c); font-weight: 600;">201301 · Noida</b>
      </div>
    </button>

    <!-- Country & Currency Selector: Shopify Markets Native Localization -->
    {% if localization.available_countries.size > 1 %}
      <div class="mk">
        <label class="sr" for="HeaderCountrySelect">{{ 'actions.select_country' | t | default: 'Country and currency' }}</label>
        {%- form 'localization', id: 'HeaderCountryForm', class: 'header__localization-form' -%}
          <select id="HeaderCountrySelect" name="country_code" class="cur-sel" title="Country / currency" onchange="this.form.submit()">
            {% for country in localization.available_countries %}
              <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                {{ country.name }} · {{ country.currency.symbol }} {{ country.currency.iso_code }}
              </option>
            {% endfor %}
          </select>
        {%- endform -%}
      </div>
    {% endif %}

    <!-- Language Selector: Shopify Translate & Adapt Localization -->
    {% if localization.available_languages.size > 1 %}
      <div class="mk lang-select">
        <label class="sr" for="HeaderLanguageSelect">{{ 'actions.select_language' | t | default: 'Language' }}</label>
        {%- form 'localization', id: 'HeaderLanguageForm', class: 'header__localization-form' -%}
          <select id="HeaderLanguageSelect" name="language_code" class="cur-sel" title="Language" onchange="this.form.submit()">
            {% for language in localization.available_languages %}
              <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                {{ language.endonym_name | capitalize }}
              </option>
            {% endfor %}
          </select>
        {%- endform -%}
      </div>
    {% endif %}

    <!-- Header Action Icons -->
    <nav class="hicons">
      <a class="hicon opt" href="/pages/serviceable-pincodes">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.7"/><circle cx="17" cy="17.5" r="1.7"/></svg>
        <span class="lbl">Track Order</span>
      </a>
      <a class="hicon opt" href="/pages/contact-us">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .9-1 1.7M12 17h.01"/></svg>
        <span class="lbl">Support</span>
      </a>
      {% if customer %}
        <a class="hicon" href="{{ routes.account_url }}">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
          <span class="lbl">{{ customer.first_name | default: 'Account' }}</span>
        </a>
      {% else %}
        <a class="hicon" href="{{ routes.account_login_url }}">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
          <span class="lbl">Sign in</span>
        </a>
      {% endif %}
      <a class="hicon" href="{{ routes.cart_url }}" id="cartbtn" onclick="flaberryToggleCartDrawer(event)">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.5L21 8H6"/><circle cx="10" cy="20" r="1.3"/><circle cx="17" cy="20" r="1.3"/></svg>
        <span class="lbl">Cart</span>
        <span class="badge" id="hdrCartBadge" {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </nav>
