  // Global Drawer Open / Close Controls
  window.flaberryOpenMobMenu = function() {
    flaberryShowMobLvl1();
    var d = document.getElementById('mobmenu');
    var s = document.getElementById('scrim');
    if (d) d.classList.add('on');
    if (s) s.classList.add('on');
  };

  window.flaberryCloseMobMenu = function() {
    var d = document.getElementById('mobmenu');
    var s = document.getElementById('scrim');
    if (d) d.classList.remove('on');
    if (s) s.classList.remove('on');
  };

  function flaberryShowMobLvl1() {
    var title = document.getElementById('mobmenuTitle');
    var lvl1 = document.getElementById('mobmenuLvl1');
    var quick = document.getElementById('mobmenuQuick');
    var lvl2 = document.getElementById('mobmenuLvl2');
    if (title) title.textContent = 'Categories';
    if (lvl1) lvl1.hidden = false;
    if (quick) quick.hidden = false;
    if (lvl2) {
      lvl2.hidden = true;
      lvl2.innerHTML = '';
    }
  }

  function flaberryShowMobSub(index) {
    var data = FLABERRY_MOB_MENUS[index];
    if (!data) return;
    var title = document.getElementById('mobmenuTitle');
    var lvl1 = document.getElementById('mobmenuLvl1');
    var quick = document.getElementById('mobmenuQuick');
    var lvl2 = document.getElementById('mobmenuLvl2');
    if (title) title.textContent = data.label;
    if (lvl1) lvl1.hidden = true;
    if (quick) quick.hidden = true;
    if (!lvl2) return;
    lvl2.hidden = false;

    var html = '<button class="mm-back" type="button" onclick="flaberryShowMobLvl1()">‹ All categories</button>' +
      '<div class="mm-lvl"><span style="font-size: 11px; text-transform: uppercase; color: var(--muted, #5f6178); font-weight: 600;">Shop</span>' +
      '<h4>' + data.label + '</h4></div>' +
      '<a class="btn ghost block" href="/collections/all" style="width: 100%; text-align: center; margin-bottom: 12px;">Shop all ' + data.label + '</a>';

    data.groups.forEach(function(grp, gIdx) {
      html += '<details class="mm-grp" ' + (gIdx === 0 ? 'open' : '') + '>' +
        '<summary>' + grp.title + '</summary>' +
        '<div class="mm-links">';
      grp.links.forEach(function(lnk) {
        html += '<a href="' + lnk[1] + '">' + lnk[0] + '</a>';
      });
      html += '</div></details>';
    });

    lvl2.innerHTML = html;
  }

  // Mobile Search Slide Popup Drawer Controls
  window.flaberryOpenSearchDrawer = function() {
    var d = document.getElementById('searchdrawer');
    var s = document.getElementById('scrim');
    if (d) d.classList.add('on');
    if (s) s.classList.add('on');
    setTimeout(function() {
      var inp = document.getElementById('mobSearchInput');
      if (inp) inp.focus();
    }, 150);
  };

  window.flaberryCloseSearchDrawer = function() {
    var d = document.getElementById('searchdrawer');
    var s = document.getElementById('scrim');
    if (d) d.classList.remove('on');
    if (s) s.classList.remove('on');
  };

  var flaberryMobSearchTimer = null;
  function flaberryOnMobSearchInput(val) {
    clearTimeout(flaberryMobSearchTimer);
    var q = (val || '').trim();
    var trending = document.getElementById('mobSearchTrending');
    var results = document.getElementById('mobSearchResults');
    if (!trending || !results) return;

    if (!q) {
      trending.hidden = false;
      results.hidden = true;
      results.innerHTML = '';
      return;
    }

    flaberryMobSearchTimer = setTimeout(function() {
      fetch('/search/suggest.json?q=' + encodeURIComponent(q) + '&resources[type]=product,collection&resources[limit]=6')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var products = (data && data.resources && data.resources.results && data.resources.results.products) || [];
          var collections = (data && data.resources && data.resources.results && data.resources.results.collections) || [];

          trending.hidden = true;
          results.hidden = false;

          if (products.length === 0 && collections.length === 0) {
            results.innerHTML = '<div style="padding: 16px 0; color: var(--muted, #5f6178); font-size: 14px;">No products found for "' + q + '".</div>';
            return;
          }

          var out = '<h5 style="margin: 0 0 10px; font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted, #5f6178);">Matching Results</h5>';
          out += '<div style="display: grid; gap: 12px;">';
          products.forEach(function(p) {
            var img = p.image || '{{ "hx_roses.webp" | asset_url }}';
            var rawPrice = parseFloat(p.price) || 0;
            var formattedPrice = rawPrice > 0 ? flaberryFormatMoney(rawPrice) : '';
            out += '<a href="' + p.url + '" class="search-item">' +
              '<img src="' + img + '" alt="' + p.title + '" width="46" height="46">' +
              '<div class="search-item-info">' +
                '<span class="search-item-title">' + p.title + '</span>' +
                (formattedPrice ? '<span class="search-item-price price-val" data-raw-inr="' + rawPrice + '">' + formattedPrice + '</span>' : '') +
              '</div>' +
              '</a>';
          });
          collections.forEach(function(c) {
            out += '<a href="' + c.url + '" style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: var(--mist, #f3f3f8); border-radius: 8px; text-decoration: none; color: var(--ink, #22235c); font-size: 13.5px; font-weight: 500;">' +
              '<span>📂 Collection: ' + c.title + '</span>' +
              '<span style="color: var(--flora-deep, #ad1f2b); font-weight: 600;">View →</span>' +
              '</a>';
          });
          out += '</div>';
          results.innerHTML = out;
        })
        .catch(function(e) {
          trending.hidden = false;
          results.hidden = true;
        });
    }, 260);
  }

  // 100% Ajax Cart Drawer Engine
  window.flaberryRefreshCartDrawer = function(openAfter) {
    if (openAfter === undefined) openAfter = true;
    fetch('/cart.js')
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        var count = cart.item_count || 0;
        var hdrBadge = document.getElementById('hdrCartBadge');
        var dockBadge = document.getElementById('dockbadge');
        if (hdrBadge) {
          hdrBadge.textContent = count;
          hdrBadge.hidden = count === 0;
        }
        if (dockBadge) {
          dockBadge.textContent = count;
          dockBadge.hidden = count === 0;
        }

        var container = document.getElementById('cartdrawerContent');
        var footer = document.getElementById('cartdrawerFooter');
        if (!container) return;

        if (count === 0) {
          container.innerHTML = '<div style="text-align: center; padding: 40px 20px;">' +
            '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" style="margin: 0 auto 12px; opacity: 0.4;"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.5L21 8H6"/><circle cx="10" cy="20" r="1.3"/><circle cx="17" cy="20" r="1.3"/></svg>' +
            '<h4 style="font-size: 17px; margin-bottom: 8px;">Your cart is empty</h4>' +
            '<p style="color: var(--muted, #5f6178); font-size: 13.5px; margin-bottom: 20px;">Explore handcrafted bouquets and fresh cakes for your loved ones.</p>' +
            '<a href="/collections/flowers" class="btn flora" style="padding: 10px 20px; font-size: 14px;">Shop Flowers</a>' +
            '</div>';
          if (footer) footer.hidden = true;
        } else {
          var html = '<div style="display: grid; gap: 14px;">';
          cart.items.forEach(function(item) {
            var itemImg = item.featured_image ? item.featured_image.url : (item.image || '');
            var variantLabel = (item.variant_title && item.variant_title.indexOf('Default') === -1) ?
              '<span>' + item.variant_title + '</span>' : '';
            var rawItemPrice = (item.final_line_price || 0) / 100.0;
            var formattedPrice = flaberryFormatMoney(rawItemPrice);

            var propsHtml = '';
            if (item.properties) {
              if (Array.isArray(item.properties)) {
                item.properties.forEach(function(p) {
                  if (p[0] && p[0].charAt(0) !== '_' && p[1]) {
                    propsHtml += '<div style="font-size: 11.5px; color: var(--muted, #5f6178); margin-top: 2px;"><strong>' + p[0] + ':</strong> ' + p[1] + '</div>';
                  }
                });
              } else if (typeof item.properties === 'object') {
                Object.keys(item.properties).forEach(function(k) {
                  if (k.charAt(0) !== '_' && item.properties[k]) {
                    propsHtml += '<div style="font-size: 11.5px; color: var(--muted, #5f6178); margin-top: 2px;"><strong>' + k + ':</strong> ' + item.properties[k] + '</div>';
                  }
                });
              }
            }

            html += '<div class="citem">' +
              '<img src="' + itemImg + '" alt="' + item.title + '" width="76" height="76">' +
              '<div>' +
                '<h4>' + (item.product_title || item.title) + '</h4>' +
                '<div class="meta">' + variantLabel + propsHtml + '</div>' +
                '<div class="ctl">' +
                  '<div class="qty">' +
                    '<button type="button" onclick="window.flaberryUpdateCartQty(\'' + item.key + '\', ' + (item.quantity - 1) + ')" aria-label="Decrease">−</button>' +
                    '<span>' + item.quantity + '</span>' +
                    '<button type="button" onclick="window.flaberryUpdateCartQty(\'' + item.key + '\', ' + (item.quantity + 1) + ')" aria-label="Increase">+</button>' +
                  '</div>' +
                  '<b class="tab-nums price-val" data-raw-inr="' + rawItemPrice + '">' + formattedPrice + '</b>' +
                '</div>' +
                '<button type="button" class="linkbtn" onclick="window.flaberryUpdateCartQty(\'' + item.key + '\', 0)">Remove</button>' +
              '</div>' +
            '</div>';
          });
          html += '</div>';
          container.innerHTML = html;

          if (footer) {
            footer.hidden = false;
            var rawTotal = (cart.total_price || 0) / 100.0;
            var subFormatted = flaberryFormatMoney(rawTotal);
            var subEl = document.getElementById('cartSubtotalVal');
            if (subEl) {
              subEl.textContent = subFormatted;
              subEl.setAttribute('data-raw-inr', rawTotal);
            }
            var chkBtn = document.getElementById('cartCheckoutBtn');
            if (chkBtn) {
              chkBtn.textContent = 'Checkout · ' + subFormatted;
            }
          }
        }

        if (openAfter) {
          var cd = document.getElementById('cartdrawer');
          var sc = document.getElementById('scrim');
          if (cd) {
            cd.classList.add('on');
            cd.setAttribute('aria-hidden', 'false');
          }
          if (sc) sc.classList.add('on');
        }
      })
      .catch(function(err) {
        console.error('Failed to refresh cart', err);
      });
  };

  window.flaberryOpenCartDrawer = function() {
    window.flaberryRefreshCartDrawer(true);
  };

  window.flaberryUpdateCartQty = function(key, newQty) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: newQty })
    })
    .then(function(r) { return r.json(); })
    .then(function() {
      flaberryRefreshCartDrawer(false);
    })
    .catch(function(err) {
      console.error('Cart quantity update error', err);
    });
  };

  window.flaberryToggleCartDrawer = function(e) {
    if (e) e.preventDefault();
    flaberryRefreshCartDrawer(true);
  };

  window.flaberryCloseCartDrawer = function() {
    var cd = document.getElementById('cartdrawer');
    var sc = document.getElementById('scrim');
    if (cd) cd.classList.remove('on');
    if (sc) sc.classList.remove('on');
  };

  window.flaberryCloseAllDrawers = function() {
    var md = document.getElementById('mobmenu');
    var cd = document.getElementById('cartdrawer');
    var sd = document.getElementById('searchdrawer');
    var sc = document.getElementById('scrim');
    if (md) md.classList.remove('on');
    if (cd) cd.classList.remove('on');
    if (sd) sd.classList.remove('on');
    if (sc) sc.classList.remove('on');
  };

  // Intercept Global Add to Cart and open custom Ajax Cart Drawer smoothly
  document.addEventListener('submit', function(e) {
    var form = e.target.closest('form[action*="/cart/add"]');
    if (form) {
      e.preventDefault();
      var formData = new FormData(form);
      fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      })
      .then(function(r) { return r.json(); })
      .then(function(item) {
        flaberryRefreshCartDrawer(true);
      })
      .catch(function(err) {
        form.submit();
      });
    }
  });

  // Desktop Search & Nav Interactions
  var flaberrySearchTimer = null;
  var flaberryDefaultSuggestHTML = '';

  document.addEventListener('DOMContentLoaded', function() {
    var defBox = document.getElementById('flaberrySuggestContent');
    if (defBox) flaberryDefaultSuggestHTML = defBox.innerHTML;

    // Apply currency sitewide and observe cart DOM updates
    flaberryApplyCurrencySitewide();
    flaberryInitCartCurrencyObserver();

    // Listen to cart update events
    window.addEventListener('cart:updated', function() { flaberryApplyCurrencySitewide(); });
    document.addEventListener('cart:updated', function() { flaberryApplyCurrencySitewide(); });
    document.addEventListener('CartLinesUpdateEvent', function() { setTimeout(flaberryApplyCurrencySitewide, 50); });

    // Desktop hover & click handling for Nav items
    var navItems = document.querySelectorAll('.nav > div.has');
    navItems.forEach(function(item) {
      var timer;
      item.addEventListener('mouseenter', function() {
        clearTimeout(timer);
        navItems.forEach(function(other) { if (other !== item) other.classList.remove('open'); });
        item.classList.add('open');
      });
      item.addEventListener('mouseleave', function() {
        timer = setTimeout(function() { item.classList.remove('open'); }, 150);
      });
    });

    document.addEventListener('click', function(e) {
      if (!e.target.closest('#flaberrySearchForm')) {
        var box = document.getElementById('flaberrySuggestBox');
        if (box) box.hidden = true;
      }
    });
  });

  function flaberryOnSearchFocus() {
    var box = document.getElementById('flaberrySuggestBox');
    if (box) box.hidden = false;
  }

  function flaberryOnSearchInput(val) {
    clearTimeout(flaberrySearchTimer);
    var query = (val || '').trim();
    var box = document.getElementById('flaberrySuggestBox');
    var content = document.getElementById('flaberrySuggestContent');
    if (!box || !content) return;

    if (!query) {
      box.hidden = false;
      content.innerHTML = flaberryDefaultSuggestHTML;
      flaberryApplyCurrencySitewide();
      return;
    }

    box.hidden = false;
    flaberrySearchTimer = setTimeout(function() {
      fetch('/search/suggest.json?q=' + encodeURIComponent(query) + '&resources[type]=product,collection&resources[limit]=6')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var products = (data && data.resources && data.resources.results && data.resources.results.products) || [];
          var collections = (data && data.resources && data.resources.results && data.resources.results.collections) || [];

          if (products.length === 0 && collections.length === 0) {
            content.innerHTML = '<div style="padding: 12px 10px; color: var(--muted, #5f6178); font-size: 13.5px;">No products found for "' + query + '". Press Enter to view full search results.</div>';
            return;
          }

          var out = '<h5>Matching Results</h5>';
          products.forEach(function(p) {
            var img = p.image || '{{ "hx_roses.webp" | asset_url }}';
            var rawPrice = parseFloat(p.price) || 0;
            var formattedPrice = rawPrice > 0 ? flaberryFormatMoney(rawPrice) : '';
            out += '<a href="' + p.url + '" class="search-item">' +
              '<img src="' + img + '" alt="' + p.title + '" width="46" height="46">' +
              '<div class="search-item-info">' +
                '<span class="search-item-title">' + p.title + '</span>' +
                (formattedPrice ? '<span class="search-item-price price-val" data-raw-inr="' + rawPrice + '">' + formattedPrice + '</span>' : '') +
              '</div>' +
              '</a>';
          });
          collections.forEach(function(c) {
            out += '<a href="' + c.url + '" style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: var(--mist, #f3f3f8); border-radius: 8px; text-decoration: none; color: var(--ink, #22235c); font-size: 13.5px; font-weight: 500;">' +
              '<span>📂 Collection: ' + c.title + '</span>' +
              '<span style="color: var(--flora-deep, #ad1f2b); font-weight: 600;">View →</span>' +
              '</a>';
          });
          content.innerHTML = out;
        })
        .catch(function() {
          content.innerHTML = flaberryDefaultSuggestHTML;
        });
    }, 280);
  }

  function flaberryOnSearchSubmit(e) {
    // Standard submit to /search
  }

  // Pincode Modal Handlers
  function flaberryOpenPinModal() {
    var m = document.getElementById('flaberryPinModal');
    if (m) m.hidden = false;
  }

  function flaberryClosePinModal() {
    var m = document.getElementById('flaberryPinModal');
    if (m) m.hidden = true;
  }

  function flaberrySubmitModalPin() {
    var val = document.getElementById('modalPincodeInp').value.trim();
    if (val.length === 6 && /^\d+$/.test(val)) {
      document.getElementById('hdrPinCity').textContent = val + ' · Verified';
      try { localStorage.setItem('flaberry_pincode', val); } catch(e){}
      flaberryClosePinModal();
    } else {
      alert('Please enter a valid 6-digit Indian pincode.');
    }
  }

  function flaberrySetQuickPin(city, pin) {
    document.getElementById('hdrPinCity').textContent = pin + ' · ' + city;
    try { localStorage.setItem('flaberry_pincode', pin); } catch(e){}
    flaberryClosePinModal();
  }
</script>

