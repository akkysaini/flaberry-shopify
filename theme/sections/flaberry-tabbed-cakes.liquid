                  {% render 'flaberry-product-card', title: 'Jungle Safari Photo Cake', price: 929, rating: '4.5', reviews_count: 86, tag: 'Personalised', image_asset: 'p184.webp', link: '/products/jungle-safari-photo-cake' %}
                  {% render 'flaberry-product-card', title: 'Jungle Kids Photo Cake', price: 929, rating: '4.9', reviews_count: 210, tag: 'Bestseller', image_asset: 'p185.webp', link: '/products/jungle-kids-photo-cake' %}

                {% when 3 %}
                  {% comment %} Tab 4: Eggless Cakes (8 Items, 2 Rows of 4) {% endcomment %}
                  {% render 'flaberry-product-card', title: 'Almond Choco Truffle Cake Eggless', price: 799, rating: '4.3', reviews_count: 100, tag: 'Eggless', image_asset: 'p144.webp', link: '/products/almond-choco-truffle-cake-eggless' %}
                  {% render 'flaberry-product-card', title: 'Rich Truffle Eggless Cake', price: 1397, rating: '4.7', reviews_count: 248, tag: 'Eggless', image_asset: 'p188.webp', link: '/products/rich-truffle-eggless-cake' %}
