                  {% render 'flaberry-product-card', title: 'Pineapple Cake Eggless', price: 649, rating: '4.4', reviews_count: 61, tag: 'Eggless', image_asset: 'p166.webp', link: '/products/pineapple-cake-eggless' %}
                  {% render 'flaberry-product-card', title: 'Chocolate Cake Eggless', price: 740, rating: '5.0', reviews_count: 99, tag: 'Bestseller', image_asset: 'p131.webp', link: '/products/chocolate-cake-eggless' %}
                  {% render 'flaberry-product-card', title: 'Vanilla Cake Eggless', price: 699, rating: '4.3', reviews_count: 84, tag: 'Eggless', image_asset: 'p191.webp', link: '/products/vanilla-cake-eggless' %}
                  {% render 'flaberry-product-card', title: 'Crushed Pineapple Eggless Cake', price: 1299, rating: '5.0', reviews_count: 67, tag: 'Bestseller', image_asset: 'p192.webp', link: '/products/crushed-pineapple-eggless-cake' %}

                {% when 4 %}
                  {% comment %} Tab 5: Designer Cakes (8 Items, 2 Rows of 4) {% endcomment %}
