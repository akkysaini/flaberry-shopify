                {% else %}
                  {% comment %} General fallback {% endcomment %}
                  {% render 'flaberry-product-card', title: 'Chocolate Cake', price: 1299, rating: '4.9', reviews_count: 18, tag: 'Bestseller', image_asset: 'p125.webp', link: '/products/chocolate-cake' %}
