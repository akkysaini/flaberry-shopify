  </div>
</section>

<style>
  .flaberry-tabbed-cakes-sec {
    padding: 36px 0 44px;
    background: #ffffff;
    width: 100%;
  }
  .flaberry-tabbed-cakes-sec .wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
    width: 100%;
  }
  .flaberry-tabbed-cakes-sec .sec-h {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
    flex-wrap: wrap;
  }
  .flaberry-tabbed-cakes-sec .sec-h-text h2 {
    font-family: var(--display, inherit);
    font-size: clamp(24px, 3.2vw, 36px);
    font-weight: 700;
    color: #1e1b4b;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .flaberry-tabbed-cakes-sec .sec-h-text p {
    color: var(--muted, #6b7280);
    margin: 6px 0 0;
    font-size: 14.5px;
    max-width: 65ch;
    line-height: 1.45;
  }
  .flaberry-tabbed-cakes-sec .optrow-wrap {
    display: flex;
    align-items: center;
  }
  .flaberry-tabbed-cakes-sec .optrow {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .flaberry-tabbed-cakes-sec .chip {
    padding: 7px 16px;
    border-radius: 999px;
    border: 1px solid var(--line, #e7e1dd);
    background: #ffffff;
    font-size: 13.5px;
    font-weight: 500;
    color: #1e1b4b;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
    line-height: 1.4;
  }
  .flaberry-tabbed-cakes-sec .chip:hover {
    border-color: #1e1b4b;
  }
  .flaberry-tabbed-cakes-sec .chip.on {
    background: #1e1b4b;
    color: #ffffff;
    border-color: #1e1b4b;
  }
  .flaberry-tabbed-cakes-sec .btn.ghost.sm {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 7px 18px;
    font-size: 13.5px;
    font-weight: 600;
    color: #1e1b4b;
    background: transparent;
    border: 1px solid #1e1b4b;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
    line-height: 1.4;
    margin-left: 4px;
  }
  .flaberry-tabbed-cakes-sec .btn.ghost.sm:hover {
    background: #1e1b4b;
    color: #ffffff;
  }

  /* Scoped Cake Grid - 4 Columns Desktop (2 Rows), 2 Columns Mobile */
  .flaberry-tabbed-cakes-sec .cake-tab-panels {
    width: 100%;
  }
  .flaberry-tabbed-cakes-sec .cake-panel {
    display: none;
    width: 100%;
  }
  .flaberry-tabbed-cakes-sec .cake-panel.on {
    display: block;
    animation: fadeInCakePanel 0.2s ease-out;
  }
  @keyframes fadeInCakePanel {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Explicit grid styles ensuring exactly 4 columns on desktop (2 rows of 4) */
  .flaberry-tabbed-cakes-sec .flaberry-cakes-grid {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 22px 16px !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    box-sizing: border-box !important;
  }

  /* Tablet */
  @media (max-width: 1100px) {
    .flaberry-tabbed-cakes-sec .flaberry-cakes-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      gap: 18px 14px !important;
    }
  }

  /* Mobile: Exactly 2 Columns */
  @media (max-width: 768px) {
    .flaberry-tabbed-cakes-sec {
      padding: 24px 0 32px;
    }
    .flaberry-tabbed-cakes-sec .wrap {
      padding: 0 16px;
    }
    .flaberry-tabbed-cakes-sec .sec-h {
      margin-bottom: 16px;
      gap: 12px;
    }
    .flaberry-tabbed-cakes-sec .sec-h-text h2 {
      font-size: 22px;
    }
    .flaberry-tabbed-cakes-sec .sec-h-text p {
      font-size: 13px;
      line-height: 1.4;
      margin-top: 4px;
    }
    .flaberry-tabbed-cakes-sec .optrow-wrap {
      width: 100%;
    }
    .flaberry-tabbed-cakes-sec .optrow {
      width: 100%;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 4px;
      scrollbar-width: none;
      -ms-overflow-style: none;
      -webkit-overflow-scrolling: touch;
    }
    .flaberry-tabbed-cakes-sec .optrow::-webkit-scrollbar {
      display: none;
    }
    .flaberry-tabbed-cakes-sec .chip {
      padding: 6px 14px;
      font-size: 12.5px;
      flex-shrink: 0;
    }
    .flaberry-tabbed-cakes-sec .btn.ghost.sm {
      padding: 6px 14px;
      font-size: 12.5px;
      flex-shrink: 0;
    }

    /* 2 Columns on Mobile strictly as requested */
    .flaberry-tabbed-cakes-sec .flaberry-cakes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 18px 12px !important;
    }
  }
</style>

<script>
  function flaberrySwitchCakeTab(secId, tabIndex) {
    var tabsWrap = document.getElementById('caketabs-' + secId);
    if (tabsWrap) {
      var chips = tabsWrap.querySelectorAll('.chip');
      chips.forEach(function(chip, idx) {
        if (idx === tabIndex) {
          chip.classList.add('on');
        } else {
          chip.classList.remove('on');
        }
      });
    }

    var sec = document.querySelector('[data-section-id="' + secId + '"]');
    if (sec) {
      var panels = sec.querySelectorAll('.cake-panel');
      panels.forEach(function(panel, idx) {
        if (idx === tabIndex) {
          panel.classList.add('on');
        } else {
          panel.classList.remove('on');
        }
      });
    }
  }
</script>

