                  {% render 'flaberry-product-card', title: 'Birthday Chocolate Cake', price: 799, rating: '4.5', reviews_count: 198, tag: '', image_asset: 'p127.webp', link: '/products/birthday-chocolate-cake' %}
                  {% render 'flaberry-product-card', title: 'Sweet Heart Chocolate Cake', price: 749, rating: '4.4', reviews_count: 213, tag: '', image_asset: 'p128.webp', link: '/products/sweet-heart-chocolate-cake' %}
                  {% render 'flaberry-product-card', title: 'Bittersweet Chocolate Cake', price: 1549, rating: '4.6', reviews_count: 119, tag: '', image_asset: 'p129.webp', link: '/products/bittersweet-chocolate-cake' %}
