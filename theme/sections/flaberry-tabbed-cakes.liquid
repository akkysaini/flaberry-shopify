                  {% render 'flaberry-product-card', title: 'Krishna Janmashtami Designer Cake', price: 1829, rating: '5.0', reviews_count: 35, tag: 'Bestseller', image_asset: 'p195.webp', link: '/products/krishna-janmashtami-designer-cake' %}
                  {% render 'flaberry-product-card', title: 'Five Tier Celebration Cake', price: 13990, rating: '5.0', reviews_count: 99, tag: 'Bestseller', image_asset: 'p196.webp', link: '/products/five-tier-celebration-cake' %}
                  {% render 'flaberry-product-card', title: 'Heroic Spiderman Cake', price: 1949, rating: '4.8', reviews_count: 193, tag: '', image_asset: 'p197.webp', link: '/products/heroic-spiderman-cake' %}
