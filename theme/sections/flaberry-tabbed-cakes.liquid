{% comment %}
  Flaberry Tabbed Cakes Section
  Source of Truth: reference/Flaberry_Design1_Classic.html (.sec-h, .optrow, .chip, .grid, .pcard)
  Interactive tabs for Chocolate, Truffle, Photo, Eggless, and Designer cakes.
  Desktop: 4-column product grid with 2 full rows (8 products).
  Mobile: 2-column product grid as per prototype.
  Max-width matches the exact homepage container standard (1440px).
{% endcomment %}

<section class="flaberry-tabbed-cakes-sec sec" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="sec-h">
      <div class="sec-h-text">
        <h2>{{ section.settings.title | default: 'Cakes for every celebration' }}</h2>
        <p>{{ section.settings.subtitle | default: 'Baked fresh on order. Choose eggless, pick a weight and add an icing message.' }}</p>
      </div>

      <div class="optrow-wrap">
        <div class="optrow" id="caketabs-{{ section.id }}">
          {% for block in section.blocks %}
            <button 
              type="button" 
              class="chip {% if forloop.first %}on{% endif %}" 
              onclick="flaberrySwitchCakeTab('{{ section.id }}', {{ forloop.index0 }})"
              data-tab-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.tab_title }}
            </button>
          {% endfor %}
          <a class="btn ghost sm" href="{{ routes.collections_url }}/cakes">{{ section.settings.view_all_text | default: 'All cakes' }}</a>
        </div>
      </div>
    </div>

    <div class="cake-tab-panels">
      {% for block in section.blocks %}
        {%- liquid
          assign coll_handle = block.settings.collection.handle | default: block.settings.collection
          assign tab_coll = collections[coll_handle]
        -%}
        <div 
          class="cake-panel {% if forloop.first %}on{% endif %}" 
          id="cakepanel-{{ section.id }}-{{ forloop.index0 }}"
        >
          <div class="flaberry-cakes-grid">
            {% if tab_coll != blank and tab_coll.products.size >= 8 %}
              {% for prod in tab_coll.products limit: 8 %}
                {% render 'flaberry-product-card', product: prod %}
              {% endfor %}
            {% else %}
              {% case forloop.index0 %}
                {% when 0 %}
                  {% comment %} Tab 1: Chocolate Cakes (8 Items, 2 Rows of 4) {% endcomment %}
                  {% render 'flaberry-product-card', title: 'Chocolate Cake', price: 1299, rating: '4.9', reviews_count: 18, tag: 'Bestseller', image_asset: 'p125.webp', link: '/products/chocolate-cake' %}
                  {% render 'flaberry-product-card', title: 'Heart Shape Chocolate Cake', price: 829, rating: '4.7', reviews_count: 40, tag: '', image_asset: 'p126.webp', link: '/products/heart-shape-chocolate-cake' %}
                  {% render 'flaberry-product-card', title: 'Birthday Chocolate Cake', price: 799, rating: '4.5', reviews_count: 198, tag: '', image_asset: 'p127.webp', link: '/products/birthday-chocolate-cake' %}
                  {% render 'flaberry-product-card', title: 'Sweet Heart Chocolate Cake', price: 749, rating: '4.4', reviews_count: 213, tag: '', image_asset: 'p128.webp', link: '/products/sweet-heart-chocolate-cake' %}
                  {% render 'flaberry-product-card', title: 'Bittersweet Chocolate Cake', price: 1549, rating: '4.6', reviews_count: 119, tag: '', image_asset: 'p129.webp', link: '/products/bittersweet-chocolate-cake' %}
                  {% render 'flaberry-product-card', title: 'Yummy Chocolate Cake', price: 709, rating: '4.3', reviews_count: 84, tag: '', image_asset: 'p130.webp', link: '/products/yummy-chocolate-cake' %}
                  {% render 'flaberry-product-card', title: 'Chocolate Cake Eggless', price: 740, rating: '5.0', reviews_count: 99, tag: 'Bestseller', image_asset: 'p131.webp', link: '/products/chocolate-cake-eggless' %}
                  {% render 'flaberry-product-card', title: 'Skellington Chocolate Cake', price: 849, rating: '4.5', reviews_count: 230, tag: '', image_asset: 'p132.webp', link: '/products/skellington-chocolate-cake' %}

                {% when 1 %}
                  {% comment %} Tab 2: Truffle Cakes (8 Items, 2 Rows of 4) {% endcomment %}
                  {% render 'flaberry-product-card', title: 'Rich Truffle Cake', price: 1399, rating: '4.9', reviews_count: 226, tag: 'Bestseller', image_asset: 'p137.webp', link: '/products/rich-truffle-cake' %}
                  {% render 'flaberry-product-card', title: 'Chocolate Truffle Cake', price: 775, rating: '4.3', reviews_count: 68, tag: '', image_asset: 'p138.webp', link: '/products/chocolate-truffle-cake' %}
                  {% render 'flaberry-product-card', title: 'Choco Truffle Cake', price: 629, rating: '4.9', reviews_count: 162, tag: '', image_asset: 'p139.webp', link: '/products/choco-truffle-cake' %}
                  {% render 'flaberry-product-card', title: 'Chocolate Truffle Cakes', price: 699, rating: '4.8', reviews_count: 129, tag: '', image_asset: 'p140.webp', link: '/products/chocolate-truffle-cakes' %}
