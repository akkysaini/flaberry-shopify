  @media (max-width: 640px) {
    .addons {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
    .slots {
      grid-template-columns: 1fr !important;
    }
    .trust {
      grid-template-columns: 1fr !important;
    }
    .buyrow {
      flex-direction: column !important;
      align-items: stretch !important;
    }
    .buyrow .qty {
      justify-content: center !important;
    }
    .sticky-buy {
      bottom: calc(60px + env(safe-area-inset-bottom, 0px)) !important;
      box-shadow: 0 -6px 16px rgba(34, 35, 92, 0.08) !important;
    }
  }
</style>

<script>
  (function() {
    // State management
    var basePriceInCents = {{ prod_price | default: 244000 }};
    var currentVariantPrice = basePriceInCents;
    var currentWeightFee = 0;
    var currentSlotFee = 0;
    var currentAddonSum = 0;
    var currentQty = 1;
    var currentPincode = '';
    var selectedDateIso = '';
    var selectedDateText = 'Today';
    var selectedSlotId = 'standard';
    var selectedSlotName = 'Standard Delivery · Free';
    var selectedSubslotWin = '';
    var eggPreference = '{% if is_cake %}With Egg{% endif %}';
    var cakeWeight = '{% if is_cake %}0.5 kg{% endif %}';

    // Preset messages dictionary
    var PRESET_MESSAGES = {
      'Birthday': [
        'Wishing you a day filled with laughter, love, and sweet treats! Happy Birthday!',
        'May this birthday bring you as much joy as you bring to everyone around you!',
        'Cheers to you on your special day! May your year ahead be full of prosperity and smiles.',
        'Another year older, wiser, and even more wonderful. Have the happiest birthday!'
      ],
      'Anniversary': [
        'Wishing a fabulous couple a lifetime of shared laughter and love. Happy Anniversary!',
        'Happy Anniversary to the one I want to annoy for the rest of my days. Love you always!',
        'May your beautiful love story continue to inspire everyone around you. Happy Anniversary!',
        'Celebrating another year of cherished memories and looking forward to many more.'
      ],
      'Love & Romance': [
        'Every single day with you is a gift I treasure. Sending all my love today and always.',
        'Just a gentle reminder of how deeply you are loved and cherished, today and forever.',
        'You make my world brighter and my heart fuller. Thinking of you always.',
        'To the one who holds my heart: thank you for making every ordinary day extraordinary.'
      ],
      'Congratulations': [
        'Heartiest congratulations on your magnificent achievement! Truly well deserved.',
        'So incredibly proud of your hard work and success! Wishing you even greater heights.',
        'Big congratulations on this brilliant milestone! Celebrating your triumph today.',
        'Kudos to you! Your talent and dedication have yielded wonderful results.'
      ],
      'Thank You': [
        'Words cannot express how grateful I am for your kindness and support. Thank you!',
        'Thank you for being so wonderful, thoughtful, and generous. You made a huge difference.'
      ],
      'Get Well Soon': [
        'Sending warm wishes, lots of love, and gentle hugs for a speedy and complete recovery!',
        'Thinking of you and wishing you renewed strength and good health with each passing day.'
      ]
    };

    // Initialize immediately or on DOM load
    function initPdp() {
      initPincode();
      initDatesCarousel();
      initCutoffCountdown();
      updatePriceDisplay();
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPdp);
    } else {
      initPdp();
    }

    // Pincode setup & sync with localStorage
    function initPincode() {
      var saved = localStorage.getItem('flaberry_pincode') || '{{ section.settings.default_pincode | default: "110001" }}';
      var pinInp = document.getElementById('pdpPinInput');
      if (pinInp) {
        pinInp.value = saved;
        currentPincode = saved;
      }
    }

    window.flaberryCheckPdpPin = function() {
      var pinInp = document.getElementById('pdpPinInput');
      var notice = document.getElementById('pdpPinNotice');
      var noticeText = document.getElementById('pdpPinNoticeText');
      var pill = document.getElementById('pdpPinStatusPill');
      var pillText = document.getElementById('pdpPinPillText');
      var val = pinInp ? pinInp.value.trim() : '';

      if (!val || val.length !== 6 || !/^\d{6}$/.test(val)) {
        notice.className = 'notice warn';
        noticeText.innerHTML = 'Please enter a valid 6-digit Indian postal pincode.';
        pill.className = 'pill';
        pill.style.background = '#fde8e6';
        pill.style.color = '#c23e1b';
        pillText.textContent = 'Invalid PIN';
        return;
      }

      currentPincode = val;
      localStorage.setItem('flaberry_pincode', val);

      // Also sync with top pincode chip if exists
      var headerChip = document.getElementById('hdrPincodeText');
      if (headerChip) headerChip.textContent = val;

      notice.className = 'notice ok';
      noticeText.innerHTML = 'Available for delivery at <b>' + val + '</b>. Earliest delivery: <b>Today</b> with Midnight option.';
      pill.className = 'pill ok';
      pill.style.background = '#e9f8ef';
      pill.style.color = '#1f7a4d';
      pillText.textContent = 'Deliverable';
    };

    // Dynamic 14-day rolling window generator
    function initDatesCarousel() {
      var container = document.getElementById('pdpDatesContainer');
      var advInp = document.getElementById('pdpAdvDate');
      if (!container) return;

      var days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      var now = new Date();

      if (advInp) {
        var minIso = now.toISOString().split('T')[0];
        advInp.min = minIso;
        var maxD = new Date();
        maxD.setDate(maxD.getDate() + 90);
        advInp.max = maxD.toISOString().split('T')[0];
      }

      var html = '';
      for (var i = 0; i < 14; i++) {
        var d = new Date();
        d.setDate(now.getDate() + i);
        var dayLabel = (i === 0) ? 'Today' : (i === 1) ? 'Tomorrow' : days[d.getDay()];
        var dateNum = d.getDate();
        var monthLabel = months[d.getMonth()];
        var iso = d.toISOString().split('T')[0];
        var isSelected = (i === 0);

        if (isSelected) {
          selectedDateIso = iso;
          selectedDateText = 'Today, ' + dateNum + ' ' + monthLabel;
        }

        html += '<button type="button" class="date-btn ' + (isSelected ? 'on' : '') + '" data-iso="' + iso + '" data-text="' + dayLabel + ', ' + dateNum + ' ' + monthLabel + '" onclick="flaberrySelectDateBtn(this)">' +
          '<span>' + dayLabel + '</span>' +
          '<b>' + dateNum + '</b>' +
          '<span>' + monthLabel + '</span>' +
        '</button>';
      }

      container.innerHTML = html;
      updateCutoffVisibility();
    }

    window.flaberrySelectDateBtn = function(btn) {
      document.querySelectorAll('#pdpDatesContainer .date-btn').forEach(function(b) { b.classList.remove('on'); });
      btn.classList.add('on');
      selectedDateIso = btn.getAttribute('data-iso');
      selectedDateText = btn.getAttribute('data-text');
      var label = document.getElementById('pdpDateLabel');
      if (label) label.textContent = selectedDateText;

      var advInp = document.getElementById('pdpAdvDate');
      if (advInp) advInp.value = selectedDateIso;

      updateCutoffVisibility();
      updateSummaryText();
    };

    window.flaberryPickAdvDate = function(val) {
      if (!val) return;
      selectedDateIso = val;
      var d = new Date(val);
      var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      selectedDateText = d.getDate() + ' ' + months[d.getMonth()] + ' ' + d.getFullYear();
      
      var label = document.getElementById('pdpDateLabel');
      if (label) label.textContent = selectedDateText;

      document.querySelectorAll('#pdpDatesContainer .date-btn').forEach(function(b) {
        b.classList.toggle('on', b.getAttribute('data-iso') === val);
      });

      updateCutoffVisibility();
      updateSummaryText();
    };

    function updateCutoffVisibility() {
      var now = new Date();
      var todayIso = now.toISOString().split('T')[0];
      var cutoffNotice = document.getElementById('pdpCutoffNotice');
      var stdBtn = document.getElementById('slotBtnStandard');

      if (selectedDateIso === todayIso) {
        if (cutoffNotice) cutoffNotice.style.display = 'block';
        if (now.getHours() >= {{ section.settings.same_day_cutoff_hour | default: 16 }}) {
          if (stdBtn) {
            stdBtn.disabled = true;
            stdBtn.querySelector('.slot-time').textContent = 'Closed for today (Cut-off 4 PM)';
            if (selectedSlotId === 'standard') {
              var fixBtn = document.getElementById('slotBtnFixed');
              if (fixBtn) flaberryPickSlot(fixBtn, 'fixed', 15000, 'Fixed Time · ₹150');
            }
          }
        } else {
          if (stdBtn) {
            stdBtn.disabled = false;
            stdBtn.querySelector('.slot-time').textContent = '9:00 AM – 9:00 PM';
          }
        }
      } else {
        if (cutoffNotice) cutoffNotice.style.display = 'none';
        if (stdBtn) {
          stdBtn.disabled = false;
          stdBtn.querySelector('.slot-time').textContent = '9:00 AM – 9:00 PM';
        }
      }
    }

    function initCutoffCountdown() {
      function tick() {
        var now = new Date();
        var cutoff = new Date();
        cutoff.setHours({{ section.settings.same_day_cutoff_hour | default: 16 }}, 0, 0, 0);
        var diff = cutoff - now;
        var timerEl = document.getElementById('pdpCutoffTimer');
        if (!timerEl) return;
        if (diff <= 0) {
          timerEl.textContent = '0h 00m';
          updateCutoffVisibility();
        } else {
          var h = Math.floor(diff / (1000 * 60 * 60));
          var m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
          timerEl.textContent = h + 'h ' + (m < 10 ? '0' : '') + m + 'm';
        }
      }
      tick();
      setInterval(tick, 60000);
    }

    // Time Slot Selection
    window.flaberryPickSlot = function(btn, slotId, fee, slotName) {
      document.querySelectorAll('#pdpSlotsContainer .slot').forEach(function(s) { s.classList.remove('on'); });
      btn.classList.add('on');
      selectedSlotId = slotId;
      selectedSlotName = slotName;
      currentSlotFee = fee;

      var subRow = document.getElementById('pdpSubslotsRow');
      if (subRow) {
        subRow.style.display = (slotId === 'fixed') ? 'flex' : 'none';
        if (slotId === 'fixed' && !selectedSubslotWin) {
          var firstChip = subRow.querySelector('.chip');
          if (firstChip) selectedSubslotWin = firstChip.textContent;
        }
      }

      updatePriceDisplay();
      updateSummaryText();
    };

    window.flaberryPickWin = function(btn, win) {
      document.querySelectorAll('#pdpSubslotsRow .chip').forEach(function(c) { c.classList.remove('on'); });
      btn.classList.add('on');
      selectedSubslotWin = win;
      updateSummaryText();
    };

    // Cake Options
    window.flaberrySetEgg = function(btn, egg) {
      document.querySelectorAll('#pdpEggRow .chip').forEach(function(c) { c.classList.remove('on'); });
      btn.classList.add('on');
      eggPreference = egg;
    };

    window.flaberrySetWeight = function(btn, wt, fee) {
      document.querySelectorAll('#pdpWeightRow .chip').forEach(function(c) { c.classList.remove('on'); });
      btn.classList.add('on');
      cakeWeight = wt;
      currentWeightFee = fee;
      updatePriceDisplay();
    };

    // Occasion & Greeting Card
    window.flaberrySelectOccasion = function(occ) {
      var chipsBox = document.getElementById('pdpReadyChips');
      if (!chipsBox) return;

      if (!occ || !PRESET_MESSAGES[occ]) {
        chipsBox.style.display = 'none';
        chipsBox.innerHTML = '';
        return;
      }

      var msgs = PRESET_MESSAGES[occ];
      var html = '';
      msgs.forEach(function(m) {
        html += '<button type="button" class="ready-chip-btn" onclick="flaberryApplyPresetMsg(this)">' + m + '</button>';
      });
      chipsBox.innerHTML = html;
      chipsBox.style.display = 'grid';
    };

    window.flaberryApplyPresetMsg = function(btn) {
      var tx = document.getElementById('pdpCardMessage');
      if (tx) {
        tx.value = btn.textContent;
        flaberryUpdateMsgCounter(tx);
      }
    };

    window.flaberryUpdateMsgCounter = function(tx) {
      var counter = document.getElementById('pdpMsgCounter');
      if (counter) counter.textContent = tx.value.length;
    };

    // Add-on Upsells
    window.flaberryToggleAddon = function(btn) {
      btn.classList.toggle('on');
      var ck = btn.querySelector('.ck');
      var isPressed = btn.classList.contains('on');
      btn.setAttribute('aria-pressed', isPressed ? 'true' : 'false');
      if (ck) ck.textContent = isPressed ? '✓' : '+';

      // Re-sum active add-ons
      var sum = 0;
      document.querySelectorAll('#pdpAddonsGrid .addon.on').forEach(function(el) {
        var price = parseInt(el.getAttribute('data-addon-price') || '0', 10);
        sum += price * 100; // convert to cents
      });
      currentAddonSum = sum;
      updatePriceDisplay();
    };

    // Quantity Stepper
    window.flaberryChangeQty = function(delta) {
      currentQty = Math.max(1, currentQty + delta);
      var qtyEl = document.getElementById('pdpQtyVal');
      if (qtyEl) qtyEl.textContent = currentQty;
      updatePriceDisplay();
    };

    // Variant Selection
    window.flaberrySelectVariant = function(btn) {
      document.querySelectorAll('.variant-box .chip').forEach(function(c) { c.classList.remove('on'); });
      btn.classList.add('on');
      var varId = btn.getAttribute('data-variant-id');
      var price = parseInt(btn.getAttribute('data-variant-price') || '0', 10);
      var compare = parseInt(btn.getAttribute('data-variant-compare') || '0', 10);
      var sku = btn.getAttribute('data-variant-sku');

      document.getElementById('pdpVariantId').value = varId;
      basePriceInCents = price;
      currentVariantPrice = price;

      var skuEl = document.getElementById('pdpSkuVal');
      if (skuEl && sku) skuEl.textContent = sku;

      var compEl = document.getElementById('pdpCompareVal');
      if (compEl) {
        if (compare > price) {
          compEl.style.display = 'inline';
          var sym = (window.FlaberryShop && window.FlaberryShop.currencySymbol) || '{{ cart.currency.symbol | default: "₹" }}';
          compEl.textContent = sym + ((compare / 100) >= 100 ? Math.round(compare / 100).toLocaleString() : (compare / 100).toFixed(2));
        } else {
          compEl.style.display = 'none';
        }
      }
      updatePriceDisplay();
    };

    // Live Price Updates
    function updatePriceDisplay() {
      var itemTotal = (currentVariantPrice + currentWeightFee + currentSlotFee + currentAddonSum) * currentQty;
      var sym = (window.FlaberryShop && window.FlaberryShop.currencySymbol) || '{{ cart.currency.symbol | default: "₹" }}';
      var val = (itemTotal / 100);
      var formatted = sym + (val >= 100 ? Math.round(val).toLocaleString() : val.toFixed(2));

      var priceEl = document.getElementById('pdpPriceVal');
      if (priceEl) {
        priceEl.textContent = formatted;
        priceEl.setAttribute('data-inr', (itemTotal / 100).toFixed(2));
      }

      var stickyPriceEl = document.getElementById('stickyPriceVal');
      if (stickyPriceEl) {
        stickyPriceEl.textContent = formatted;
        stickyPriceEl.setAttribute('data-inr', (itemTotal / 100).toFixed(2));
      }
    }

    function updateSummaryText() {
      var summaryEl = document.getElementById('stickyDateSlotSummary');
      if (summaryEl) {
        var str = 'Delivery: ' + selectedDateText + ' (' + selectedSlotName.split('·')[0].trim();
        if (selectedSlotId === 'fixed' && selectedSubslotWin) {
          str += ' · ' + selectedSubslotWin;
        }
        str += ')';
        summaryEl.textContent = str;
      }
    }

    // Media Switcher
    window.flaberrySwitchPdpMedia = function(url, btn) {
      var mainImg = document.getElementById('pdpMainImg');
      if (mainImg) {
        mainImg.style.opacity = '0.3';
        setTimeout(function() {
          mainImg.src = url;
          mainImg.style.opacity = '1';
        }, 120);
      }
      document.querySelectorAll('#pdpThumbnails .thumb-btn').forEach(function(b) { b.classList.remove('on'); });
      btn.classList.add('on');
    };

    window.flaberryPlayPdpVideo = function() {
      alert('Playing 360° product video preview.');
    };

    // 4 Information Tabs Switcher
    window.flaberrySwitchTab = function(idx) {
      document.querySelectorAll('.pdp-tab-btn').forEach(function(b, i) {
        var isActive = (i === idx);
        b.classList.toggle('on', isActive);
        b.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      document.querySelectorAll('.pdp-tabpane').forEach(function(p, i) {
        p.classList.toggle('on', i === idx);
      });
    };

    // AJAX Add to Cart & Buy Now Flow
    window.flaberrySubmitPdpOrder = function(isBuyNow) {
      var pinInp = document.getElementById('pdpPinInput');
      var pin = pinInp ? pinInp.value.trim() : '';

      if (!pin || pin.length !== 6 || !/^\d{6}$/.test(pin)) {
        if (pinInp) {
          pinInp.focus();
          pinInp.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        alert('Please enter a valid 6-digit receiver pincode to schedule delivery.');
        return;
      }

      var btn = isBuyNow ? document.getElementById('pdpBuyNowBtn') : document.getElementById('pdpAddCartBtn');
      var origText = btn.textContent;
      btn.disabled = true;
      btn.textContent = isBuyNow ? 'Proceeding...' : 'Adding...';

      // Line item properties
      var slotFull = selectedSlotName;
      if (selectedSlotId === 'fixed' && selectedSubslotWin) {
        slotFull += ' (' + selectedSubslotWin + ')';
      }

      var props = {
        'Delivery Pincode': pin,
        'Delivery Date': selectedDateText,
        'Delivery Time Slot': slotFull
      };

      var recName = document.getElementById('pdpRecipientName') ? document.getElementById('pdpRecipientName').value.trim() : '';
      if (recName) props['Recipient Name'] = recName;

      var recPhone = document.getElementById('pdpRecipientPhone') ? document.getElementById('pdpRecipientPhone').value.trim() : '';
      if (recPhone) props['Recipient Phone'] = recPhone;

      var occ = document.getElementById('pdpOccasion') ? document.getElementById('pdpOccasion').value : '';
      if (occ) props['Occasion'] = occ;

      var msg = document.getElementById('pdpCardMessage') ? document.getElementById('pdpCardMessage').value.trim() : '';
      if (msg) props['Greeting Message'] = msg;

      var sender = document.getElementById('pdpSenderName') ? document.getElementById('pdpSenderName').value.trim() : '';
      if (sender) props['From'] = sender;

      var cakeMsg = document.getElementById('pdpCakeMessage') ? document.getElementById('pdpCakeMessage').value.trim() : '';
      if (cakeMsg) props['Message on Cake'] = cakeMsg;

      if (eggPreference) props['Egg Preference'] = eggPreference;
      if (cakeWeight) props['Weight'] = cakeWeight;

      var selectedAddons = [];
      document.querySelectorAll('#pdpAddonsGrid .addon.on').forEach(function(el) {
        selectedAddons.push(el.getAttribute('data-addon-title') + ' (₹' + el.getAttribute('data-addon-price') + ')');
      });
      if (selectedAddons.length > 0) {
        props['Add-ons'] = selectedAddons.join(', ');
      }

      // Prepare order-level note and note_attributes so they display prominently in Shopify Admin
      var noteParts = [
        'Delivery Date: ' + selectedDateText,
        'Time Slot: ' + slotFull,
        'Pincode: ' + pin
      ];
      if (recName) noteParts.push('Recipient: ' + recName + (recPhone ? ' (' + recPhone + ')' : ''));
      if (sender) noteParts.push('From: ' + sender);
      if (occ) noteParts.push('Occasion: ' + occ);
      if (msg) noteParts.push('Message: ' + msg);
      if (cakeMsg) noteParts.push('Cake Message: ' + cakeMsg);
      if (eggPreference) noteParts.push('Egg: ' + eggPreference);
      if (cakeWeight) noteParts.push('Weight: ' + cakeWeight);
      if (selectedAddons.length > 0) noteParts.push('Add-ons: ' + selectedAddons.join(', '));

      var noteString = noteParts.join(' | ');

      var orderAttributes = {
        'Delivery Date': selectedDateText,
        'Delivery Time Slot': slotFull,
        'Delivery Pincode': pin
      };
      if (recName) orderAttributes['Recipient Name'] = recName;
      if (recPhone) orderAttributes['Recipient Phone'] = recPhone;
      if (sender) orderAttributes['From'] = sender;
      if (occ) orderAttributes['Occasion'] = occ;
      if (msg) orderAttributes['Greeting Message'] = msg;
      if (cakeMsg) orderAttributes['Message on Cake'] = cakeMsg;
      if (eggPreference) orderAttributes['Egg Preference'] = eggPreference;
      if (cakeWeight) orderAttributes['Weight'] = cakeWeight;
      if (selectedAddons.length > 0) orderAttributes['Add-ons'] = selectedAddons.join(', ');

      var varIdEl = document.getElementById('pdpVariantId');
      var varId = (varIdEl && varIdEl.value) ? varIdEl.value : '{{ current_variant.id }}';
      if (!varId || isNaN(parseInt(varId, 10))) {
        varId = '{{ current_variant.id }}';
      }

      var cartItems = [
        {
          id: parseInt(varId, 10),
          quantity: currentQty || 1,
          properties: props
        }
      ];

      // Add linked addon products to the cart items payload if available
      document.querySelectorAll('#pdpAddonsGrid .addon.on').forEach(function(el) {
        var aVarId = el.getAttribute('data-addon-variant-id');
        if (aVarId && parseInt(aVarId, 10) > 0) {
          cartItems.push({
            id: parseInt(aVarId, 10),
            quantity: 1,
            properties: {
              '_addon_for': '{{ prod_title | escape }}'
            }
          });
        }
      });

      var addPayload = (cartItems.length > 1)
        ? { items: cartItems }
        : { id: parseInt(varId, 10), quantity: currentQty || 1, properties: props };

      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(addPayload)
      })
      .then(function(res) {
        return res.json().then(function(data) {
          if (!res.ok) {
            throw new Error(data.description || data.message || 'Error adding to cart');
          }
          return data;
        });
      })
      .then(function(item) {
        // Sync Order Note and Note Attributes so they show in Shopify Admin sidebar & notifications
        return fetch('/cart/update.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            note: noteString,
            attributes: orderAttributes
          })
        }).then(function() { return item; }).catch(function() { return item; });
      })
      .then(function(item) {
        if (btn) {
          btn.disabled = false;
          btn.textContent = origText;
        }

        if (isBuyNow) {
          window.location.href = '/checkout';
        } else {
          // Open Slide Cart Drawer via custom Ajax Engine
          if (window.flaberryRefreshCartDrawer) {
            window.flaberryRefreshCartDrawer(true);
          } else if (window.flaberryOpenCartDrawer) {
            window.flaberryOpenCartDrawer();
          }

          // Direct DOM activation guarantee
          var cd = document.getElementById('cartdrawer');
          var sc = document.getElementById('scrim');
          if (cd) {
            cd.classList.add('on');
            cd.setAttribute('aria-hidden', 'false');
          }
          if (sc) {
            sc.classList.add('on');
          }

          // Update header & dock cart badges
          fetch('/cart.js')
          .then(function(r) { return r.json(); })
          .then(function(c) {
            var badge = document.getElementById('hdrCartBadge');
            if (badge) {
              badge.textContent = c.item_count;
              badge.hidden = (c.item_count === 0);
            }
            var dockBadge = document.getElementById('dockbadge');
            if (dockBadge) {
              dockBadge.textContent = c.item_count;
              dockBadge.hidden = (c.item_count === 0);
            }
          });
        }
      })
      .catch(function(err) {
        if (btn) {
          btn.disabled = false;
          btn.textContent = origText;
        }
        console.error('Cart submission error:', err);
        alert('Could not add to cart: ' + err.message);
      });
    };

    // Review Handlers (Integrated directly with Official Judge.me Widget)
    window.flaberryTriggerJudgeMeWriteReview = function() {
      var jmWriteLink = document.querySelector('.jdgm-write-rev-link, .jdgm-write-review-btn, .jdgm-widget.jdgm-review-widget .jdgm-btn');
      if (jmWriteLink) {
        jmWriteLink.click();
        jmWriteLink.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      var jmWidget = document.getElementById('judgeme_product_reviews');
      if (jmWidget) {
        jmWidget.scrollIntoView({ behavior: 'smooth', block: 'center' });
        var btn = jmWidget.querySelector('.jdgm-btn, a, button');
        if (btn) btn.click();
      }
    };
    window.flaberryOpenReviewModal = window.flaberryTriggerJudgeMeWriteReview;
  })();
</script>

