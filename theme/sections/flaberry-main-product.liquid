{% comment %}
  Flaberry Main Product Detail Page (PDP)
  Source of Truth: reference/Flaberry_Design1_Classic.html (.pdp, .gallery, .pinfo, .dates, .slots, .addons, .tabs, .sticky-buy)
  Master CRO Implementation:
  - 2-column layout on desktop, strictly non-sticky gallery on mobile (position: static !important; top: auto !important;)
  - Dynamic media gallery with thumbnails + hover/click zoom
  - Pincode deliverability checker synced bi-directionally with localStorage.flaberry_pincode
  - Dynamic 14-day rolling date picker + 90-day advance date picker
  - Time slots: Standard (Free), Fixed Time (₹150, 1-hr subslots), Midnight (₹250), Early Morning (₹200) with live cutoff countdown
  - Cake options (Eggless / With Egg, weights)
  - Complimentary greeting message card builder with occasion chips, 250-char counter, sender name, cake message
  - Add-on upsells with dynamic selection and line-item properties
  - AJAX /cart/add.js submission updating cart drawer + instant 'Buy Now' to checkout
  - 4 Tabs: Description, Specifications, Delivery information, Care instructions dynamically connected to product.metafields.flaberry.* with intelligent fallbacks
  - Ratings & verified customer reviews summary block (#rv)
  - Mobile sticky buy bar (.sticky-buy) docked above bottom navigation
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_img = product.featured_media | default: product.featured_image
  assign prod_title = product.title | default: 'Posh Pink Enchantment'
  assign prod_sku = current_variant.sku | default: product.metafields.flaberry.sku.value | default: 'FB-' | append: product.id
  assign prod_price = current_variant.price | default: 244000
  assign prod_compare = current_variant.compare_at_price | default: 0
  assign prod_type_lower = product.type | downcase
  assign prod_title_lower = product.title | downcase

  assign is_cake = false
  if prod_type_lower contains 'cake' or prod_title_lower contains 'cake' or product.tags contains 'cake' or product.tags contains 'Cakes' or section.settings.force_cake_options
    assign is_cake = true
  endif

  assign rating_val = product.metafields.flaberry.rating.value | default: product.metafields.reviews.rating.value.rating | default: 4.8
  assign reviews_count = product.metafields.flaberry.reviews_count.value | default: product.metafields.reviews.rating_count | default: 142
  assign badge_tag = product.metafields.flaberry.badge.value | default: product.metafields.custom.badge.value
  if badge_tag == blank
    if product.tags contains 'Bestseller'
      assign badge_tag = 'Bestseller'
    elsif product.tags contains 'Deal' or product.tags contains 'Sale'
      assign badge_tag = 'Deal'
    elsif product.tags contains 'Premium'
      assign badge_tag = 'Premium'
    elsif product.tags contains 'Eggless'
      assign badge_tag = 'Eggless'
    else
      assign badge_tag = 'Handcrafted'
    endif
  endif

  assign primary_collection = product.collections.first
-%}

<div class="flaberry-pdp-section" data-section-id="{{ section.id }}">
  <div class="wrap">
    <!-- Breadcrumbs -->
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      {% if primary_collection != blank %}
        <a href="{{ primary_collection.url }}">{{ primary_collection.title }}</a>
        <span>/</span>
      {% else %}
        <a href="/collections/all">{% if is_cake %}Cakes{% else %}Flowers{% endif %}</a>
        <span>/</span>
      {% endif %}
      <span class="active">{{ prod_title }}</span>
    </nav>

    <!-- Master 2-Column PDP Grid -->
    <div class="pdp">
      <!-- Left Column: Gallery (Strictly static on mobile <= 960px) -->
      <div class="gallery" id="flaberryPdpGallery">
        <div class="thumbs" id="pdpThumbnails" role="tablist" aria-label="Product thumbnails">
          {% if product.media.size > 0 %}
            {% for media in product.media limit: 6 %}
              <button 
                type="button" 
                class="thumb-btn {% if forloop.first %}on{% endif %}" 
                onclick="flaberrySwitchPdpMedia('{{ media | image_url: width: 1000, height: 1000 }}', this)"
                aria-label="Thumbnail {{ forloop.index }}"
              >
                <img src="{{ media | image_url: width: 160, height: 160 }}" alt="{{ media.alt | default: prod_title | escape }}" width="80" height="80" loading="lazy">
              </button>
            {% endfor %}
          {% else %}
            {% assign f_rose = 'hero_flowers.webp' | file_url %}
            {% assign f_rose2 = 'hx_roses.webp' | file_url %}
            {% assign f_heart = 'hx_heartbox.webp' | file_url %}
            {% assign f_box = 'hx_mixbox.webp' | file_url %}
            <button type="button" class="thumb-btn on" onclick="flaberrySwitchPdpMedia('{{ f_rose }}', this)" aria-label="Thumbnail 1"><img src="{{ f_rose }}" alt="Thumbnail 1" width="80" height="80" loading="lazy"></button>
            <button type="button" class="thumb-btn" onclick="flaberrySwitchPdpMedia('{{ f_rose2 }}', this)" aria-label="Thumbnail 2"><img src="{{ f_rose2 }}" alt="Thumbnail 2" width="80" height="80" loading="lazy"></button>
            <button type="button" class="thumb-btn" onclick="flaberrySwitchPdpMedia('{{ f_heart }}', this)" aria-label="Thumbnail 3"><img src="{{ f_heart }}" alt="Thumbnail 3" width="80" height="80" loading="lazy"></button>
            <button type="button" class="thumb-btn" onclick="flaberrySwitchPdpMedia('{{ f_box }}', this)" aria-label="Thumbnail 4"><img src="{{ f_box }}" alt="Thumbnail 4" width="80" height="80" loading="lazy"></button>
          {% endif %}
          <button type="button" class="thumb-btn vid-btn" onclick="flaberryPlayPdpVideo()" aria-label="Play 360 preview video">
            <div class="vid-overlay">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            </div>
          </button>
        </div>

        <div class="mainimg" id="mainimg" onclick="this.classList.toggle('zoom')" title="Click to zoom">
          {% if featured_img != blank %}
            <img id="pdpMainImg" src="{{ featured_img | image_url: width: 1000, height: 1000 }}" alt="{{ prod_title | escape }}" width="600" height="600">
          {% else %}
            <img id="pdpMainImg" src="{{ 'hero_flowers.webp' | file_url }}" alt="{{ prod_title | escape }}" width="600" height="600">
          {% endif %}
          {% if badge_tag != blank %}
            <span class="pdp-deal-tag">{{ badge_tag }}</span>
          {% endif %}
        </div>
      </div>

      <!-- Right Column: Product Information & Interactive Purchase Form -->
      <div class="pinfo">
        <!-- SKU, Title & Ratings Summary -->
        <div class="pinfo-header">
          <span class="muted" style="font-size: 13px;">Item code: <b id="pdpSkuVal">{{ prod_sku }}</b></span>
          <h1 class="pdp-title">{{ prod_title }}</h1>
          <div class="pdp-meta-row">
            <!-- Judge.me Preview Badge -->
            <div style='{{ jm_style }}' class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}'>
              {{ product.metafields.judgeme.badge }}
            </div>
            {%- assign has_jdgm_revs = false -%}
            {%- if product.metafields.judgeme.badge != blank and product.metafields.judgeme.badge contains 'jdgm-prev-badge__text' -%}
              {%- unless product.metafields.judgeme.badge contains '0 reviews' -%}
                {%- assign has_jdgm_revs = true -%}
              {%- endunless -%}
            {%- endif -%}
            {%- unless has_jdgm_revs -%}
              <span class="rate pdp-fallback-rate">{{ rating_val }} ★</span>
              <a href="#rv" class="muted pdp-fallback-revs" style="font-size: 13.5px; text-decoration: underline;">{{ reviews_count }} reviews</a>
            {%- endunless -%}
            <span class="pill info">{{ badge_tag }}</span>
          </div>

          <!-- Webkul MultiVendor Partner Seller Attribution -->
          {% if product.vendor != blank and product.vendor != shop.name %}
            <div class="pdp-vendor-info" style="margin-top: 8px; font-size: 13px; color: var(--ink, #1e1b4b); display: flex; align-items: center; gap: 6px;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <span>Sold &amp; handcrafted by: <a href="{{ routes.collections_url }}/vendors?q={{ product.vendor | url_param_escape }}" style="font-weight: 600; text-decoration: underline; color: var(--flora-deep, #ad1f2b);">{{ product.vendor }}</a></span>
              <span class="pill info" style="font-size: 11px; padding: 2px 7px;">Verified Florist</span>
            </div>
          {% endif %}
        </div>

        <!-- Big Price Display with Currency Support -->
        <div class="price-big">
          <b class="tab-nums flaberry-curr-target" id="pdpPriceVal" data-inr="{{ prod_price | divided_by: 100.0 }}">{{ prod_price | money }}</b>
          {% if prod_compare > prod_price %}
            <s class="muted flaberry-curr-target" id="pdpCompareVal" data-inr="{{ prod_compare | divided_by: 100.0 }}">{{ prod_compare | money }}</s>
            {% assign discount_pct = prod_compare | minus: prod_price | times: 100.0 | divided_by: prod_compare | round %}
            <span class="pill save-pill" id="pdpDiscountPill">{{ discount_pct }}% OFF</span>
          {% endif %}
          <div class="tax-note">Inclusive of all taxes · Free standard greeting card</div>
        </div>

        <!-- Hidden Shopify Form Inputs for AJAX Cart -->
        <input type="hidden" id="pdpVariantId" name="id" value="{{ current_variant.id }}">

        <!-- Multiple Variants Selector (if product has multiple options) -->
        {% if product.variants.size > 1 %}
          <div class="box variant-box">
            <h5>Select Option</h5>
            <div class="optrow">
              {% for variant in product.variants %}
                <button 
                  type="button" 
                  class="chip {% if variant.id == current_variant.id %}on{% endif %}"
                  data-variant-id="{{ variant.id }}"
                  data-variant-price="{{ variant.price }}"
                  data-variant-compare="{{ variant.compare_at_price | default: 0 }}"
                  data-variant-sku="{{ variant.sku | default: prod_sku }}"
                  onclick="flaberrySelectVariant(this)"
                >
                  {{ variant.title }} · {{ variant.price | money }}
                </button>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <!-- 1. Pincode Deliverability Checker -->
        <div class="box">
          <h5>
            Delivery pincode
            <span id="pdpPinStatusPill" class="pill ok"><span class="dot"></span><span id="pdpPinPillText">Deliverable</span></span>
          </h5>
          <form class="pinform" id="pdpPinForm" onsubmit="event.preventDefault(); flaberryCheckPdpPin();">
            <input 
              type="text" 
              class="inp" 
              id="pdpPinInput" 
              inputmode="numeric" 
              maxlength="6" 
              value="110001"
              placeholder="Receiver's 6-digit pincode" 
              aria-label="Delivery pincode"
            >
            <button type="submit" class="btn">Check</button>
          </form>
          <div id="pdpPinNotice" class="notice ok" style="margin-top: 10px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="vertical-align: -3px; margin-right: 4px;"><polyline points="20 6 9 17 4 12"/></svg>
            <span id="pdpPinNoticeText">Available for delivery. Earliest delivery: <b>Today</b> with Midnight slot option.</span>
          </div>
        </div>

        <!-- 2. Cake Customization Options (Conditional) -->
        {% if is_cake %}
          <div class="box cake-box">
            <h5>Choose your cake</h5>
            <div class="opt-label">Egg Preference</div>
            <div class="optrow" id="pdpEggRow">
              <button type="button" class="chip on" onclick="flaberrySetEgg(this, 'With Egg')">With Egg</button>
              <button type="button" class="chip" onclick="flaberrySetEgg(this, '100% Eggless')">100% Eggless</button>
            </div>

            <div class="opt-label" style="margin-top: 12px;">Select Weight</div>
            <div class="optrow" id="pdpWeightRow">
              <button type="button" class="chip on" onclick="flaberrySetWeight(this, '0.5 kg', 0)">1/2 kg · Standard</button>
              <button type="button" class="chip" onclick="flaberrySetWeight(this, '1 kg', 50000)">1 kg · +₹500</button>
              <button type="button" class="chip" onclick="flaberrySetWeight(this, '1.5 kg', 100000)">1.5 kg · +₹1,000</button>
              <button type="button" class="chip" onclick="flaberrySetWeight(this, '2 kg', 150000)">2 kg · +₹1,500</button>
            </div>
          </div>
        {% endif %}

        <!-- 3. Delivery Date & Time Slot Selector -->
        <div class="box">
          <h5>
            Delivery date
            <span class="muted" id="pdpDateLabel" style="font-weight: 600;">Today</span>
          </h5>
          <!-- 14-Day Rolling Dates Carousel -->
          <div class="dates" id="pdpDatesContainer" role="tablist" aria-label="Delivery dates">
            <!-- Dynamically populated by JS -->
          </div>

          <!-- Advance Date Picker -->
          <div class="adv-date-row">
            <label for="pdpAdvDate">Advance date</label>
            <input type="date" class="inp" id="pdpAdvDate" onchange="flaberryPickAdvDate(this.value)">
            <small class="muted">Book up to 90 days ahead.</small>
          </div>

          <!-- Delivery Time Slot Options -->
          <h5 style="margin-top: 18px; margin-bottom: 8px;">Delivery time</h5>
          <div class="slots" id="pdpSlotsContainer">
            <button type="button" class="slot on" id="slotBtnStandard" onclick="flaberryPickSlot(this, 'standard', 0, 'Standard Delivery · Free')">
              <b>Standard · Free</b>
              <span class="slot-time">9:00 AM – 9:00 PM</span>
            </button>
            <button type="button" class="slot" id="slotBtnFixed" onclick="flaberryPickSlot(this, 'fixed', 15000, 'Fixed Time · {{ 15000 | money }}')">
              <b>Fixed Time · {{ 15000 | money }}</b>
              <span class="slot-time">Choose 1-hour window</span>
            </button>
            <button type="button" class="slot" id="slotBtnMidnight" onclick="flaberryPickSlot(this, 'midnight', 25000, 'Midnight · {{ 25000 | money }}')">
              <b>Midnight · {{ 25000 | money }}</b>
              <span class="slot-time">11:00 PM – 12:30 AM</span>
            </button>
            <button type="button" class="slot" id="slotBtnEarly" onclick="flaberryPickSlot(this, 'early', 20000, 'Early Morning · {{ 20000 | money }}')">
              <b>Early Morning · {{ 20000 | money }}</b>
              <span class="slot-time">6:00 AM – 8:00 AM</span>
            </button>
          </div>

          <!-- Fixed Time 1-Hour Subslot Windows -->
          <div class="subslots" id="pdpSubslotsRow" style="display: none;">
            <button type="button" class="chip on" onclick="flaberryPickWin(this, '10:00 AM – 11:00 AM')">10:00 AM – 11:00 AM</button>
            <button type="button" class="chip" onclick="flaberryPickWin(this, '11:00 AM – 12:00 PM')">11:00 AM – 12:00 PM</button>
            <button type="button" class="chip" onclick="flaberryPickWin(this, '12:00 PM – 01:00 PM')">12:00 PM – 01:00 PM</button>
            <button type="button" class="chip" onclick="flaberryPickWin(this, '01:00 PM – 02:00 PM')">01:00 PM – 02:00 PM</button>
            <button type="button" class="chip" onclick="flaberryPickWin(this, '02:00 PM – 03:00 PM')">02:00 PM – 03:00 PM</button>
            <button type="button" class="chip" onclick="flaberryPickWin(this, '04:00 PM – 05:00 PM')">04:00 PM – 05:00 PM</button>
            <button type="button" class="chip" onclick="flaberryPickWin(this, '06:00 PM – 07:00 PM')">06:00 PM – 07:00 PM</button>
            <button type="button" class="chip" onclick="flaberryPickWin(this, '08:00 PM – 09:00 PM')">08:00 PM – 09:00 PM</button>
          </div>

          <!-- Cutoff Notice with Live Countdown -->
          <div class="notice info" id="pdpCutoffNotice" style="margin-top: 12px;">
            Order within <b id="pdpCutoffTimer">--h --m</b> for today's standard delivery.
          </div>
        </div>

        <!-- 4. Complimentary Greeting Message Card -->
        <div class="box">
          <h5>
            Message card
            <span class="muted" style="font-weight: 500;">Printed & placed with gift</span>
          </h5>
          <div class="field" style="margin-bottom: 10px;">
            <label for="pdpOccasion" style="font-size: 13px; font-weight: 600;">Occasion</label>
            <select class="inp" id="pdpOccasion" onchange="flaberrySelectOccasion(this.value)">
              <option value="">Choose occasion for ready messages</option>
              <option value="Birthday">Birthday</option>
              <option value="Anniversary">Anniversary</option>
              <option value="Love & Romance">Love & Romance</option>
              <option value="Congratulations">Congratulations</option>
              <option value="Thank You">Thank You</option>
              <option value="Get Well Soon">Get Well Soon</option>
            </select>
          </div>

          <!-- Ready Message Chips Container -->
          <div class="ready-chips-container" id="pdpReadyChips" style="display: none;"></div>

          <div class="field" style="margin-top: 10px;">
            <label for="pdpCardMessage" style="font-size: 13px; font-weight: 600;">Your Message</label>
            <textarea class="inp" id="pdpCardMessage" maxlength="250" placeholder="Write your personalized message here..." oninput="flaberryUpdateMsgCounter(this)"></textarea>
            <div class="counter"><span id="pdpMsgCounter">0</span>/250</div>
          </div>

          <div class="row2">
            <div class="field">
              <label for="pdpSenderName" style="font-size: 13px; font-weight: 600;">From (Name on card)</label>
              <input type="text" class="inp" id="pdpSenderName" placeholder="Your name">
            </div>
            {% if is_cake %}
              <div class="field">
                <label for="pdpCakeMessage" style="font-size: 13px; font-weight: 600;">Message on Cake (Max 30 chars)</label>
                <input type="text" class="inp" id="pdpCakeMessage" maxlength="30" placeholder="e.g. Happy Birthday Riya">
              </div>
            {% endif %}
          </div>

          <div class="row2" style="margin-top: 10px;">
            <div class="field">
              <label for="pdpRecipientName" style="font-size: 13px; font-weight: 600;">To (Recipient's name)</label>
              <input type="text" class="inp" id="pdpRecipientName" placeholder="Receiver / Recipient's name">
            </div>
            <div class="field">
              <label for="pdpRecipientPhone" style="font-size: 13px; font-weight: 600;">Recipient's Mobile (Optional)</label>
              <input type="tel" class="inp" id="pdpRecipientPhone" placeholder="For doorstep delivery coordination">
            </div>
          </div>
        </div>

        <!-- 5. Add-on Upsells -->
        <div class="box">
          <h5>
            Make it extra special
            <span class="muted" style="font-weight: 500;">Add-ons</span>
          </h5>
          <div class="addons" id="pdpAddonsGrid">
            {% if section.blocks.size > 0 %}
              {% for block in section.blocks %}
                {% assign add_img = block.settings.image_asset | file_url %}
                {% if block.settings.custom_image != blank %}
                  {% assign add_img = block.settings.custom_image | image_url: width: 200, height: 200 %}
                {% endif %}
                {% assign addon_prod = block.settings.product %}
                {% assign addon_var_id = '' %}
                {% if addon_prod != blank and addon_prod.available %}
                  {% assign addon_var_id = addon_prod.selected_or_first_available_variant.id %}
                {% endif %}
                <button 
                  type="button" 
                  class="addon" 
                  data-addon-title="{{ block.settings.title }}"
                  data-addon-price="{{ block.settings.price }}"
                  {% if addon_var_id != blank %}data-addon-variant-id="{{ addon_var_id }}"{% endif %}
                  onclick="flaberryToggleAddon(this)"
                  aria-pressed="false"
                >
                  <span class="ck">+</span>
                  <img src="{{ add_img }}" alt="{{ block.settings.title }}" width="64" height="64" loading="lazy">
                  <span class="addon-name">{{ block.settings.title }}</span>
                  {% assign addon_cents = block.settings.price | times: 100 %}
                  <b class="tab-nums">{{ addon_cents | money }}</b>
                </button>
              {% endfor %}
            {% else %}
              <!-- Prototype Curated Fallbacks -->
              <button type="button" class="addon" data-addon-title="Teddy Bear (6 inch)" data-addon-price="399" onclick="flaberryToggleAddon(this)">
                <span class="ck">+</span>
                <img src="{{ 'f_handcrafted.webp' | file_url }}" alt="Teddy" width="64" height="64" loading="lazy">
                <span class="addon-name">Teddy Bear (6 in)</span>
                <b class="tab-nums">{{ 39900 | money }}</b>
              </button>
              <button type="button" class="addon" data-addon-title="Ferrero Rocher (16 Pcs)" data-addon-price="599" onclick="flaberryToggleAddon(this)">
                <span class="ck">+</span>
                <img src="{{ 'hx_ferrero.webp' | file_url }}" alt="Ferrero" width="64" height="64" loading="lazy">
                <span class="addon-name">Ferrero Rocher (16pc)</span>
                <b class="tab-nums">{{ 59900 | money }}</b>
              </button>
              <button type="button" class="addon" data-addon-title="Cadbury Celebrations Box" data-addon-price="350" onclick="flaberryToggleAddon(this)">
                <span class="ck">+</span>
                <img src="{{ 'hx_truffle.webp' | file_url }}" alt="Celebrations" width="64" height="64" loading="lazy">
                <span class="addon-name">Cadbury Celebrations</span>
                <b class="tab-nums">{{ 35000 | money }}</b>
              </button>
              <button type="button" class="addon" data-addon-title="Luxury Greeting Card" data-addon-price="99" onclick="flaberryToggleAddon(this)">
                <span class="ck">+</span>
                <img src="{{ 'hx_heartbox.webp' | file_url }}" alt="Card" width="64" height="64" loading="lazy">
                <span class="addon-name">Luxury Card</span>
                <b class="tab-nums">{{ 9900 | money }}</b>
              </button>
              <button type="button" class="addon" data-addon-title="Kaju Katli (250g)" data-addon-price="450" onclick="flaberryToggleAddon(this)">
                <span class="ck">+</span>
                <img src="{{ 'hx_dryfruit.webp' | file_url }}" alt="Sweets" width="64" height="64" loading="lazy">
                <span class="addon-name">Kaju Katli (250g)</span>
                <b class="tab-nums">{{ 45000 | money }}</b>
              </button>
              <button type="button" class="addon" data-addon-title="3 Red Roses Bouquet" data-addon-price="299" onclick="flaberryToggleAddon(this)">
                <span class="ck">+</span>
                <img src="{{ 'hx_roses.webp' | file_url }}" alt="Roses" width="64" height="64" loading="lazy">
                <span class="addon-name">3 Red Roses</span>
                <b class="tab-nums">{{ 29900 | money }}</b>
              </button>
            {% endif %}
          </div>
        </div>

        <!-- 6. Quantity Stepper & Dual CTAs -->
        <div class="buyrow">
          <div class="qty" aria-label="Quantity selector">
            <button type="button" onclick="flaberryChangeQty(-1)" aria-label="Decrease quantity">−</button>
            <span id="pdpQtyVal">1</span>
            <button type="button" onclick="flaberryChangeQty(1)" aria-label="Increase quantity">+</button>
          </div>
          <button type="button" class="btn" id="pdpAddCartBtn" onclick="flaberrySubmitPdpOrder(false)">Add to cart</button>
          <button type="button" class="btn flora" id="pdpBuyNowBtn" onclick="flaberrySubmitPdpOrder(true)">Buy now</button>
        </div>

        <!-- Dual Trust Reassurance Strip -->
        <div class="trust" style="grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 24px;">
          <div class="trust-item">
            <img src="{{ 'i_secure.png' | file_url }}" alt="Secure Payments" width="36" height="36" loading="lazy">
            <span>
              <b>Secure payment</b>
              UPI, cards, net banking
            </span>
          </div>
          <div class="trust-item">
            <img src="{{ 'i_support.png' | file_url }}" alt="Support" width="36" height="36" loading="lazy">
            <span>
              <b>Help 8 AM – midnight</b>
              Phone, WhatsApp, email
            </span>
          </div>
        </div>

        <!-- 7. Four Information Tabs (Metafield connected with prototype fallbacks) -->
        <div class="pdp-tabs-wrapper">
          <div class="tabs" role="tablist">
            <button type="button" class="pdp-tab-btn on" onclick="flaberrySwitchTab(0)" role="tab" aria-selected="true">Description</button>
            <button type="button" class="pdp-tab-btn" onclick="flaberrySwitchTab(1)" role="tab" aria-selected="false">Specifications</button>
            <button type="button" class="pdp-tab-btn" onclick="flaberrySwitchTab(2)" role="tab" aria-selected="false">Delivery information</button>
            <button type="button" class="pdp-tab-btn" onclick="flaberrySwitchTab(3)" role="tab" aria-selected="false">Care instructions</button>
          </div>

          <!-- Tab Pane 0: Description -->
          <div class="tabpane pdp-tabpane on" id="tabPane0">
            {% if product.description != blank %}
              <div class="pdp-desc-content">{{ product.description }}</div>
            {% else %}
              <p>
                <strong>{{ prod_title }}</strong> is 
                {% if is_cake %}
                  baked fresh on the day of delivery by our certified partner bakers using pure ingredients and delivered with your printed personalized greeting card.
                {% else %}
                  handcrafted with love by expert florists using fresh morning-harvested blooms, lush green foliage, and delivered in signature Flaberry packaging with your printed message card.
                {% endif %}
              </p>
              <ul class="flaberry-info-list">
                <li>{% if is_cake %}Choose between 100% Eggless or With Egg, in sizes from 1/2 kg to 2 kg.{% else %}Flowers are sourced fresh at dawn to guarantee lasting vibrancy and natural scent.{% endif %}</li>
                <li>Same-day, fixed-time, and midnight surprise delivery available across 500+ Indian cities.</li>
                <li>Photographs are indicative; natural variations in blooms and handcrafted designs make each delivery unique.</li>
              </ul>
            {% endif %}
          </div>

          <!-- Tab Pane 1: Specifications (Metafield connected) -->
          <div class="tabpane pdp-tabpane" id="tabPane1">
            {%- liquid
              assign spec_meta = product.metafields.flaberry.specifications.value | default: product.metafields.custom.specifications.value
            -%}
            {% if spec_meta != blank %}
              <div class="metafield-specs">{{ spec_meta }}</div>
            {% else %}
              <table class="spec">
                <tbody>
                  <tr>
                    <td>Item code</td>
                    <td>{{ prod_sku }}</td>
                  </tr>
                  <tr>
                    <td>Category</td>
                    <td>{{ primary_collection.title | default: product.type | default: 'Flowers' }}</td>
                  </tr>
                  <tr>
                    <td>{% if is_cake %}Weight{% else %}Contents{% endif %}</td>
                    <td>{% if is_cake %}1/2 kg, 1 kg, 1.5 kg, 2 kg (Configured above){% else %}{{ prod_title }} (Premium Arrangement){% endif %}</td>
                  </tr>
                  <tr>
                    <td>Packaging</td>
                    <td>{% if is_cake %}Food-safe cake box with complimentary candle & knife{% else %}Eco-friendly luxury wrap with satin ribbon{% endif %}</td>
                  </tr>
                  <tr>
                    <td>Delivered by</td>
                    <td>Flaberry verified partner nearest to receiver's pincode</td>
                  </tr>
                </tbody>
              </table>
            {% endif %}
          </div>

          <!-- Tab Pane 2: Delivery information (Metafield connected) -->
          <div class="tabpane pdp-tabpane" id="tabPane2">
            {%- liquid
              assign deliv_meta = product.metafields.flaberry.delivery_info.value | default: product.metafields.custom.delivery_info.value
            -%}
            {% if deliv_meta != blank %}
              <div class="metafield-delivery">{{ deliv_meta }}</div>
            {% else %}
              <ul class="flaberry-info-list">
                <li><strong>Standard delivery:</strong> Between 9:00 AM and 9:00 PM on your selected date. Free across serviceable pincodes.</li>
                <li><strong>Fixed Time slots:</strong> Choose guaranteed 1-hour delivery windows for celebrations (nominal ₹150 slot fee).</li>
                <li><strong>Midnight delivery:</strong> Delivered sharp between 11:00 PM and 12:30 AM to ring in special occasions (₹250 slot fee).</li>
                <li><strong>Order Cutoffs:</strong> Same-day orders close at 4:00 PM IST; midnight delivery orders close at 9:00 PM IST.</li>
                <li><strong>Advance Booking:</strong> Schedule up to 90 days in advance with guaranteed date and time slots.</li>
                <li><strong>Handover Guarantee:</strong> The delivery associate contacts receiver before arrival for a seamless doorstep surprise.</li>
              </ul>
            {% endif %}
          </div>

          <!-- Tab Pane 3: Care instructions (Metafield connected) -->
          <div class="tabpane pdp-tabpane" id="tabPane3">
            {%- liquid
              assign care_meta = product.metafields.flaberry.care_instructions.value | default: product.metafields.custom.care_instructions.value
            -%}
            {% if care_meta != blank %}
              <div class="metafield-care">{{ care_meta }}</div>
            {% elsif is_cake %}
              <ul class="flaberry-info-list">
                <li>Refrigerate the cake immediately upon arrival (ideal temperature 2°C – 5°C).</li>
                <li>Remove from the refrigerator 20 minutes before serving to enjoy optimum creaminess and fluffy sponge texture.</li>
                <li>Store any leftover cake in an airtight container in the refrigerator and consume within 24–48 hours.</li>
                <li>Keep away from heat sources and direct sunlight.</li>
              </ul>
            {% else %}
              <ul class="flaberry-info-list">
                <li>Trim 1–2 cm off the bottom of stems at a 45-degree angle under running water.</li>
                <li>Place blooms in a clean vase filled with cold, fresh tap water and floral food if provided.</li>
                <li>Remove leaves that submerge below water level to prevent bacterial buildup and maintain water clarity.</li>
                <li>Change vase water every 2 days and recut stems slightly for long-lasting freshness.</li>
                <li>Keep arrangement away from direct sun, air conditioning vents, and ripening fruit baskets.</li>
              </ul>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <!-- Ratings & Customer Reviews Master Section (#rv) - Official Judge.me Reviews Module -->
    <section class="sec pdp-reviews-sec" id="rv" style="padding-top: 36px; border-top: 1px solid var(--fl-color-line, #ece7e3); margin-top: 40px;">
      <!-- Official Judge.me Product Review Widget -->
      <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}">
        {{ product.metafields.judgeme.widget }}
      </div>
    </section>
  </div>

  <!-- Mobile Sticky Buy Bar (Visible only on mobile <= 960px) -->
  <div class="sticky-buy" id="flaberryStickyBuy">
    <div>
      <b class="tab-nums flaberry-curr-target" id="stickyPriceVal" data-inr="{{ prod_price | divided_by: 100.0 }}">{{ prod_price | money }}</b>
      <small id="stickyDateSlotSummary">Delivery: Today (Standard)</small>
    </div>
    <button type="button" class="btn flora" onclick="flaberrySubmitPdpOrder(true)">Buy now</button>
  </div>
</div>

<style>
  /* ==========================================================
     Flaberry Product Detail Page Styles (Classic Master CRO)
     ========================================================== */
  .flaberry-pdp-section {
    background: var(--fl-color-paper, #ffffff);
    padding: 20px 0 60px;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--fl-color-muted, #6f6763);
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .crumbs a {
    color: var(--fl-color-muted, #6f6763);
    text-decoration: none;
    transition: color 0.15s;
  }
  .crumbs a:hover {
    color: var(--fl-color-ink, #151312);
  }
  .crumbs .active {
    color: var(--fl-color-ink, #151312);
    font-weight: 600;
  }

  /* Master 2-Column Grid */
  .pdp {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 44px;
    align-items: start;
  }

  /* Gallery Column */
  .gallery {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: 12px;
    position: sticky;
    top: 100px;
  }
  .thumbs {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .thumb-btn {
    border: 2px solid transparent;
    border-radius: 12px;
    overflow: hidden;
    padding: 0;
    background: var(--fl-color-mist, #f5f2f0);
    aspect-ratio: 1;
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .thumb-btn.on, .thumb-btn:hover {
    border-color: var(--fl-color-ink, #151312);
  }
  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vid-btn {
    position: relative;
    background: var(--fl-color-ink, #151312) !important;
  }
  .vid-overlay {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: #ffffff;
  }
  .mainimg {
    border-radius: var(--fl-radius-lg, 24px);
    overflow: hidden;
    background: var(--fl-color-mist, #f5f2f0);
    aspect-ratio: 1;
    position: relative;
    cursor: zoom-in;
  }
  .mainimg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .mainimg.zoom img {
    transform: scale(1.6);
  }
  .pdp-deal-tag {
    position: absolute;
    top: 14px;
    left: 14px;
    background: var(--fl-color-flora, #e2522c);
    color: #ffffff;
    font-size: 11.5px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--fl-radius-pill, 999px);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    pointer-events: none;
  }

  /* Right Column: Product Information */
  .pinfo {
    display: grid;
    gap: 16px;
  }
  .pinfo-header {
    display: grid;
    gap: 6px;
  }
  .pdp-title {
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 800;
    line-height: 1.2;
    margin: 4px 0;
    color: var(--fl-color-ink, #151312);
  }
  .pdp-meta-row {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .pdp-meta-row .jdgm-widget.jdgm-preview-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
  }
  .pdp-meta-row .jdgm-prev-badge__stars {
    color: #e59819;
    font-size: 15px;
  }
  .pdp-meta-row .jdgm-prev-badge__text {
    font-size: 13.5px;
    color: var(--muted, #5f6178);
    text-decoration: underline;
  }
  .pdp-meta-row:has(.jdgm-prev-badge[data-number-of-reviews]:not([data-number-of-reviews="0"])) .pdp-fallback-rate,
  .pdp-meta-row:has(.jdgm-prev-badge[data-number-of-reviews]:not([data-number-of-reviews="0"])) .pdp-fallback-revs {
    display: none !important;
  }
  #judgeme_product_reviews {
    margin-top: 10px;
    margin-bottom: 24px;
  }
  .rate {
    background: #f0a722;
    color: #ffffff;
    font-weight: 700;
    font-size: 12.5px;
    padding: 3px 8px;
    border-radius: 6px;
  }
  .pill.info {
    background: var(--fl-color-mist, #f5f2f0);
    color: var(--fl-color-ink, #151312);
    font-size: 12px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 6px;
  }
  .pill.ok {
    background: #e9f8ef;
    color: #1f7a4d;
    font-size: 12px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #1f7a4d;
  }
  .price-big {
    font-size: 30px;
    font-weight: 800;
    color: var(--fl-color-ink, #151312);
    margin: 6px 0 10px;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }
  .price-big s {
    font-size: 18px;
    color: var(--fl-color-muted, #6f6763);
    font-weight: 400;
  }
  .save-pill {
    background: #fde8e6;
    color: #c23e1b;
    font-size: 12px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 6px;
  }
  .tax-note {
    width: 100%;
    font-size: 12.5px;
    color: var(--fl-color-muted, #6f6763);
    font-weight: 400;
    margin-top: 2px;
  }

  /* Standard Module Boxes */
  .box {
    border: 1px solid var(--fl-color-line, #e7e1dd);
    border-radius: var(--fl-radius-md, 16px);
    padding: 16px 18px;
    background: #ffffff;
  }
  .box h5 {
    font-size: 14px;
    font-weight: 700;
    color: var(--fl-color-ink, #151312);
    margin: 0 0 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .opt-label {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--fl-color-muted, #6f6763);
    margin-bottom: 6px;
  }
  .pinform {
    display: flex;
    gap: 8px;
  }
  .inp {
    border: 1px solid var(--fl-color-line, #e7e1dd);
    border-radius: var(--fl-radius-pill, 999px);
    padding: 10px 16px;
    font-size: 14px;
    width: 100%;
    outline: none;
    font-family: inherit;
    box-sizing: border-box;
  }
  .inp:focus {
    border-color: var(--fl-color-ink, #151312);
  }
  textarea.inp {
    border-radius: 12px;
    min-height: 72px;
    resize: vertical;
  }
  .counter {
    font-size: 11px;
    color: var(--fl-color-muted, #6f6763);
    text-align: right;
    margin-top: 4px;
  }
  .notice {
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 13px;
    line-height: 1.4;
  }
  .notice.ok {
    background: #e9f8ef;
    color: #1f7a4d;
  }
  .notice.info {
    background: #eef1f8;
    color: #273a75;
  }
  .notice.warn {
    background: #fff8eb;
    color: #b54708;
  }
  .optrow {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .chip {
    padding: 8px 14px;
    border-radius: var(--fl-radius-pill, 999px);
    border: 1px solid var(--fl-color-line, #e7e1dd);
    background: #ffffff;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .chip.on, .chip:hover {
    background: var(--fl-color-ink, #151312);
    color: #ffffff;
    border-color: var(--fl-color-ink, #151312);
  }

  /* Dates Rolling Picker */
  .dates {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: thin;
    padding-bottom: 6px;
  }
  .date-btn {
    flex: 0 0 auto;
    border: 1px solid var(--fl-color-line, #e7e1dd);
    border-radius: 12px;
    background: #ffffff;
    padding: 8px 10px;
    min-width: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    cursor: pointer;
    text-align: center;
    transition: border-color 0.15s, background 0.15s;
  }
  .date-btn.on {
    border-color: var(--fl-color-flora, #e2522c);
    background: var(--fl-color-blush, #fde8e6);
  }
  .date-btn b {
    font-size: 17px;
    font-weight: 700;
    color: var(--fl-color-ink, #151312);
  }
  .date-btn span {
    font-size: 11px;
    color: var(--fl-color-muted, #6f6763);
  }
  .adv-date-row {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .adv-date-row label {
    font-size: 12.5px;
    font-weight: 600;
  }
  .adv-date-row input[type="date"] {
    width: auto;
    padding: 6px 12px;
  }

  /* Time Slots */
  .slots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .slot {
    border: 1px solid var(--fl-color-line, #e7e1dd);
    border-radius: 12px;
    padding: 10px 12px;
    background: #ffffff;
    text-align: left;
    display: grid;
    gap: 2px;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .slot b {
    font-size: 13.5px;
  }
  .slot .slot-time {
    font-size: 11px;
    color: var(--fl-color-muted, #6f6763);
  }
  .slot.on {
    border-color: var(--fl-color-ink, #151312);
    box-shadow: inset 0 0 0 1px var(--fl-color-ink, #151312);
  }
  .slot:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: #f7f7f7;
  }
  .subslots {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 8px;
    padding: 8px;
    background: var(--fl-color-mist, #f5f2f0);
    border-radius: 12px;
  }

  /* Ready Message Chips */
  .ready-chips-container {
    display: grid;
    gap: 6px;
    margin-bottom: 10px;
  }
  .ready-chip-btn {
    background: #ffffff;
    border: 1px dashed var(--fl-color-line, #e7e1dd);
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
    text-align: left;
    cursor: pointer;
    color: var(--fl-color-ink, #151312);
    line-height: 1.3;
    transition: border-color 0.15s, background 0.15s;
  }
  .ready-chip-btn:hover {
    border-color: var(--fl-color-flora, #e2522c);
    background: #fff9f8;
  }

  /* Add-on Upsells */
  .addons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .addon {
    border: 1px solid var(--fl-color-line, #e7e1dd);
    border-radius: 12px;
    padding: 8px;
    display: grid;
    gap: 4px;
    font-size: 12px;
    background: #ffffff;
    text-align: left;
    position: relative;
    cursor: pointer;
    transition: all 0.15s;
  }
  .addon.on {
    border-color: var(--fl-color-leaf, #1f7a4d);
    background: #f1faf4;
  }
  .addon .ck {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--fl-color-mist, #f5f2f0);
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 700;
  }
  .addon.on .ck {
    background: var(--fl-color-leaf, #1f7a4d);
    color: #ffffff;
  }
  .addon img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
  }
  .addon .addon-name {
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .addon b {
    font-size: 12.5px;
    color: var(--fl-color-ink, #151312);
  }

  /* Buy Row: Quantity Stepper & Buttons */
  .buyrow {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: 6px;
  }
  .qty {
    display: flex;
    align-items: center;
    border: 1px solid var(--fl-color-line, #e7e1dd);
    border-radius: var(--fl-radius-pill, 999px);
    overflow: hidden;
    background: #ffffff;
  }
  .qty button {
    background: none;
    border: none;
    padding: 10px 16px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
  }
  .qty span {
    padding: 0 10px;
    font-weight: 700;
    font-size: 15px;
    min-width: 24px;
    text-align: center;
  }
  .buyrow .btn {
    flex: 1;
    text-align: center;
    padding: 12px 20px;
    font-size: 15px;
  }
  .btn.flora {
    background: var(--fl-color-flora, #e2522c);
    border-color: var(--fl-color-flora, #e2522c);
    color: #ffffff;
  }
  .btn.flora:hover {
    background: var(--fl-color-flora-deep, #c23e1b);
    border-color: var(--fl-color-flora-deep, #c23e1b);
  }

  /* Dual Trust Strip */
  .trust {
    display: grid;
    gap: 12px;
  }
  .trust-item {
    display: flex;
    gap: 12px;
    align-items: center;
    background: var(--fl-color-mist, #f5f2f0);
    padding: 12px 14px;
    border-radius: var(--fl-radius-md, 16px);
  }
  .trust-item img {
    flex-shrink: 0;
  }
  .trust-item span b {
    display: block;
    font-size: 13.5px;
    color: var(--fl-color-ink, #151312);
  }
  .trust-item span {
    font-size: 12px;
    color: var(--fl-color-muted, #6f6763);
    line-height: 1.3;
  }

  /* 4 Information Tabs */
  .pdp-tabs-wrapper {
    margin-top: 14px;
  }
  .tabs {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--fl-color-line, #e7e1dd);
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .tabs button {
    background: none;
    border: 0;
    padding: 12px 16px;
    font-weight: 600;
    font-size: 14px;
    color: var(--fl-color-muted, #6f6763);
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
  }
  .tabs button.on {
    color: var(--fl-color-ink, #151312);
    border-bottom-color: var(--fl-color-ink, #151312);
  }
  .tabpane {
    display: none;
    padding: 16px 2px 6px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--fl-color-ink, #151312);
  }
  .tabpane.on {
    display: block;
  }
  .flaberry-info-list {
    margin: 8px 0 0 18px;
    padding: 0;
  }
  .flaberry-info-list li {
    margin-bottom: 6px;
    line-height: 1.5;
  }
  table.spec {
    width: 100%;
    border-collapse: collapse;
  }
  table.spec tr {
    border-bottom: 1px solid var(--fl-color-line, #e7e1dd);
  }
  table.spec tr:last-child {
    border-bottom: none;
  }
  table.spec td {
    padding: 10px 0;
    font-size: 13.5px;
  }
  table.spec td:first-child {
    color: var(--fl-color-muted, #6f6763);
