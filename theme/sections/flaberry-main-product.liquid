  /* Review Modal */
  .flaberry-review-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 16px;
  }
  .review-modal-scrim {
    position: absolute;
    inset: 0;
    background: rgba(21, 19, 18, 0.5);
  }
  .review-modal-box {
    position: relative;
    background: #ffffff;
    border-radius: var(--fl-radius-md, 16px);
    padding: 24px;
    width: 100%;
    max-width: 480px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    z-index: 1;
  }
  .review-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  .review-modal-header h3 {
