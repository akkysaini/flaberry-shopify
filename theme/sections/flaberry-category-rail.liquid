{% comment %}
  Flaberry Shop by Category Rail Section
  Source of Truth: reference/Flaberry_Design1_Classic.html
  - Horizontal wide category cards rail with 5 visible on desktop and 74% peeking on mobile.
  - Smooth native scroll with circular arrow buttons and touch-swipe support.
  - 100% customizable in Shopify Theme Customizer.
{% endcomment %}

<div class="fl-cat-rail-section" id="fl-cat-rail-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="fl-cat-container">
    <div class="fl-sec-header">
      <div>
        <h2 class="fl-sec-title">{{ section.settings.title | default: 'Shop by category' }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="fl-sec-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
      <div class="fl-arrow-btns">
        <button
          type="button"
          class="fl-rail-arrow"
          onclick="flaberryScrollCatRail('{{ section.id }}', -1)"
          aria-label="Previous categories"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </button>
        <button
          type="button"
          class="fl-rail-arrow"
          onclick="flaberryScrollCatRail('{{ section.id }}', 1)"
          aria-label="Next categories"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="fl-cat-rail" id="fl-rail-track-{{ section.id }}" role="region" aria-label="Category Rail">
      {%- for block in section.blocks -%}
        {%- liquid
          assign cat_img = block.settings.image
          assign fallback_img = block.settings.image_asset_fallback | default: 't_roses.webp'
          assign link_url = block.settings.link | default: routes.all_products_collection_url
          assign cat_title = block.settings.title | default: 'Category'
        -%}
        <a href="{{ link_url }}" class="fl-tile" aria-label="{{ cat_title | escape }}" {{ block.shopify_attributes }}>
          {%- if cat_img != blank -%}
            {{ cat_img | image_url: width: 600 | image_tag:
              width: 528,
              height: 316,
              loading: 'lazy',
              class: 'fl-tile-img',
              alt: cat_title | escape
            }}
          {%- else -%}
            <img
              src="{{ fallback_img | asset_url }}"
              class="fl-tile-img"
              alt="{{ cat_title | escape }}"
              loading="lazy"
              width="528"
              height="316"
            >
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .fl-cat-rail-section {
    padding-top: 24px;
    padding-bottom: 24px;
    background-color: transparent;
    width: 100%;
  }
  .fl-cat-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 48px;
    box-sizing: border-box;
  }
  @media (max-width: 960px) {
    .fl-cat-container {
      padding: 0 14px;
    }
  }
  @media (max-width: 480px) {
    .fl-cat-container {
      padding: 0 10px;
    }
  }

  .fl-sec-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }
  .fl-sec-title {
    font-size: clamp(24px, 2.5vw, 32px);
    font-weight: 800;
    color: #1b2141;
    margin: 0;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .fl-sec-subtitle {
    font-size: 14.5px;
    color: #6f6763;
    margin: 4px 0 0;
  }

  /* Circular arrow buttons matching prototype */
  .fl-arrow-btns {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .fl-rail-arrow {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid #e7e1dd;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1b2141;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
  }
  .fl-rail-arrow:hover {
    background: #f7f5f3;
    border-color: #1b2141;
    transform: scale(1.05);
  }
  @media (max-width: 640px) {
    .fl-rail-arrow {
      width: 36px;
      height: 36px;
    }
  }

  /* Category rail with 5 cards desktop & 74% peeking on mobile */
  .fl-cat-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 4 * 16px) / 5);
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    scroll-behavior: smooth;
    padding-bottom: 6px;
    -webkit-overflow-scrolling: touch;
  }
  .fl-cat-rail::-webkit-scrollbar {
    display: none;
  }
  .fl-cat-rail > * {
    scroll-snap-align: start;
  }

  /* Card tiles */
  .fl-tile {
    border-radius: 16px;
    overflow: hidden;
    display: block;
    position: relative;
    text-decoration: none;
    background: #f4edea;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .fl-tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }
  .fl-tile-img {
    width: 100%;
    aspect-ratio: 528 / 316;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .fl-tile:hover .fl-tile-img {
    transform: scale(1.04);
  }

  @media (max-width: 1100px) {
    .fl-cat-rail {
      grid-auto-columns: calc((100% - 3 * 16px) / 4);
    }
  }
  @media (max-width: 820px) {
    .fl-cat-rail {
      grid-auto-columns: calc((100% - 2 * 12px) / 3);
      gap: 12px;
    }
  }
  @media (max-width: 640px) {
    .fl-cat-rail {
      grid-auto-columns: 74%;
      gap: 12px;
    }
    .fl-tile {
      border-radius: 14px;
    }
  }
</style>

<script>
  function flaberryScrollCatRail(secId, dir) {
    var r = document.getElementById('fl-rail-track-' + secId);
    if (!r) return;
    var distance = r.clientWidth * 0.8;
    r.scrollBy({ left: dir * distance, behavior: 'smooth' });
  }
</script>

