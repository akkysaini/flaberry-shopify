{% comment %}
  Flaberry Product Rail / Carousel Section
  Source of Truth: reference/Flaberry_Design1_Classic.html
  Dynamic collection-driven product rail with rating badges, pricing, and responsive arrows.
{% endcomment %}

<div class="flaberry-prod-rail-section" data-section-id="{{ section.id }}">
  <div class="flaberry-container">
    <div class="flaberry-sec-header">
      <div>
        <h2 class="flaberry-sec-title">{{ section.settings.title | default: 'Featured Collection' }}</h2>
        {% if section.settings.subtitle != blank %}
          <p class="flaberry-sec-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
      <div class="flaberry-header-actions">
        {% if section.settings.collection != blank %}
          <a href="{{ section.settings.collection.url }}" class="flaberry-view-all-link">
            View all
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {% endif %}
        <div class="flaberry-rail-arrows">
          <button class="flaberry-arrow-btn" onclick="flaberryScrollProdRail('{{ section.id }}', -1)" aria-label="Previous products">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button class="flaberry-arrow-btn" onclick="flaberryScrollProdRail('{{ section.id }}', 1)" aria-label="Next products">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>

    {% assign target_coll = section.settings.collection %}
    <div class="flaberry-prod-rail" id="flaberry-prod-rail-{{ section.id }}">
      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for prod in target_coll.products limit: section.settings.products_to_show %}
          {% render 'flaberry-product-card', product: prod %}
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          {% if block.settings.product != blank %}
            {% render 'flaberry-product-card', product: block.settings.product %}
          {% endif %}
        {% endfor %}
        {% comment %} Preview Fallback Cards for Unpublished Collections in Dev Preview {% endcomment %}
        {% if section.settings.collection == 'flowers' or section.id contains 'best_sellers' %}
          {% assign img_rose = 'hx_roses.webp' | file_url %}
          {% assign img_lily = 'hx_lily.webp' | file_url %}
          {% assign img_orchid = 'hx_orchids.webp' | file_url %}
          {% assign img_heart = 'hx_heartbox.webp' | file_url %}
          {% assign img_flowers = 'hero_flowers.webp' | file_url %}
          {% render 'flaberry-product-card', title: 'Heartfelt Red Roses Bunch', price_formatted: '₹3,100.00', compare_price_formatted: '₹3,500.00', price: 3100, compare_at_price: 3500, image: img_flowers, rating: '4.9', reviews_count: 142, category: 'Bouquets', link: '/products/red-rose-gift-luxe' %}
          {% render 'flaberry-product-card', title: 'Red Rose Love Treat', price_formatted: '₹2,660.00', compare_price_formatted: '₹2,990.00', price: 2660, compare_at_price: 2990, image: img_rose, rating: '4.8', reviews_count: 98, category: 'Roses', link: '/products/red-rose-gift-luxe' %}
          {% render 'flaberry-product-card', title: 'Serene Pink Lily Box', price_formatted: '₹3,800.00', compare_price_formatted: '₹4,200.00', price: 3800, compare_at_price: 4200, image: img_lily, rating: '4.9', reviews_count: 67, category: 'Lilies', link: '/products/red-rose-gift-luxe' %}
          {% render 'flaberry-product-card', title: 'Royal Blue Orchid Vase', price_formatted: '₹2,900.00', compare_price_formatted: '₹3,250.00', price: 2900, compare_at_price: 3250, image: img_orchid, rating: '4.7', reviews_count: 53, category: 'Orchids', link: '/products/red-rose-gift-luxe' %}
          {% render 'flaberry-product-card', title: 'Grand Rose Arrangement', price_formatted: '₹29,000.00', compare_price_formatted: '₹32,000.00', price: 29000, compare_at_price: 32000, image: img_heart, rating: '5.0', reviews_count: 24, category: 'Luxury', link: '/products/red-rose-gift-luxe' %}
        {% else %}
          {% assign img_anniv = 'hero_anniv.webp' | file_url %}
          {% assign img_combo = 't_cakeflowers.webp' | file_url %}
          {% assign img_bday = 'hero_bday.webp' | file_url %}
          {% assign img_ferrero = 'hx_ferrero.webp' | file_url %}
          {% render 'flaberry-product-card', title: 'Anniversary Peach Charm', price_formatted: '₹1,699.00', compare_price_formatted: '₹1,899.00', price: 1699, compare_at_price: 1899, image: img_anniv, rating: '4.8', reviews_count: 110, category: 'Occasions', link: '/products/chocolate-cake' %}
          {% render 'flaberry-product-card', title: 'Dark Choco Rose Affair', price_formatted: '₹4,400.00', compare_price_formatted: '₹4,890.00', price: 4400, compare_at_price: 4890, image: img_combo, rating: '4.9', reviews_count: 76, category: 'Combos', link: '/products/chocolate-cake' %}
          {% render 'flaberry-product-card', title: 'Birthday Wishes Bouquet', price_formatted: '₹1,599.00', compare_price_formatted: '₹1,799.00', price: 1599, compare_at_price: 1799, image: img_bday, rating: '4.7', reviews_count: 89, category: 'Birthday', link: '/products/chocolate-cake' %}
          {% render 'flaberry-product-card', title: 'Ferrero Rocher Floral Luxe', price_formatted: '₹2,990.00', compare_price_formatted: '₹3,350.00', price: 2990, compare_at_price: 3350, image: img_ferrero, rating: '4.9', reviews_count: 134, category: 'Gourmet', link: '/products/chocolate-cake' %}
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

<style>
  .flaberry-prod-rail-section {
    padding: 36px 0;
    background-color: #ffffff;
  }
  .flaberry-header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .flaberry-view-all-link {
    font-size: 14px;
    font-weight: 600;
    color: var(--fl-color-flora, #e2522c);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s;
  }
  .flaberry-view-all-link:hover {
    color: var(--fl-color-flora-deep, #c23e1b);
    text-decoration: underline;
  }
  .flaberry-prod-rail {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding: 10px 4px 20px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .flaberry-prod-rail::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function flaberryScrollProdRail(secId, dir) {
    const rail = document.getElementById('flaberry-prod-rail-' + secId);
    if (!rail) return;
    rail.scrollBy({ left: dir * 340, behavior: 'smooth' });
  }
</script>

{% schema %}
{
  "name": "Flaberry Product Rail",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Hand-crafted arrangements that our customers love most."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Source Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Maximum products to show",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Specific Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flaberry Product Rail",
      "settings": {
        "title": "Best Sellers",
        "subtitle": "Hand-crafted arrangements that our customers love most."
      }
    }
  ]
}
{% endschema %}
