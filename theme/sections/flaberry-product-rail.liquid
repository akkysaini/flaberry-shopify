{% comment %}
  Flaberry Product Rail / Carousel Section
  Source of Truth: reference/Flaberry_Design1_Classic.html (.rail, .sec-h, .pcard)
  Displays collection or block-driven products in a 5-column horizontal rail with
  circular arrow controls, 'View all' link, and mobile peeking cards.
  Individual product cards strictly redirect to their respective Product Detail Pages (PDP).
{% endcomment %}

<section class="flaberry-rail-section sec" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="sec-h">
      <div class="sec-h-text">
        <h2>{{ section.settings.title | default: 'Premium flowers' }}</h2>
        {% if section.settings.subtitle != blank %}
          <p>{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>

      <div class="sec-h-actions">
        {%- liquid
          assign view_url = ''
          if section.settings.view_all_link != blank
            assign view_url = section.settings.view_all_link
          elsif section.settings.collection != blank
            if section.settings.collection.url != blank
              assign view_url = section.settings.collection.url
            else
              assign view_url = '/collections/' | append: section.settings.collection
            endif
          else
            assign view_url = '/collections/flowers'
          endif
        -%}

        {% if section.settings.show_view_all %}
          <a class="btn ghost sm" href="{{ view_url }}">{{ section.settings.view_all_text | default: 'View all' }}</a>
        {% endif %}

        <div class="arrow-btns">
          <button type="button" onclick="flaberryScrollRail('{{ section.id }}', -1)" aria-label="Previous products">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>
          <button type="button" onclick="flaberryScrollRail('{{ section.id }}', 1)" aria-label="Next products">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    {%- liquid
      assign coll_handle = section.settings.collection.handle | default: section.settings.collection
      assign target_coll = collections[coll_handle]
    -%}

    <div class="rail" id="flaberry-rail-{{ section.id }}">
      {% if target_coll != blank and target_coll.products.size > 0 %}
        {% for prod in target_coll.products limit: section.settings.products_to_show %}
          {% render 'flaberry-product-card', product: prod %}
        {% endfor %}
      {% elsif section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% if block.settings.product != blank %}
            {% render 'flaberry-product-card', 
              product: block.settings.product,
              title: block.settings.title,
              price: block.settings.price,
              compare_at_price: block.settings.compare_at_price,
              rating: block.settings.rating,
              reviews_count: block.settings.reviews_count,
              tag: block.settings.tag,
              image_asset: block.settings.image_asset,
              link: block.settings.link
            %}
          {% else %}
            {% assign block_img = '' %}
            {% if block.settings.custom_image != blank %}
              {% assign block_img = block.settings.custom_image | image_url: width: 600, height: 600 %}
            {% endif %}
            {% render 'flaberry-product-card', 
              title: block.settings.title,
              price: block.settings.price,
              compare_at_price: block.settings.compare_at_price,
              rating: block.settings.rating,
              reviews_count: block.settings.reviews_count,
              tag: block.settings.tag,
              image: block_img,
              image_asset: block.settings.image_asset,
              link: block.settings.link
            %}
          {% endif %}
        {% endfor %}
      {% else %}
        {% comment %} Prototype Curated Fallback with direct PDP links {% endcomment %}
        {% render 'flaberry-product-card', title: 'Posh Pink Enchantment', price: 2440, rating: '4.8', reviews_count: 217, tag: 'Premium', image_asset: 'p111.webp', link: '/products/posh-pink-enchantment' %}
        {% render 'flaberry-product-card', title: 'Heartful Wishes', price: 11990, rating: '4.8', reviews_count: 81, tag: 'Premium', image_asset: 'p112.webp', link: '/products/heartful-wishes' %}
        {% render 'flaberry-product-card', title: 'Passionate Love', price: 4660, rating: '4.8', reviews_count: 241, tag: 'Premium', image_asset: 'p113.webp', link: '/products/passionate-love' %}
        {% render 'flaberry-product-card', title: 'Just for You', price: 7800, rating: '4.5', reviews_count: 86, tag: 'Premium', image_asset: 'p114.webp', link: '/products/just-for-you' %}
        {% render 'flaberry-product-card', title: "Mom's Love", price: 4200, rating: '5.0', reviews_count: 51, tag: 'Premium', image_asset: 'p115.webp', link: '/products/moms-love' %}
        {% render 'flaberry-product-card', title: 'Premium Beauty', price: 4400, rating: '4.8', reviews_count: 201, tag: 'Premium', image_asset: 'p105.webp', link: '/products/premium-beauty' %}
        {% render 'flaberry-product-card', title: 'Mesmerizing Red', price: 2420, rating: '4.7', reviews_count: 144, tag: 'Premium', image_asset: 'p108.webp', link: '/products/mesmerizing-red' %}
        {% render 'flaberry-product-card', title: 'Breathtaking Beauty', price: 4190, rating: '4.4', reviews_count: 133, tag: 'Premium', image_asset: 'p109.webp', link: '/products/breathtaking-beauty' %}
      {% endif %}
    </div>
  </div>
</section>

<style>
  .flaberry-rail-section {
    padding: 36px 0;
    background: #ffffff;
  }
  .flaberry-rail-section .wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--gutter, 20px);
    box-sizing: border-box;
  }
  .flaberry-rail-section .sec-h {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
    flex-wrap: wrap;
  }
  .flaberry-rail-section .sec-h-text h2 {
    font-family: var(--display, inherit);
    font-size: clamp(24px, 3.2vw, 36px);
    font-weight: 700;
    color: #1e1b4b;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .flaberry-rail-section .sec-h-text p {
    color: var(--muted, #6b7280);
    margin: 6px 0 0;
    font-size: 14.5px;
    max-width: 65ch;
    line-height: 1.45;
  }
  .flaberry-rail-section .sec-h-actions {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .flaberry-rail-section .btn.ghost.sm {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 7px 18px;
    font-size: 13.5px;
    font-weight: 600;
    color: #1e1b4b;
    background: transparent;
    border: 1px solid #1e1b4b;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
    line-height: 1.4;
  }
  .flaberry-rail-section .btn.ghost.sm:hover {
    background: #1e1b4b;
    color: #ffffff;
  }
  .flaberry-rail-section .arrow-btns {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .flaberry-rail-section .arrow-btns button {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--line, #e7e1dd);
    background: #ffffff;
    display: grid;
    place-items: center;
    cursor: pointer;
    color: #1e1b4b;
    transition: all 0.2s ease;
    padding: 0;
  }
  .flaberry-rail-section .arrow-btns button:hover {
    border-color: #1e1b4b;
    background: #faf9f8;
  }
  .flaberry-rail-section .arrow-btns button:active {
    transform: scale(0.95);
  }

  /* 5-Column Responsive Rail */
  .flaberry-rail-section .rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 4 * 16px) / 5);
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 6px;
    -webkit-overflow-scrolling: touch;
  }
  .flaberry-rail-section .rail::-webkit-scrollbar {
    display: none;
  }
  .flaberry-rail-section .rail > * {
    scroll-snap-align: start;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1200px) {
    .flaberry-rail-section .rail {
      grid-auto-columns: calc((100% - 3 * 16px) / 4);
    }
  }
  @media (max-width: 900px) {
    .flaberry-rail-section .rail {
      grid-auto-columns: calc((100% - 2 * 14px) / 3);
      gap: 14px;
    }
  }
  @media (max-width: 640px) {
    .flaberry-rail-section {
      padding: 24px 0;
    }
    .flaberry-rail-section .sec-h {
      margin-bottom: 16px;
      gap: 12px;
      align-items: center;
    }
    .flaberry-rail-section .sec-h-text h2 {
      font-size: 22px;
    }
    .flaberry-rail-section .sec-h-text p {
      font-size: 13px;
      line-height: 1.4;
      margin-top: 4px;
    }
    .flaberry-rail-section .sec-h-actions {
      gap: 8px;
    }
    .flaberry-rail-section .btn.ghost.sm {
      padding: 6px 14px;
      font-size: 12.5px;
    }
    .flaberry-rail-section .arrow-btns button {
      width: 32px;
      height: 32px;
    }
    .flaberry-rail-section .arrow-btns button svg {
      width: 15px;
      height: 15px;
    }
    .flaberry-rail-section .rail {
      grid-auto-columns: 72%;
      gap: 14px;
      margin: 0 calc(-1 * var(--gutter, 16px));
      padding: 0 var(--gutter, 16px) 6px;
      scroll-padding: 0 var(--gutter, 16px);
    }
  }
</style>

<script>
  function flaberryScrollRail(secId, dir) {
    var rail = document.getElementById('flaberry-rail-' + secId);
    if (!rail) return;
    var step = rail.clientWidth * 0.75;
    rail.scrollBy({ left: dir * step, behavior: 'smooth' });
  }
</script>

