{% comment %}
  Flaberry Verified Multi-Vendor & Partner Florists Section
  Integrates with Webkul MultiVendor Marketplace
  Provides visibility of local florist & bakery partners across India
{% endcomment %}

<section class="flaberry-vendors-section sec" style="padding: 40px 0 60px;">
  <div class="wrap" style="max-width: 1440px; margin: 0 auto; padding: 0 20px;">
    <div class="sec-h" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px; flex-wrap: wrap; gap: 14px;">
      <div>
        <h1 style="font-size: clamp(24px, 3.2vw, 36px); font-weight: 700; color: var(--ink, #1e1b4b); margin: 0 0 6px;">{{ section.settings.heading | default: 'Our Verified Partner Florists & Bakers' }}</h1>
        <p style="color: var(--muted, #5f6178); font-size: 14.5px; margin: 0;">{{ section.settings.subheading | default: 'Locally hand-crafted arrangements, baked fresh daily, and delivered with love across 500+ cities in India.' }}</p>
      </div>

      <div class="vendor-actions" style="display: flex; gap: 10px;">
        <a href="/pages/partner" class="btn flora sm" style="padding: 8px 18px; font-size: 13.5px; text-decoration: none; border-radius: 999px;">Become a Partner</a>
        <a href="/pages/seller-login" class="btn ghost sm" style="padding: 8px 18px; font-size: 13.5px; text-decoration: none; border-radius: 999px; border: 1px solid var(--ink, #1e1b4b); color: var(--ink, #1e1b4b);">Vendor Login</a>
      </div>
    </div>

    <!-- Verified Vendors Grid -->
    <div class="vendors-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px;">
      
      <!-- Vendor 1: Delhi NCR -->
      <div class="vendor-card" style="background: #ffffff; border: 1px solid var(--line, #e7e1dd); border-radius: 14px; padding: 20px; display: flex; flex-direction: column; gap: 12px; transition: transform 0.2s, box-shadow 0.2s;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
          <div>
            <h3 style="font-size: 18px; font-weight: 700; color: var(--ink, #1e1b4b); margin: 0 0 4px;">Bloom Craft Florals</h3>
            <span style="font-size: 13px; color: var(--muted, #5f6178);">📍 Delhi NCR · Pincodes 110001–110096</span>
          </div>
          <span class="pill info" style="background: #eef2ff; color: #4338ca; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 999px;">Verified Partner</span>
        </div>
        <p style="font-size: 13.5px; color: #4b5563; margin: 0; line-height: 1.5;">Specializes in Dutch Roses, Imported Lilies, and Orchids. Express 2-hour same-day delivery across South and Central Delhi.</p>
        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f3f4f6; padding-top: 12px; margin-top: auto;">
          <span style="font-size: 13px; font-weight: 600; color: #047857;">4.9 ★ (340+ orders)</span>
          <a href="{{ routes.collections_url }}/flowers" style="font-size: 13px; font-weight: 600; color: var(--flora-deep, #ad1f2b); text-decoration: none;">View Catalog →</a>
        </div>
      </div>

      <!-- Vendor 2: Mumbai -->
      <div class="vendor-card" style="background: #ffffff; border: 1px solid var(--line, #e7e1dd); border-radius: 14px; padding: 20px; display: flex; flex-direction: column; gap: 12px; transition: transform 0.2s, box-shadow 0.2s;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
          <div>
            <h3 style="font-size: 18px; font-weight: 700; color: var(--ink, #1e1b4b); margin: 0 0 4px;">Royal Bakes & Confections</h3>
            <span style="font-size: 13px; color: var(--muted, #5f6178);">📍 Mumbai · Pincodes 400001–400099</span>
          </div>
          <span class="pill info" style="background: #eef2ff; color: #4338ca; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 999px;">Master Bakery</span>
        </div>
        <p style="font-size: 13.5px; color: #4b5563; margin: 0; line-height: 1.5;">Artisan Belgian Chocolate Cakes, 100% Eggless Truffles, and Midnight Surprise cakes hand-delivered with cold-chain packaging.</p>
        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f3f4f6; padding-top: 12px; margin-top: auto;">
          <span style="font-size: 13px; font-weight: 600; color: #047857;">4.9 ★ (510+ orders)</span>
          <a href="{{ routes.collections_url }}/chocolate-cakes" style="font-size: 13px; font-weight: 600; color: var(--flora-deep, #ad1f2b); text-decoration: none;">View Catalog →</a>
        </div>
      </div>

      <!-- Vendor 3: Bengaluru -->
      <div class="vendor-card" style="background: #ffffff; border: 1px solid var(--line, #e7e1dd); border-radius: 14px; padding: 20px; display: flex; flex-direction: column; gap: 12px; transition: transform 0.2s, box-shadow 0.2s;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
          <div>
            <h3 style="font-size: 18px; font-weight: 700; color: var(--ink, #1e1b4b); margin: 0 0 4px;">Gardenia Fresh Stems</h3>
            <span style="font-size: 13px; color: var(--muted, #5f6178);">📍 Bengaluru · Pincodes 560001–560100</span>
          </div>
          <span class="pill info" style="background: #eef2ff; color: #4338ca; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 999px;">Verified Partner</span>
        </div>
        <p style="font-size: 13.5px; color: #4b5563; margin: 0; line-height: 1.5;">Farm-fresh carnations, gerberas, and luxury floral hampers. Serving Koramangala, Indiranagar, Whitefield, and Electronic City.</p>
        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f3f4f6; padding-top: 12px; margin-top: auto;">
          <span style="font-size: 13px; font-weight: 600; color: #047857;">4.8 ★ (290+ orders)</span>
          <a href="{{ routes.collections_url }}/flowers" style="font-size: 13px; font-weight: 600; color: var(--flora-deep, #ad1f2b); text-decoration: none;">View Catalog →</a>
        </div>
      </div>

      <!-- Vendor 4: Hyderabad -->
      <div class="vendor-card" style="background: #ffffff; border: 1px solid var(--line, #e7e1dd); border-radius: 14px; padding: 20px; display: flex; flex-direction: column; gap: 12px; transition: transform 0.2s, box-shadow 0.2s;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
          <div>
            <h3 style="font-size: 18px; font-weight: 700; color: var(--ink, #1e1b4b); margin: 0 0 4px;">Petal Magic &amp; Gifting</h3>
            <span style="font-size: 13px; color: var(--muted, #5f6178);">📍 Hyderabad · Pincodes 500001–500085</span>
          </div>
          <span class="pill info" style="background: #eef2ff; color: #4338ca; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 999px;">Verified Partner</span>
        </div>
        <p style="font-size: 13.5px; color: #4b5563; margin: 0; line-height: 1.5;">Signature anniversary floral boxes, heart-shaped arrangements, and personalized combo hampers delivered on fixed-time slots.</p>
        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f3f4f6; padding-top: 12px; margin-top: auto;">
          <span style="font-size: 13px; font-weight: 600; color: #047857;">4.9 ★ (210+ orders)</span>
          <a href="{{ routes.collections_url }}/combos" style="font-size: 13px; font-weight: 600; color: var(--flora-deep, #ad1f2b); text-decoration: none;">View Catalog →</a>
        </div>
      </div>

      <!-- Vendor 5: Pune -->
      <div class="vendor-card" style="background: #ffffff; border: 1px solid var(--line, #e7e1dd); border-radius: 14px; padding: 20px; display: flex; flex-direction: column; gap: 12px; transition: transform 0.2s, box-shadow 0.2s;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
          <div>
            <h3 style="font-size: 18px; font-weight: 700; color: var(--ink, #1e1b4b); margin: 0 0 4px;">Pune Sweet Moments</h3>
            <span style="font-size: 13px; color: var(--muted, #5f6178);">📍 Pune · Pincodes 411001–411058</span>
          </div>
          <span class="pill info" style="background: #eef2ff; color: #4338ca; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 999px;">Master Baker</span>
        </div>
        <p style="font-size: 13.5px; color: #4b5563; margin: 0; line-height: 1.5;">Designer photo cakes, red velvet celebration cakes, and fresh potted plant combos for birthdays and milestones.</p>
        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f3f4f6; padding-top: 12px; margin-top: auto;">
          <span style="font-size: 13px; font-weight: 600; color: #047857;">4.8 ★ (180+ orders)</span>
          <a href="{{ routes.collections_url }}/cakes" style="font-size: 13px; font-weight: 600; color: var(--flora-deep, #ad1f2b); text-decoration: none;">View Catalog →</a>
        </div>
      </div>

      <!-- Vendor 6: Partner Registration CTA Card -->
      <div class="vendor-card partner-cta" style="background: var(--mist, #f7f6f5); border: 2px dashed var(--line, #cbd5e1); border-radius: 14px; padding: 24px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; gap: 14px;">
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #ffffff; display: grid; place-items: center; box-shadow: 0 2px 6px rgba(0,0,0,0.06);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--flora-deep, #ad1f2b)" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
        </div>
        <div>
          <h3 style="font-size: 18px; font-weight: 700; color: var(--ink, #1e1b4b); margin: 0 0 6px;">Are you a local florist or baker?</h3>
          <p style="font-size: 13px; color: var(--muted, #5f6178); margin: 0; line-height: 1.5;">Join Flaberry's multi-vendor marketplace network. Expand your reach to thousands of orders across India with guaranteed settlements.</p>
        </div>
        <a href="/pages/partner" class="btn flora sm" style="padding: 10px 22px; font-size: 13.5px; border-radius: 999px; text-decoration: none;">Apply to Partner</a>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Flaberry Vendors List",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Verified Partner Florists & Bakers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Locally hand-crafted arrangements, baked fresh daily, and delivered with love across 500+ cities in India."
    }
  ],
  "presets": [
    {
      "name": "Flaberry Vendors List"
    }
  ]
}
{% endschema %}
