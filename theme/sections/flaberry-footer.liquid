{% comment %}
  Flaberry Production Footer Section
  Source of Truth: reference/Flaberry_Design1_Classic.html (.foot, .cols, .flogo, .ftag, .news, .fcontact, .social, .base, .paywrap)
  Matching uploaded screenshot: media_1795138545572_2359bf27.png
  - 5-Column desktop grid (Brand & Newsletter + Information + Help Services + Support + Policies)
  - Dynamic link_list binding from Shopify Admin Navigation for each column, with prototype fallbacks
  - Native Shopify newsletter customer form with pill styling
  - Social icons (Facebook, X, Instagram)
  - 100% Purchase Protection badge with payment options
  - Highly responsive mobile & tablet layouts
{% endcomment %}

<footer class="flaberry-footer-section foot" style="--fb-footer-bg: {{ section.settings.bg_color | default: '#1e1b4b' }};">
  <div class="wrap">
    <div class="cols">
      <!-- Column 1: Brand Info, Newsletter & Support -->
      <div class="col-brand">
        <a href="{{ routes.root_url }}" class="flogo-link" aria-label="Flaberry home">
          {% if section.settings.logo != blank %}
            <img src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" class="flogo" height="42" width="auto">
          {% else %}
            <img src="{{ 'flaberry-logo-prototype.png' | asset_url }}" alt="Flaberry" class="flogo" height="42" width="auto">
          {% endif %}
        </a>

        <p class="ftag">
          {{ section.settings.brand_text | default: "India's leading brand for flowers, cakes, plants and gifts. Same-day, midnight and advance-date delivery to 500+ cities." }}
        </p>

        {% if section.settings.show_newsletter %}
          <div class="news-wrap">
            {% form 'customer', id: 'FlaberryFooterNewsletterForm', class: 'news-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="news">
                <label class="sr-only" for="flaberry-newsletter-email">Email</label>
                <input
                  id="flaberry-newsletter-email"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="{{ section.settings.newsletter_placeholder | default: 'Email for offers' }}"
                  required
                  autocomplete="email"
                  autocapitalize="off"
                >
                <button type="submit" class="btn white sm">
                  {{ section.settings.newsletter_btn_text | default: 'Subscribe' }}
                </button>
              </div>
              {% if form.posted_successfully? %}
                <p class="news-status success" role="status">Subscribed. Watch your inbox for offers.</p>
              {% endif %}
              {% if form.errors %}
                <p class="news-status error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
              {% endif %}
            {% endform %}
          </div>
        {% endif %}

        <div class="fcontact">
          <p class="fhours">{{ section.settings.support_hours | default: 'Help 8 AM – midnight IST' }}</p>
          <p class="flinks">
            {% if section.settings.support_phone != blank %}
              <a href="tel:{{ section.settings.support_phone | replace: ' ', '' }}">{{ section.settings.support_phone }}</a>
            {% endif %}
            {% if section.settings.support_phone != blank and section.settings.support_email != blank %}
              <span class="fsep">·</span>
            {% endif %}
            {% if section.settings.support_email != blank %}
              <a href="mailto:{{ section.settings.support_email }}">{{ section.settings.support_email }}</a>
            {% endif %}
          </p>
        </div>

        <div class="social">
          {% if section.settings.facebook_url != blank %}
            <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Flaberry on Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.twitter_url != blank %}
            <a href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener" aria-label="Flaberry on X">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4 4l7.2 9.6L4.4 20H6l6-5.6 4.2 5.6H20l-7.5-10L19 4h-1.6l-5.6 5.2L7.8 4z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Flaberry on Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3.5" y="3.5" width="17" height="17" rx="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Column 2: INFORMATION -->
      <div class="col-nav">
        <h6>{{ section.settings.col1_heading | default: 'INFORMATION' }}</h6>
        <ul>
          {% if section.settings.col1_menu != blank and linklists[section.settings.col1_menu].links.size > 0 %}
            {% for link in linklists[section.settings.col1_menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/pages/about">About Us</a></li>
            <li><a href="/pages/careers">Career with Us</a></li>
            <li><a href="/pages/care">Care Tips</a></li>
            <li><a href="/pages/corporate">Corporate</a></li>
            <li><a href="/pages/partner">Become a Partner</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Column 3: HELP SERVICES -->
      <div class="col-nav">
        <h6>{{ section.settings.col2_heading | default: 'HELP SERVICES' }}</h6>
        <ul>
          {% if section.settings.col2_menu != blank and linklists[section.settings.col2_menu].links.size > 0 %}
            {% for link in linklists[section.settings.col2_menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/pages/pincodes">Serviceable Pincodes</a></li>
            <li><a href="/pages/cake-cities">Cake Delivery Cities</a></li>
            <li><a href="/pages/cities">Flower Delivery Cities</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Column 4: SUPPORT -->
      <div class="col-nav">
        <h6>{{ section.settings.col3_heading | default: 'SUPPORT' }}</h6>
        <ul>
          {% if section.settings.col3_menu != blank and linklists[section.settings.col3_menu].links.size > 0 %}
            {% for link in linklists[section.settings.col3_menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/pages/faq">FAQ</a></li>
            <li><a href="/blogs/news">Blog</a></li>
            <li><a href="/pages/track">Track Order</a></li>
            <li><a href="/pages/contact">Contact Us</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Column 5: POLICIES -->
      <div class="col-nav">
        <h6>{{ section.settings.col4_heading | default: 'POLICIES' }}</h6>
        <ul>
          {% if section.settings.col4_menu != blank and linklists[section.settings.col4_menu].links.size > 0 %}
            {% for link in linklists[section.settings.col4_menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/pages/terms">Terms of Services</a></li>
            <li><a href="/pages/delivery">Delivery Information</a></li>
            <li><a href="/pages/substitution">Substitution Policy</a></li>
            <li><a href="/pages/refund">Refund & Cancellation Policy</a></li>
            <li><a href="/pages/privacy">Privacy Policy</a></li>
          {% endif %}
        </ul>
      </div>
    </div>

    <!-- Divider Line & Bottom Base Bar -->
    <div class="base">
      <span class="copyright">
        {{ section.settings.copyright_text | default: '© 2026 Flaberry. All rights reserved.' }}
      </span>

      {% if section.settings.show_payment_badge %}
        <div class="paywrap">
          <img
            class="pay"
            src="{{ 'flaberry-payments.png' | asset_url }}"
            alt="100% Purchase Protection - Accepted payments: Visa, Mastercard, PayPal, Maestro"
            loading="lazy"
            width="260"
            height="58"
          >
          <span class="paytxt">{{ section.settings.payment_methods_text | default: 'UPI · RuPay · Net banking · Wallets' }}</span>
        </div>
      {% endif %}

      <span class="credits">
        {{ section.settings.credit_text | default: 'Website by' }}
        <a href="{{ section.settings.credit_url | default: 'https://www.probeyservices.com' }}" target="_blank" rel="noopener">
          {{ section.settings.credit_name | default: 'Probey Services' }}
        </a>
      </span>
    </div>
  </div>
</footer>

<style>
  .flaberry-footer-section.foot {
    background: var(--fb-footer-bg, #1e1b4b);
    color: #e9e3df;
    padding-top: 56px;
    padding-bottom: 30px;
    font-size: 14px;
    width: 100%;
    box-sizing: border-box;
  }
  .flaberry-footer-section .wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
    width: 100%;
  }

  /* 5-Column Grid */
  .flaberry-footer-section .cols {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, minmax(0, 1fr));
    gap: 32px 28px;
    align-items: start;
  }

  /* Column 1: Brand Info */
  .flaberry-footer-section .col-brand {
    display: flex;
    flex-direction: column;
    max-width: 380px;
  }
  .flaberry-footer-section .flogo-link {
    display: inline-block;
    width: fit-content;
  }
  .flaberry-footer-section .flogo {
    height: 42px;
    width: auto;
    background: #ffffff;
    border-radius: 10px;
    padding: 5px 10px;
    display: inline-block;
    object-fit: contain;
    box-sizing: border-box;
  }
  .flaberry-footer-section .ftag {
    margin-top: 14px;
    color: #cfd1ea;
    max-width: 36ch;
    font-size: 13.5px;
    line-height: 1.5;
  }

  /* Newsletter Form */
  .flaberry-footer-section .news-wrap {
    margin-top: 14px;
  }
  .flaberry-footer-section .news {
    display: flex;
    gap: 8px;
    align-items: center;
    max-width: 360px;
  }
  .flaberry-footer-section .news input {
    flex: 1;
    min-width: 0;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    padding: 10px 18px;
    color: #ffffff;
    font-size: 13.5px;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .flaberry-footer-section .news input:focus {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.12);
  }
  .flaberry-footer-section .news input::placeholder {
    color: #a9acd3;
  }
  .flaberry-footer-section .news .btn.white.sm {
    background: #ffffff;
    color: var(--fb-footer-bg, #1e1b4b);
    border: none;
    border-radius: 999px;
    padding: 10px 22px;
    font-weight: 600;
    font-size: 13.5px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease, transform 0.1s ease;
    flex-shrink: 0;
  }
  .flaberry-footer-section .news .btn.white.sm:hover {
    background: #f1ece9;
    transform: translateY(-1px);
  }
  .flaberry-footer-section .news-status {
    font-size: 12.5px;
    margin-top: 6px;
  }
  .flaberry-footer-section .news-status.success {
    color: #86efac;
  }
  .flaberry-footer-section .news-status.error {
    color: #fca5a5;
  }

  /* Support Hours & Contacts */
  .flaberry-footer-section .fcontact {
    margin-top: 14px;
    color: #cfd1ea;
    font-size: 13px;
    line-height: 1.55;
  }
  .flaberry-footer-section .fcontact p {
    margin: 0;
  }
  .flaberry-footer-section .fhours {
    margin-bottom: 2px;
  }
  .flaberry-footer-section .fcontact a {
    color: #cfd1ea;
    text-decoration: none;
    user-select: all;
    transition: color 0.2s ease;
  }
  .flaberry-footer-section .fcontact a:hover {
    color: #ffffff;
    text-decoration: underline;
  }
  .flaberry-footer-section .fsep {
    margin: 0 4px;
    opacity: 0.6;
  }

  /* Social Icons */
  .flaberry-footer-section .social {
    display: flex;
    gap: 8px;
    margin-top: 14px;
  }
  .flaberry-footer-section .social a {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.28);
    display: grid;
    place-items: center;
    color: #ffffff;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .flaberry-footer-section .social a:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.45);
  }

  /* Navigation Columns (2 to 5) */
  .flaberry-footer-section .col-nav {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
  }
  .flaberry-footer-section .col-nav h6 {
    display: block !important;
    width: 100% !important;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a9acd3;
    margin: 0 0 14px 0 !important;
    font-weight: 600;
    line-height: 1.2;
  }
  .flaberry-footer-section .col-nav ul {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 10px !important;
    width: 100% !important;
  }
  .flaberry-footer-section .col-nav li {
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
    width: 100% !important;
  }
  .flaberry-footer-section .col-nav a {
    display: inline-block !important;
    color: #cfd1ea;
    text-decoration: none;
    font-size: 13.5px;
    line-height: 1.4;
    transition: color 0.2s ease;
  }
  .flaberry-footer-section .col-nav a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  /* Bottom Bar */
  .flaberry-footer-section .base {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    margin-top: 38px;
    padding-top: 22px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 13px;
    color: #b9bbdb;
  }
  .flaberry-footer-section .base .copyright,
  .flaberry-footer-section .base .credits {
    font-size: 13px;
  }
  .flaberry-footer-section .base .credits a {
    color: inherit;
    text-decoration: underline;
    transition: color 0.2s ease;
  }
  .flaberry-footer-section .base .credits a:hover {
    color: #ffffff;
  }

  /* Payment Badge Wrap */
  .flaberry-footer-section .paywrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }
  .flaberry-footer-section .paywrap img.pay {
    max-height: 52px;
    width: auto;
    object-fit: contain;
    display: block;
  }
  .flaberry-footer-section .paytxt {
    font-size: 11.5px;
    color: #a9acd3;
    letter-spacing: 0.02em;
  }

  /* Responsive Rules */
  @media (max-width: 1024px) {
    .flaberry-footer-section .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 32px 24px !important;
    }
    .flaberry-footer-section .col-brand {
      grid-column: 1 / -1 !important;
      max-width: 100% !important;
    }
    .flaberry-footer-section .col-nav {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
    }
  }

  @media (max-width: 680px) {
    .flaberry-footer-section.foot {
      padding-top: 36px !important;
      /* Extra padding to prevent mobile dock overlap */
      padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px)) !important;
      display: block !important;
      visibility: visible !important;
    }
    .flaberry-footer-section .wrap {
      display: block !important;
      visibility: visible !important;
      padding: 0 16px !important;
    }
    .flaberry-footer-section .cols {
      display: grid !important;
      visibility: visible !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 28px 18px !important;
    }
    .flaberry-footer-section .col-brand {
      grid-column: 1 / -1 !important;
      display: flex !important;
      flex-direction: column !important;
      visibility: visible !important;
    }
    .flaberry-footer-section .col-nav {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      visibility: visible !important;
      width: 100% !important;
    }
    .flaberry-footer-section .col-nav h6 {
      display: block !important;
      width: 100% !important;
      margin: 0 0 12px 0 !important;
      font-size: 12px !important;
    }
    .flaberry-footer-section .col-nav ul {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 10px !important;
      width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
      list-style: none !important;
    }
    .flaberry-footer-section .col-nav li {
      display: block !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    .flaberry-footer-section .col-nav a {
      display: inline-block !important;
      font-size: 13.5px !important;
      line-height: 1.4 !important;
      color: #cfd1ea !important;
    }
    .flaberry-footer-section .news {
      max-width: 100% !important;
    }
    .flaberry-footer-section .base {
      display: flex !important;
      flex-direction: column !important;
      text-align: center !important;
      gap: 16px !important;
      margin-top: 30px !important;
      padding-top: 22px !important;
    }
    .flaberry-footer-section .paywrap img.pay {
      max-width: 240px !important;
      height: auto !important;
    }
  }

  @media (max-width: 480px) {
    .flaberry-footer-section .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 24px 14px !important;
    }
    .flaberry-footer-section .col-nav h6 {
      font-size: 11.5px !important;
      letter-spacing: 0.06em !important;
      margin-bottom: 10px !important;
    }
    .flaberry-footer-section .col-nav a {
      font-size: 13px !important;
    }
    .flaberry-footer-section .news {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .flaberry-footer-section .news .btn.white.sm {
      width: 100%;
      text-align: center;
      padding: 12px 20px;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

{% schema %}
