      "label": "Column 3 Heading",
      "default": "HELP SERVICES"
    },
    {
      "type": "link_list",
      "id": "col2_menu",
      "label": "Column 3 Menu (Help Services)"
    },
    {
      "type": "text",
      "id": "col3_heading",
      "label": "Column 4 Heading",
      "default": "SUPPORT"
    },
    {
      "type": "link_list",
      "id": "col3_menu",
      "label": "Column 4 Menu (Support)"
    },
    {
      "type": "text",
      "id": "col4_heading",
      "label": "Column 5 Heading",
      "default": "POLICIES"
    },
    {
      "type": "link_list",
      "id": "col4_menu",
      "label": "Column 5 Menu (Policies)"
    },
    {
      "type": "header",
      "content": "Bottom Bar & Payment Methods"
    },
    {
      "type": "text",
