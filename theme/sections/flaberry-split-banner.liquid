{% comment %}
  Flaberry Promotional Split Banner Section
  Source of Truth: reference/Flaberry_Design1_Classic.html
  Highlights combo gifting: Flowers with Cake, Chocolates, and Teddies.
{% endcomment %}

<div class="flaberry-split-banner-section" data-section-id="{{ section.id }}">
  <div class="flaberry-container">
    <div class="flaberry-split-card">
      <div class="flaberry-split-media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1000 | image_tag: 
            width: 600, 
            height: 400, 
            loading: 'lazy', 
            class: 'flaberry-split-img', 
            alt: section.settings.heading | escape 
          }}
        {% else %}
          <div class="flaberry-split-placeholder"></div>
        {% endif %}
      </div>

      <div class="flaberry-split-content">
        {% if section.settings.eyebrow != blank %}
          <span class="flaberry-split-eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2 class="flaberry-split-title">{{ section.settings.heading | default: 'Flowers are better with cake' }}</h2>
        <p class="flaberry-split-desc">{{ section.settings.description | default: 'Bouquets paired with cakes, chocolates and teddies — one delivery, one message card.' }}</p>
        <div class="flaberry-split-action">
          <a href="{{ section.settings.button_link | default: routes.collections_url | append: '/combos' }}" class="flaberry-btn flaberry-btn-primary">
            {{ section.settings.button_label | default: 'Shop Combos' }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .flaberry-split-banner-section {
    padding: 30px 0 40px;
  }
  .flaberry-split-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    background: #1c1715;
    border-radius: var(--fl-radius-lg, 24px);
    overflow: hidden;
    min-height: 380px;
    box-shadow: 0 16px 40px rgba(21, 19, 18, 0.12);
  }
  @media (max-width: 900px) {
    .flaberry-split-card {
      grid-template-columns: 1fr;
    }
  }
  .flaberry-split-media {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 280px;
  }
  .flaberry-split-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .flaberry-split-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #3d322e 0%, #1c1715 100%);
  }
  .flaberry-split-content {
    padding: 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #ffffff;
  }
  @media (max-width: 600px) {
    .flaberry-split-content {
      padding: 28px 20px;
    }
  }
  .flaberry-split-eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ff9d85;
    margin-bottom: 12px;
  }
  .flaberry-split-title {
    font-family: var(--fl-font-display, "Inter Tight", sans-serif);
    font-size: clamp(26px, 3.4vw, 42px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0 0 16px;
  }
  .flaberry-split-desc {
    font-size: 16px;
    line-height: 1.55;
    color: #d1cbc7;
    margin: 0 0 28px;
  }
</style>

{% schema %}
{
  "name": "Flaberry Split Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Flower Combos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Flowers are better with cake"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Bouquets paired with cakes, chocolates and teddies — one delivery, one message card."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Combos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Flaberry Split Banner"
    }
  ]
}
{% endschema %}
