<script>
  (function() {
    var activeFilters = {};

    document.addEventListener('DOMContentLoaded', function() {
      initPincodeBar();
    });

    // Pincode Bar Setup & Sync
    function initPincodeBar() {
      var saved = localStorage.getItem('flaberry_pincode') || '110001';
      var pinEl = document.getElementById('availBarPin');
      if (pinEl) pinEl.textContent = saved;
    }

    window.flaberryOpenCollectionPinModal = function() {
      var modal = document.getElementById('collPinModal');
      var inp = document.getElementById('modalPinInp');
      if (modal) modal.style.display = 'grid';
      if (inp) {
        inp.value = localStorage.getItem('flaberry_pincode') || '110001';
        inp.focus();
      }
    };

    window.flaberryCloseCollectionPinModal = function() {
      var modal = document.getElementById('collPinModal');
      if (modal) modal.style.display = 'none';
    };

    window.flaberrySaveCollectionPin = function() {
      var val = document.getElementById('modalPinInp').value.trim();
      var fb = document.getElementById('modalPinFeedback');
      if (!val || val.length !== 6 || !/^\d{6}$/.test(val)) {
        if (fb) {
          fb.style.color = '#b42318';
          fb.textContent = 'Please enter a valid 6-digit Indian pincode.';
        }
        return;
      }

      localStorage.setItem('flaberry_pincode', val);
      var pinEl = document.getElementById('availBarPin');
      if (pinEl) pinEl.textContent = val;

      var headerChip = document.getElementById('hdrPincodeText');
      if (headerChip) headerChip.textContent = val;

      flaberryCloseCollectionPinModal();
    };

    // Mobile Slide Popup Drawer Functions
    window.flaberryOpenFilterDrawer = function() {
      var scrim = document.getElementById('filtersDrawerScrim');
      var drawer = document.getElementById('flaberryFilters');
      if (scrim) scrim.classList.add('active');
      if (drawer) drawer.classList.add('open');
      document.body.style.overflow = 'hidden';
    };

    window.flaberryCloseFilterDrawer = function() {
      var scrim = document.getElementById('filtersDrawerScrim');
      var drawer = document.getElementById('flaberryFilters');
      if (scrim) scrim.classList.remove('active');
      if (drawer) drawer.classList.remove('open');
      document.body.style.overflow = '';
    };

    // Filter Change Logic
    window.flaberryFilterChange = function() {
      var checkedBoxes = document.querySelectorAll('#flaberryFilters input[type="checkbox"]:checked');
      var count = checkedBoxes.length;

      // Update badges
      var fbtnBadge = document.getElementById('fbtnBadge');
      if (fbtnBadge) {
        fbtnBadge.textContent = count;
        fbtnBadge.style.display = count > 0 ? 'inline-block' : 'none';
      }

      var mPill = document.getElementById('mFilterCountPill');
      if (mPill) {
        mPill.textContent = count + ' selected';
        mPill.style.display = count > 0 ? 'inline-block' : 'none';
      }

      var dClear = document.getElementById('dClearBtn');
      if (dClear) {
        dClear.style.display = count > 0 ? 'block' : 'none';
      }

      // Live DOM filtering of products in grid
      var cards = document.querySelectorAll('#flaberryCollectionGrid .pcard');
      if (cards.length === 0) return;

      var selectedFilters = [];
      checkedBoxes.forEach(function(cb) {
        selectedFilters.push(cb.getAttribute('data-f'));
      });

      var visibleCount = 0;
      cards.forEach(function(card) {
        var price = parseInt(card.getAttribute('data-price') || '0', 10);
        var rating = parseFloat(card.getAttribute('data-rating') || '0');
        var title = (card.getAttribute('data-title') || '').toLowerCase();
        var tag = (card.getAttribute('data-tag') || '').toLowerCase();

        var matches = true;

        // Check Type
        var typeFilters = selectedFilters.filter(function(f) {
          return ['chocolate','truffle','photo','eggless','heart','rose','orchid','lily','carnation','bouquet','flower','cake','combo'].indexOf(f) !== -1;
        });
        if (typeFilters.length > 0) {
          var typeMatch = typeFilters.some(function(t) {
            return title.indexOf(t) !== -1 || tag.indexOf(t) !== -1;
          });
          if (!typeMatch) matches = false;
        }

        // Check Price
        var priceFilters = selectedFilters.filter(function(f) {
          return ['pu999','p999','p2000','p4000'].indexOf(f) !== -1;
        });
        if (priceFilters.length > 0) {
          var priceMatch = priceFilters.some(function(pf) {
            if (pf === 'pu999') return price < 999;
            if (pf === 'p999') return price >= 999 && price < 2000;
            if (pf === 'p2000') return price >= 2000 && price < 4000;
            if (pf === 'p4000') return price >= 4000;
            return false;
          });
          if (!priceMatch) matches = false;
        }

        // Check Rating
        if (selectedFilters.indexOf('r45') !== -1 && rating < 4.5) matches = false;
        if (selectedFilters.indexOf('r40') !== -1 && rating < 4.0) matches = false;

        card.style.display = matches ? 'flex' : 'none';
        if (matches) visibleCount++;
      });

      var countEl = document.getElementById('flaberryItemCount');
      if (countEl) countEl.textContent = visibleCount + ' gifts match filters';

      var emptyEl = document.getElementById('emptyFilterState');
      if (emptyEl) {
        emptyEl.style.display = (visibleCount === 0) ? 'block' : 'none';
      }
    };

    window.flaberryClearFilters = function() {
      var boxes = document.querySelectorAll('#flaberryFilters input[type="checkbox"]');
      boxes.forEach(function(b) { b.checked = false; });
      flaberryFilterChange();
      var countEl = document.getElementById('flaberryItemCount');
      if (countEl) countEl.textContent = '{{ coll_products_count }} gifts found';
    };

    // Sort change handling
    window.flaberrySortChange = function(val) {
      if (val === 'rate') {
        // Sort in DOM by rating
        var grid = document.getElementById('flaberryCollectionGrid');
        if (grid) {
          var cards = Array.from(grid.querySelectorAll('.pcard'));
          cards.sort(function(a, b) {
            var rA = parseFloat(a.getAttribute('data-rating') || '0');
            var rB = parseFloat(b.getAttribute('data-rating') || '0');
            return rB - rA;
          });
          cards.forEach(function(c) { grid.appendChild(c); });
        }
      } else {
        // Reload with Shopify collection sort param
        var url = new URL(window.location.href);
        url.searchParams.set('sort_by', val);
        window.location.href = url.toString();
      }
    };
  })();
</script>

{% schema %}
{
  "name": "Flaberry Main Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "enable_subcats",
      "label": "Enable Subcategory Chips",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_pincode_bar",
      "label": "Enable Pincode Deliverability Bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_seo_faq",
      "label": "Enable SEO Prose & FAQs Section",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "subcat",
      "name": "Subcategory Chip",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Roses"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
