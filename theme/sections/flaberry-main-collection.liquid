{% comment %}
  Flaberry Main Collection Template
  Source of Truth: reference/Flaberry_Design1_Classic.html (.clayout, .filters, .sortbar, .grid, .avail-bar, .subcats, .pager)
  Master CRO Implementation:
  - 4-column desktop grid with 24 products per page, responsive to 3 cols on tablet and 2 cols on mobile
  - Complete protection against theme/base.css 12-column grid overrides
  - Desktop sticky sidebar filters + Mobile slide popup drawer with scrim, filter count badge, apply/reset actions
  - Faceted filters: Subcategories, Price (Under ₹999, ₹999–₹1,999, ₹2,000–₹3,999, ₹4,000+), Delivery Speed (Same Day, Midnight, Fixed Time), Customer Rating (4.5+, 4.0+)
  - Pincode deliverability banner (.avail-bar) synced with localStorage.flaberry_pincode + quick change modal
  - Dynamic subcategory chips (.subcats) with auto-detection & custom blocks
  - Sortbar with Popularity, Price Low-High, Price High-Low, New Arrivals, Best Rated
  - SEO-friendly native Shopify pagination (.pager)
  - Collection metafields integration (short_description, seo_title, seo_text, banner) with rich prototype fallbacks
  - Expandable SEO prose & Frequently Asked Questions (FAQs) accordion at the bottom
{% endcomment %}

{%- liquid
  assign coll_title = collection.title | default: 'All Gifts'
  assign coll_handle = collection.handle | default: 'all'
  assign coll_products_count = collection.products_count | default: collection.products.size
  assign per_page = section.settings.products_per_page | default: 24

  assign short_desc = collection.metafields.flaberry.short_description.value | default: collection.metafields.custom.short_description.value | default: collection.description
  if short_desc == blank
    if coll_handle contains 'cake'
      assign short_desc = 'Order freshly baked artisan cakes online from Flaberry. Handcrafted on the day of delivery with premium ingredients, available in 100% eggless and classic recipes with same-day and midnight delivery across India.'
    elsif coll_handle contains 'flower' or coll_handle contains 'rose'
      assign short_desc = 'Discover exquisite farm-fresh flowers and luxury bouquets hand-arranged by master florists. Sourced at dawn and delivered with complimentary personalized message cards across 500+ Indian cities.'
    elsif coll_handle contains 'combo'
      assign short_desc = 'Delight your loved ones with curated Flaberry celebration combos pairing fresh morning blooms with delicious cakes, teddy bears, and luxury chocolates in a single timely doorstep delivery.'
    else
      assign short_desc = 'Explore our handcrafted gifting collection, hand-arranged by master florists and artisan bakers. Delivered with love and care across 500+ cities in India with same-day and midnight delivery options.'
    endif
  endif

  assign seo_heading = collection.metafields.flaberry.seo_title.value | default: collection.metafields.custom.seo_title.value
  if seo_heading == blank
    assign seo_heading = 'Buy ' | append: coll_title | append: ' Online with Flaberry'
  endif

  assign seo_body = collection.metafields.flaberry.seo_text.value | default: collection.metafields.custom.seo_text.value
-%}

<div class="flaberry-collection-page" data-section-id="{{ section.id }}">
  <div class="wrap">
    <!-- Breadcrumb -->
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      <a href="{{ routes.collections_url }}">Collections</a>
      <span>/</span>
      <span class="active">{{ coll_title }}</span>
    </nav>

    <!-- Collection Hero Header -->
    <div class="chead">
      <div>
        <h1 class="flaberry-coll-title">{{ coll_title }}</h1>
        <p class="flaberry-coll-desc muted">{{ short_desc }}</p>
      </div>
      <div class="muted tab-nums prod-count-pill" id="hdrProdCount">
        {{ coll_products_count }} products
      </div>
    </div>

    <!-- Subcategory Chips Carousel (.subcats) -->
    {% if section.settings.enable_subcats %}
      <div class="subcats" role="navigation" aria-label="Subcategories">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'subcat' %}
              <a 
                href="{{ block.settings.url }}" 
                class="chip {% if block.settings.url contains coll_handle %}on{% endif %}"
              >
                {{ block.settings.title }}
              </a>
            {% endif %}
          {% endfor %}
        {% else %}
          {% comment %} Intelligent Context-Aware Subcategories {% endcomment %}
          {% if coll_handle contains 'cake' %}
            <a href="/collections/cakes" class="chip {% if coll_handle == 'cakes' %}on{% endif %}">All Cakes</a>
            <a href="/collections/chocolate-cakes" class="chip {% if coll_handle == 'chocolate-cakes' %}on{% endif %}">Chocolate Cakes</a>
            <a href="/collections/truffle-cakes" class="chip {% if coll_handle == 'truffle-cakes' %}on{% endif %}">Truffle</a>
            <a href="/collections/photo-cakes" class="chip {% if coll_handle == 'photo-cakes' %}on{% endif %}">Photo Cakes</a>
            <a href="/collections/eggless-cakes" class="chip {% if coll_handle == 'eggless-cakes' %}on{% endif %}">100% Eggless</a>
            <a href="/collections/designer-cakes" class="chip {% if coll_handle == 'designer-cakes' %}on{% endif %}">Designer Cakes</a>
            <a href="/collections/heart-cakes" class="chip {% if coll_handle == 'heart-cakes' %}on{% endif %}">Heart Shape</a>
          {% elsif coll_handle contains 'flower' or coll_handle contains 'rose' %}
            <a href="/collections/flowers" class="chip {% if coll_handle == 'flowers' %}on{% endif %}">All Flowers</a>
            <a href="/collections/roses" class="chip {% if coll_handle == 'roses' %}on{% endif %}">Roses</a>
            <a href="/collections/orchids" class="chip {% if coll_handle == 'orchids' %}on{% endif %}">Orchids</a>
            <a href="/collections/lilies" class="chip {% if coll_handle == 'lilies' %}on{% endif %}">Lilies</a>
            <a href="/collections/carnations" class="chip {% if coll_handle == 'carnations' %}on{% endif %}">Carnations</a>
            <a href="/collections/combos" class="chip {% if coll_handle == 'combos' %}on{% endif %}">Flower Combos</a>
            <a href="/collections/bouquets" class="chip {% if coll_handle == 'bouquets' %}on{% endif %}">Luxury Bouquets</a>
          {% elsif coll_handle contains 'combo' %}
            <a href="/collections/combos" class="chip {% if coll_handle == 'combos' %}on{% endif %}">All Combos</a>
            <a href="/collections/flowers-and-cake" class="chip {% if coll_handle == 'flowers-and-cake' %}on{% endif %}">Flowers & Cake</a>
            <a href="/collections/flowers-and-chocolates" class="chip {% if coll_handle == 'flowers-and-chocolates' %}on{% endif %}">Flowers & Chocolates</a>
            <a href="/collections/flowers-and-teddies" class="chip {% if coll_handle == 'flowers-and-teddies' %}on{% endif %}">Flowers & Teddies</a>
            <a href="/collections/sweets-and-dry-fruits" class="chip {% if coll_handle == 'sweets-and-dry-fruits' %}on{% endif %}">Sweets & Dry Fruits</a>
          {% else %}
            <a href="/collections/all" class="chip {% if coll_handle == 'all' %}on{% endif %}">All Gifts</a>
            <a href="/collections/flowers" class="chip {% if coll_handle == 'flowers' %}on{% endif %}">Flowers</a>
            <a href="/collections/cakes" class="chip {% if coll_handle == 'cakes' %}on{% endif %}">Cakes</a>
            <a href="/collections/combos" class="chip {% if coll_handle == 'combos' %}on{% endif %}">Combos</a>
            <a href="/collections/chocolates" class="chip {% if coll_handle == 'chocolates' %}on{% endif %}">Chocolates</a>
            <a href="/collections/plants" class="chip {% if coll_handle == 'plants' %}on{% endif %}">Plants</a>
            <a href="/collections/personalized" class="chip {% if coll_handle == 'personalized' %}on{% endif %}">Personalized</a>
          {% endif %}
        {% endif %}
      </div>
    {% endif %}

    <!-- Pincode Deliverability Strip (.avail-bar) -->
    {% if section.settings.enable_pincode_bar %}
      <div class="avail-bar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="flex-shrink: 0;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span id="availBarText">
          Showing gifts deliverable to <b id="availBarPin">110001</b> · Connaught Place, New Delhi
        </span>
        <button type="button" class="btn sm ghost" onclick="flaberryOpenCollectionPinModal()" style="margin-left: auto;">
          Change pincode
        </button>
      </div>
    {% endif %}

    <!-- Master 2-Column Collection Layout -->
    <div class="clayout">
      <!-- Mobile Scrim Overlay for Slide-Up Filters Drawer -->
      <div class="filters-drawer-scrim" id="filtersDrawerScrim" onclick="flaberryCloseFilterDrawer()"></div>

      <!-- Filters Column: Desktop Sticky Sidebar & Mobile Slide Popup Drawer -->
      <aside class="filters filters-drawer" id="flaberryFilters">
        <!-- Mobile Drawer Header -->
        <div class="filters-drawer-header">
          <div style="display: flex; align-items: center; gap: 8px;">
            <h5 style="margin: 0; font-size: 17px; font-weight: 700;">Filters</h5>
            <span class="pill info" id="mFilterCountPill" style="display: none;">0 selected</span>
          </div>
          <button type="button" class="x" onclick="flaberryCloseFilterDrawer()" aria-label="Close filters">×</button>
        </div>

        <!-- Scrollable Filter Body -->
        <div class="filters-drawer-body">
          <!-- Filter 1: Subcategories / Type -->
          <div class="filter-group">
            <h6>Type</h6>
            {% if coll_handle contains 'cake' %}
              <label><input type="checkbox" data-f="chocolate" onchange="flaberryFilterChange()"> Chocolate Cakes</label>
              <label><input type="checkbox" data-f="truffle" onchange="flaberryFilterChange()"> Truffle Cakes</label>
              <label><input type="checkbox" data-f="photo" onchange="flaberryFilterChange()"> Photo Cakes</label>
              <label><input type="checkbox" data-f="eggless" onchange="flaberryFilterChange()"> 100% Eggless</label>
              <label><input type="checkbox" data-f="heart" onchange="flaberryFilterChange()"> Heart Shape</label>
            {% elsif coll_handle contains 'flower' or coll_handle contains 'rose' %}
              <label><input type="checkbox" data-f="rose" onchange="flaberryFilterChange()"> Roses</label>
              <label><input type="checkbox" data-f="orchid" onchange="flaberryFilterChange()"> Orchids</label>
              <label><input type="checkbox" data-f="lily" onchange="flaberryFilterChange()"> Lilies</label>
              <label><input type="checkbox" data-f="carnation" onchange="flaberryFilterChange()"> Carnations</label>
              <label><input type="checkbox" data-f="bouquet" onchange="flaberryFilterChange()"> Handcrafted Bouquets</label>
            {% else %}
              <label><input type="checkbox" data-f="flower" onchange="flaberryFilterChange()"> Flowers</label>
              <label><input type="checkbox" data-f="cake" onchange="flaberryFilterChange()"> Cakes</label>
              <label><input type="checkbox" data-f="combo" onchange="flaberryFilterChange()"> Combos</label>
              <label><input type="checkbox" data-f="chocolate" onchange="flaberryFilterChange()"> Chocolates</label>
            {% endif %}
          </div>

          <!-- Filter 2: Price Ranges -->
          <div class="filter-group">
            <h6>Price</h6>
            <label><input type="checkbox" data-f="pu999" onchange="flaberryFilterChange()"> Under {{ 99900 | money }}</label>
            <label><input type="checkbox" data-f="p999" onchange="flaberryFilterChange()"> {{ 99900 | money }} – {{ 199900 | money }}</label>
            <label><input type="checkbox" data-f="p2000" onchange="flaberryFilterChange()"> {{ 200000 | money }} – {{ 399900 | money }}</label>
            <label><input type="checkbox" data-f="p4000" onchange="flaberryFilterChange()"> {{ 400000 | money }} and above</label>
          </div>

          <!-- Filter 3: Delivery Speed -->
          <div class="filter-group">
            <h6>Delivery</h6>
            <label><input type="checkbox" data-f="sameday" onchange="flaberryFilterChange()"> Same Day Delivery</label>
            <label><input type="checkbox" data-f="midnight" onchange="flaberryFilterChange()"> Midnight Delivery</label>
            <label><input type="checkbox" data-f="fixed" onchange="flaberryFilterChange()"> Fixed Time Delivery</label>
          </div>

          <!-- Filter 4: Customer Rating -->
          <div class="filter-group">
            <h6>Rating</h6>
            <label><input type="checkbox" data-f="r45" onchange="flaberryFilterChange()"> 4.5 ★ and above</label>
            <label><input type="checkbox" data-f="r40" onchange="flaberryFilterChange()"> 4.0 ★ and above</label>
          </div>

          <!-- Desktop Clear Filters -->
          <button type="button" class="linkbtn desktop-clear-btn" id="dClearBtn" onclick="flaberryClearFilters()" style="display: none;">
            Clear all filters
          </button>
        </div>

        <!-- Mobile Drawer Sticky Footer -->
        <div class="filters-drawer-footer">
          <button type="button" class="linkbtn" onclick="flaberryClearFilters()">Reset All</button>
          <button type="button" class="btn flora" onclick="flaberryCloseFilterDrawer()">Apply Filters</button>
        </div>
      </aside>

      <!-- Right Column: Sortbar, Products Grid, and Pagination -->
      <div class="collection-main">
        <!-- Sortbar -->
        <div class="sortbar">
          <!-- Mobile Filter Trigger Button (.fbtn) -->
          <button type="button" class="btn ghost sm fbtn" onclick="flaberryOpenFilterDrawer()" aria-label="Open filters drawer">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="vertical-align: -2px; margin-right: 4px;"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
            <span>Filters</span>
            <span class="fbtn-badge" id="fbtnBadge" style="display: none;">0</span>
          </button>

          <!-- Result Items Count -->
          <div class="sort-count">
            <span id="flaberryItemCount">
              {% if coll_products_count > 0 %}
                {{ coll_products_count }} gifts found
              {% else %}
                Showing 24 curated gifts
              {% endif %}
            </span>
          </div>

          <!-- Sort Selector -->
          <div class="sort-select-wrapper">
            <label for="sortsel" class="muted" style="font-size: 13px;">Sort by:</label>
            <select id="sortsel" onchange="flaberrySortChange(this.value)">
              <option value="best-selling" {% if collection.sort_by == 'best-selling' or collection.sort_by == blank %}selected{% endif %}>Popularity</option>
              <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
              <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
              <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>New Arrivals</option>
              <option value="rate">Best Rated</option>
            </select>
          </div>
        </div>

        <!-- 24 Products Grid with Native Shopify Pagination (Strict 4 Columns on Desktop) -->
        {% paginate collection.products by 24 %}
          <div class="grid flaberry-grid flaberry-collection-grid" id="flaberryCollectionGrid">
            {% if collection.products.size > 0 %}
              {% for prod in collection.products %}
                {% render 'flaberry-product-card', product: prod %}
              {% endfor %}
            {% else %}
              {% comment %} Curated Fallback with Exactly 24 Products (6 rows of 4) {% endcomment %}
              {% assign c_rose = 'hx_roses.webp' | file_url %}
              {% assign c_cake = 'hero_cake.webp' | file_url %}
              {% assign c_lily = 'hx_lily.webp' | file_url %}
              {% assign c_orchid = 'hx_orchids.webp' | file_url %}
              {% assign c_truffle = 'hx_truffle.webp' | file_url %}
              {% assign c_anniv = 'hero_anniv.webp' | file_url %}
              {% assign c_combo = 't_cakeflowers.webp' | file_url %}
              {% assign c_heart = 'hx_heartbox.webp' | file_url %}
              {% assign c_photo = 't_photocake.webp' | file_url %}
              {% assign c_ferrero = 'hx_ferrero.webp' | file_url %}
              {% assign c_bday = 'hero_bday.webp' | file_url %}
              {% assign c_flowers = 'hero_flowers.webp' | file_url %}

              {% render 'flaberry-product-card', title: 'Heartfelt Red Roses Bunch', price: 3100, compare_at_price: 3500, image: c_flowers, rating: '4.9', reviews_count: 142, tag: 'Bestseller', link: '/products/red-rose-gift-luxe' %}
              {% render 'flaberry-product-card', title: 'Belgian Chocolate Truffle Cake', price: 849, compare_at_price: 999, image: c_truffle, rating: '4.9', reviews_count: 215, tag: 'Bestseller', link: '/products/chocolate-cake' %}
              {% render 'flaberry-product-card', title: 'Red Rose Love Treat', price: 2660, compare_at_price: 2990, image: c_rose, rating: '4.8', reviews_count: 98, tag: 'Premium', link: '/products/red-rose-gift-luxe' %}
              {% render 'flaberry-product-card', title: 'Classic Black Forest Photo Cake', price: 929, compare_at_price: 1099, image: c_photo, rating: '4.9', reviews_count: 88, tag: 'Eggless', link: '/products/chocolate-cake' %}

              {% render 'flaberry-product-card', title: 'Serene Pink Lily Box', price: 3800, compare_at_price: 4200, image: c_lily, rating: '4.9', reviews_count: 67, tag: 'Premium', link: '/products/red-rose-gift-luxe' %}
              {% render 'flaberry-product-card', title: 'Dutch Chocolate Delight Cake', price: 899, compare_at_price: 1050, image: c_cake, rating: '4.8', reviews_count: 142, tag: 'Bestseller', link: '/products/chocolate-cake' %}
              {% render 'flaberry-product-card', title: 'Royal Blue Orchid Vase', price: 2900, compare_at_price: 3250, image: c_orchid, rating: '4.7', reviews_count: 53, tag: 'Premium', link: '/products/red-rose-gift-luxe' %}
              {% render 'flaberry-product-card', title: 'Dark Choco Rose Affair', price: 4400, compare_at_price: 4890, image: c_combo, rating: '4.9', reviews_count: 76, tag: 'Deal', link: '/products/chocolate-cake' %}

              {% render 'flaberry-product-card', title: 'Grand Rose Arrangement', price: 29000, compare_at_price: 32000, image: c_heart, rating: '5.0', reviews_count: 24, tag: 'Premium', link: '/products/red-rose-gift-luxe' %}
              {% render 'flaberry-product-card', title: 'Anniversary Peach Charm', price: 1699, compare_at_price: 1899, image: c_anniv, rating: '4.8', reviews_count: 110, tag: 'Deal', link: '/products/chocolate-cake' %}
              {% render 'flaberry-product-card', title: 'Ferrero Rocher Floral Luxe', price: 2990, compare_at_price: 3350, image: c_ferrero, rating: '4.9', reviews_count: 134, tag: 'Bestseller', link: '/products/chocolate-cake' %}
              {% render 'flaberry-product-card', title: 'Birthday Wishes Bouquet', price: 1599, compare_at_price: 1799, image: c_bday, rating: '4.7', reviews_count: 89, tag: 'Deal', link: '/products/chocolate-cake' %}

              {% render 'flaberry-product-card', title: 'Passionate Love 50 Roses', price: 4660, compare_at_price: 5200, image: c_rose, rating: '4.9', reviews_count: 162, tag: 'Premium', link: '/products/red-rose-gift-luxe' %}
              {% render 'flaberry-product-card', title: 'Velvet Heart Truffle Cake', price: 1299, compare_at_price: 1499, image: c_cake, rating: '4.8', reviews_count: 94, tag: 'Bestseller', link: '/products/chocolate-cake' %}
              {% render 'flaberry-product-card', title: 'Pink and White Harmony', price: 1990, compare_at_price: 2250, image: c_flowers, rating: '4.9', reviews_count: 84, tag: 'Deal', link: '/products/red-rose-gift-luxe' %}
              {% render 'flaberry-product-card', title: 'Midnight Rose Desire', price: 2190, compare_at_price: 2490, image: c_heart, rating: '4.8', reviews_count: 115, tag: 'Premium', link: '/products/red-rose-gift-luxe' %}

              {% render 'flaberry-product-card', title: 'Sweet Temptation Combo', price: 3499, compare_at_price: 3899, image: c_combo, rating: '4.9', reviews_count: 73, tag: 'Bestseller', link: '/products/chocolate-cake' %}
              {% render 'flaberry-product-card', title: 'Graceful White Asiatic Lilies', price: 3200, compare_at_price: 3600, image: c_lily, rating: '4.8', reviews_count: 61, tag: 'Premium', link: '/products/red-rose-gift-luxe' %}
              {% render 'flaberry-product-card', title: 'Rainbow Rose Fantasy', price: 2490, compare_at_price: 2890, image: c_flowers, rating: '4.7', reviews_count: 104, tag: 'Deal', link: '/products/red-rose-gift-luxe' %}
              {% render 'flaberry-product-card', title: 'Choco Walnut Dry Cake', price: 799, compare_at_price: 950, image: c_truffle, rating: '4.8', reviews_count: 59, tag: 'Eggless', link: '/products/chocolate-cake' %}

              {% render 'flaberry-product-card', title: 'Sunshine Yellow Roses Bunch', price: 1499, compare_at_price: 1799, image: c_rose, rating: '4.9', reviews_count: 87, tag: 'Bestseller', link: '/products/red-rose-gift-luxe' %}
              {% render 'flaberry-product-card', title: 'Opulent Exotic Purple Orchids', price: 3500, compare_at_price: 3950, image: c_orchid, rating: '4.9', reviews_count: 48, tag: 'Premium', link: '/products/red-rose-gift-luxe' %}
              {% render 'flaberry-product-card', title: 'Butterscotch Crunch Celebration Cake', price: 849, compare_at_price: 999, image: c_cake, rating: '4.8', reviews_count: 128, tag: 'Bestseller', link: '/products/chocolate-cake' %}
              {% render 'flaberry-product-card', title: 'Splendid Love Roses & Teddy', price: 2890, compare_at_price: 3290, image: c_combo, rating: '4.9', reviews_count: 92, tag: 'Deal', link: '/products/red-rose-gift-luxe' %}
            {% endif %}
          </div>

          <!-- Empty State (Hidden by default, shown when filters match 0) -->
          <div class="empty-filter-state" id="emptyFilterState" style="display: none;">
            <h3>No gifts match your selected filters</h3>
            <p class="muted">Try adjusting your price range or delivery preferences, or clear filters to view all gifts.</p>
            <button type="button" class="btn flora" onclick="flaberryClearFilters()" style="margin-top: 14px;">Clear All Filters</button>
          </div>

          <!-- Numbered Pagination (.pager) -->
          {% if paginate.pages > 1 %}
            <nav class="pager" aria-label="Pagination">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}" class="page-btn page-arrow" aria-label="Previous page">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 18l-6-6 6-6"/></svg>
                </a>
              {% endif %}

              {% for part in paginate.parts %}
                {% if part.is_link %}
                  <a href="{{ part.url }}" class="page-btn">{{ part.title }}</a>
                {% else %}
                  {% if part.title == paginate.current_page %}
                    <span class="page-btn on">{{ part.title }}</span>
                  {% else %}
                    <span class="page-btn deco">{{ part.title }}</span>
                  {% endif %}
                {% endif %}
              {% endfor %}

              {% if paginate.next %}
                <a href="{{ paginate.next.url }}" class="page-btn page-arrow" aria-label="Next page">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
                </a>
              {% endif %}
            </nav>
          {% endif %}
        {% endpaginate %}
      </div>
    </div>

    <!-- SEO Editorial Prose & FAQs Section -->
    {% if section.settings.enable_seo_faq %}
      <section class="sec flaberry-coll-seo">
        <h2>{{ seo_heading }}</h2>
        <div class="copy muted" style="margin-top: 10px; line-height: 1.6;">
          {% if seo_body != blank %}
            {{ seo_body }}
          {% else %}
            <p>Explore our handcrafted collection of {{ coll_title | downcase }} made fresh by master florists and artisan bakers. Every product clearly displays pincode deliverability before you order, ensuring a seamless gifting experience across India.</p>
            <p style="margin-top: 8px;">Enjoy flexible delivery slots: Standard Free Delivery, Fixed Time Delivery, Early Morning Delivery, and Midnight Delivery right at 12:00 AM. Every surprise includes a complimentary printed personalized greeting card.</p>
          {% endif %}
        </div>

        <h3 style="font-size: 22px; margin: 36px 0 16px;">Frequently Asked Questions</h3>
        <div class="flaberry-faq-list">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'faq' %}
                <details class="flaberry-faq-item">
                  <summary>{{ block.settings.question }}</summary>
                  <p>{{ block.settings.answer }}</p>
                </details>
              {% endif %}
            {% endfor %}
          {% endif %}

          <!-- Prototype Standard FAQs Fallback -->
          <details class="flaberry-faq-item" open>
            <summary>Can I send {{ coll_title | downcase }} at midnight for a birthday or anniversary?</summary>
            <p>Yes! Flaberry provides guaranteed Midnight Delivery between 11:00 PM and 12:30 AM across 500+ Indian cities. Simply select the Midnight delivery slot during checkout on the product page.</p>
          </details>

          <details class="flaberry-faq-item">
            <summary>How fresh will the flowers and cakes be upon delivery?</summary>
            <p>Flowers are harvested at dawn and arranged just before dispatch in temperature-controlled packaging. All cakes are baked fresh on the day of delivery by verified partner bakers using pure ingredients.</p>
          </details>

          <details class="flaberry-faq-item">
            <summary>Is there an extra charge for the personalized greeting card?</summary>
            <p>No, every Flaberry order comes with a free personalized greeting card. You can write your custom message up to 250 characters directly on the product detail page.</p>
          </details>

          <details class="flaberry-faq-item">
            <summary>Can I book advance orders for future dates?</summary>
            <p>Yes, you can schedule delivery up to 90 days in advance with guaranteed date and time slot reservation, perfect for birthdays, anniversaries, and festive celebrations.</p>
          </details>

          <details class="flaberry-faq-item">
            <summary>What payment modes are accepted on Flaberry?</summary>
            <p>We accept all Indian and international payment options: UPI (Google Pay, PhonePe, Paytm), Credit and Debit Cards (Visa, Mastercard, RuPay, Maestro), Net Banking, and Wallets.</p>
          </details>
        </div>
      </section>
    {% endif %}
  </div>
</div>

<!-- Modal: Quick Pincode Change -->
<div class="flaberry-pin-modal" id="collPinModal" style="display: none;">
  <div class="pin-modal-scrim" onclick="flaberryCloseCollectionPinModal()"></div>
  <div class="pin-modal-box">
    <div class="pin-modal-header">
      <h3 style="margin: 0; font-size: 18px;">Check delivery pincode</h3>
      <button type="button" class="x" onclick="flaberryCloseCollectionPinModal()">×</button>
    </div>
    <form class="pin-modal-body" onsubmit="event.preventDefault(); flaberrySaveCollectionPin();">
      <p class="muted" style="font-size: 13.5px; margin-top: 0;">Enter receiver's 6-digit pincode to view gifts with guaranteed same-day and midnight slots.</p>
      <div style="display: flex; gap: 8px;">
        <input type="text" class="inp" id="modalPinInp" maxlength="6" inputmode="numeric" placeholder="e.g. 110001" required>
        <button type="submit" class="btn flora">Check</button>
      </div>
      <div id="modalPinFeedback" style="margin-top: 10px; font-size: 13px;"></div>
    </form>
  </div>
</div>

