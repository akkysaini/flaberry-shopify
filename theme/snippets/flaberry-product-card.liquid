{% comment %}
  Flaberry Reusable Product Card Snippet
  Source of Truth: reference/Flaberry_Design1_Classic.html (.pcard)
  Displays product card with square media (.pim), badge tag (.tag),
  hover/quick-view action button (.quick), title (h4),
  price & rating pill (.meta > .pr, .rate), delivery time & reviews count.
  Every product card redirects strictly to its Product Detail Page (PDP).
{% endcomment %}

{%- liquid
  assign card_title = ''
  assign card_url = ''
  assign card_price_raw = 0
  assign card_price_display = ''
  assign card_compare_raw = 0
  assign card_rating = '4.8'
  assign card_reviews = 120
  assign card_tag = 'Premium'
  assign card_earliest = 'Earliest: Today'
  assign image_src = ''

  if product != blank
    assign card_title = product.title
    assign card_url = product.url
    assign card_price_raw = product.price | divided_by: 100.0 | round
    assign card_price_display = product.price | money_without_trailing_zeros
    if product.compare_at_price > product.price
      assign card_compare_raw = product.compare_at_price | divided_by: 100.0 | round
    endif

    if product.metafields.flaberry.rating.value != blank
      assign card_rating = product.metafields.flaberry.rating.value
    elsif product.metafields.reviews.rating.value.rating != blank
      assign card_rating = product.metafields.reviews.rating.value.rating | round: 1
    endif

    if product.metafields.flaberry.reviews_count.value != blank
      assign card_reviews = product.metafields.flaberry.reviews_count.value
    elsif product.metafields.reviews.rating_count != blank
      assign card_reviews = product.metafields.reviews.rating_count
    endif

    if product.tags contains 'Deal' or product.tags contains 'Sale'
      assign card_tag = 'Deal'
    elsif product.tags contains 'Bestseller'
      assign card_tag = 'Bestseller'
    elsif product.tags contains 'Personalised'
      assign card_tag = 'Personalised'
    elsif product.tags contains 'Eggless'
      assign card_tag = 'Eggless'
    elsif product.tags contains 'Premium'
      assign card_tag = 'Premium'
    elsif tag != blank
      assign card_tag = tag
    endif

    if product.featured_image != blank
      assign image_src = product.featured_image | image_url: width: 600, height: 600
    elsif image_asset != blank
      assign image_src = image_asset | asset_url
    endif
  else
    assign card_title = title | default: 'Premium Product'
    assign card_handle = card_title | handleize

    # Ensure link is strictly a PDP URL, never a collection link
    if link != blank and link != '#' and link contains '/products/'
      assign card_url = link
    elsif all_products[card_handle] != blank
      assign card_url = all_products[card_handle].url
    elsif all_products['red-rose-gift-luxe'] != blank
      assign card_url = all_products['red-rose-gift-luxe'].url
    else
      assign card_url = '/products/' | append: card_handle
    endif

    assign card_price_raw = price | default: 2440
    assign card_price_clean = card_price_raw | replace: '₹', '' | replace: ',', '' | strip | plus: 0
    
    if price_formatted != blank
      assign card_price_display = price_formatted
    elsif card_price_clean > 0
      assign price_in_cents = card_price_clean | times: 100
      assign card_price_display = price_in_cents | money_without_trailing_zeros
    else
      assign card_price_display = '₹' | append: card_price_raw
    endif

    if compare_at_price != blank
      assign card_compare_raw = compare_at_price
    endif
    if rating != blank
      assign card_rating = rating
    endif
    if reviews_count != blank
      assign card_reviews = reviews_count
    elsif reviews != blank
      assign card_reviews = reviews
    endif
    if tag != blank
      assign card_tag = tag
    endif
    if earliest != blank
      assign card_earliest = earliest
    endif

    if image != blank
      assign image_src = image
    elsif image_asset != blank
      assign image_src = image_asset | asset_url
    endif
  endif

  assign card_price_num = card_price_raw | replace: '₹', '' | replace: ',', '' | strip | plus: 0
  assign card_compare_num = card_compare_raw | replace: '₹', '' | replace: ',', '' | strip | plus: 0
-%}

<a class="pcard" href="{{ card_url }}" data-price="{{ card_price_raw }}" data-rating="{{ card_rating }}" data-tag="{{ card_tag | downcase }}" data-title="{{ card_title | downcase }}">
  <div class="pim">
    {%- if image_src != blank -%}
      <img loading="lazy" src="{{ image_src }}" alt="{{ card_title | escape }}" width="300" height="300">
    {%- else -%}
      <div class="pcard-placeholder" style="width:100%;height:100%;display:grid;place-items:center;background:#f3f4f6;color:#9ca3af;font-size:13px;">Flaberry</div>
    {%- endif -%}

    {%- if card_tag != blank -%}
      <span class="tag{% if card_tag == 'Deal' or card_tag == 'Sale' %} deal{% endif %}">{{ card_tag }}</span>
    {%- endif -%}

    <div class="quick">
      <span class="btn white sm">View &amp; personalise</span>
    </div>
  </div>

  <h4>{{ card_title }}</h4>

  <div class="meta">
    <span class="pr tab-nums">
      <span>{{ card_price_display }}</span>
      {%- if card_compare_num > card_price_num -%}
        {%- if product != blank and product.compare_at_price > product.price -%}
          <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>
        {%- else -%}
          <s>{{ card_compare_num | times: 100 | money_without_trailing_zeros }}</s>
        {%- endif -%}
      {%- endif -%}
    </span>
    {% if product != blank %}
      <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-template='index'>
        {{ product.metafields.judgeme.badge }}
      </div>
      {%- assign jm_badge = product.metafields.judgeme.badge -%}
      {%- if jm_badge == blank or jm_badge contains '0 reviews' or jm_badge contains 'jdgm--empty' -%}
        <span class="rate jm-fallback-rate">{{ card_rating }} ★</span>
      {%- endif -%}
    {% else %}
      <span class="rate">{{ card_rating }} ★</span>
    {% endif %}
  </div>

  <div class="meta">
    <span class="earliest-text">{{ card_earliest }}</span>
    {% if product != blank and product.vendor != blank and product.vendor != shop.name %}
      <span class="vendor-name-badge" style="font-size: 11.5px; color: var(--muted, #5f6178); max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ product.vendor }}</span>
    {% else %}
      <span class="reviews-count-text">{{ card_reviews }} reviews</span>
    {% endif %}
  </div>
</a>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
    min-width: 0;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }
  .pcard .pim {
    position: relative;
    border-radius: var(--r-md, 16px);
    overflow: hidden;
    background: var(--mist, #f7f5f3);
    aspect-ratio: 1 / 1;
    width: 100%;
  }
  .pcard .pim img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .pcard:hover .pim img {
    transform: scale(1.04);
  }
  .pcard .tag {
    position: absolute;
    left: 10px;
    top: 10px;
    background: #ffffff;
    color: var(--flaberry-navy, #1e1b4b);
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 600;
    padding: 4px 10px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    z-index: 2;
    pointer-events: none;
    line-height: 1.2;
  }
  .pcard .tag.deal {
    background: var(--flora, #e24b4b);
    color: #ffffff;
  }
  .pcard .quick {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 3;
    pointer-events: none;
  }
  .pcard:hover .quick,
  .pcard:focus-within .quick {
    opacity: 1;
    transform: translateY(0);
  }
  .pcard .quick .btn {
    width: 100%;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 600;
    background: #ffffff;
    color: var(--flaberry-navy, #1e1b4b);
    border: 1px solid #ffffff;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: auto;
    transition: background 0.2s ease, color 0.2s ease;
    box-sizing: border-box;
  }
  .pcard .quick .btn:hover {
    background: #f1ece9;
  }
  .pcard h4 {
    font-family: var(--body, inherit);
    font-weight: 500;
    font-size: 14.5px;
    letter-spacing: 0;
    line-height: 1.35;
    color: var(--flaberry-navy, #1e1b4b);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.7em;
  }
  .pcard .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: var(--muted, #6b7280);
  }
  .pcard .pr {
    font-weight: 700;
    font-size: 15.5px;
    color: var(--flaberry-navy, #1e1b4b);
    font-variant-numeric: tabular-nums;
    display: inline-flex;
    align-items: baseline;
  }
  .pcard .pr s {
    font-weight: 400;
    color: var(--muted, #9ca3af);
    font-size: 13px;
    margin-left: 6px;
    text-decoration: line-through;
  }
  .pcard .rate {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    background: #e4f3ea;
    color: var(--leaf, #187a4d);
    font-weight: 700;
    font-size: 11.5px;
    border-radius: 6px;
    padding: 2px 7px;
    line-height: 1.2;
  }
  .pcard .jdgm-widget.jdgm-preview-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin: 0;
  }
  .pcard .jdgm-prev-badge__stars {
    color: #e59819;
    font-size: 13px;
  }
  .pcard .jdgm-prev-badge__text {
    font-size: 11.5px;
    color: var(--muted, #5f6178);
    margin-left: 2px;
  }
  .pcard:has(.jdgm-prev-badge[data-number-of-reviews]:not([data-number-of-reviews="0"])) .jm-fallback-rate {
    display: none !important;
  }

  @media (max-width: 768px) {
    .pcard {
      gap: 8px;
    }
    .pcard .pim {
      border-radius: 14px;
    }
    .pcard .tag {
      font-size: 11px;
      padding: 3px 8px;
      left: 8px;
      top: 8px;
    }
    .pcard h4 {
      font-size: 13.5px;
      line-height: 1.3;
      min-height: 2.6em;
    }
    .pcard .pr {
      font-size: 14.5px;
    }
    .pcard .meta {
      font-size: 11.5px;
      gap: 4px;
    }
    .pcard .rate {
      font-size: 11px;
      padding: 2px 5px;
    }
    .pcard .quick {
      display: none;
    }
  }
</style>
