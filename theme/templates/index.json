    "flaberry_seo_faq": {
      "type": "flaberry-seo-faq",
      "settings": {
        "seo_heading": "Send flowers & cakes to India with Flaberry",
        "faq_heading": "Frequently Asked Questions"
      },
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "How does Same-Day Delivery work?",
            "answer": "Orders placed before 4:00 PM IST qualify for same-day delivery across 500+ serviceable cities. You can select your preferred delivery time slot during checkout."
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Are the flowers and cakes fresh?",
            "answer": "Yes, 100%. Flowers reach our distribution hubs within 2 to 3 days of being hand-picked. Cakes are baked fresh by our partner master bakeries only after your order is confirmed."
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Can I order from outside India?",
            "answer": "Absolutely. Flaberry serves customers worldwide across the USA, UK, Canada, UAE, Australia, and Europe with international credit card and PayPal support, delivering right to doorsteps across India."
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "Can I add a personalized message card?",
            "answer": "Yes, every gift order comes with a free personalized greeting message card. Simply enter your message on the product page or cart drawer, and our team prints it neatly onto a physical gift card."
          }
        }
      },
      "block_order": [
        "faq_1",
        "faq_2",
        "faq_3",
        "faq_4"
      ]
    }
